// PSP divergence logic adapted from work by fadizeidan, cephxs, and fstarcapital.
//@version=6
indicator('Fractal Model', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000, dynamic_requests = true)

import fstarcapital/AssetCorrelationUtils/1 as AC

// ============================================================================
// Types - Data Only (no drawing objects stored)
// ============================================================================

type Candle
    float o
    float c
    float h
    float l
    int o_time
    int c_time    // close time - set when next candle opens
    int o_idx
    int c_idx
    int h_idx
    int l_idx
    string dow
    // PSP / correlated-asset divergence state
    bool has_divergence
    bool is_bullish_div
    bool is_psp
    bool divergence12
    bool divergence13
    bool divergence23
    // Visual positions (calculated during draw)
    int candle_left
    int candle_right
    int wick_x

type Trace
    int start_idx
    float start_price


type Sweep
    float price
    int ltf_index
    int htf_candle_idx
    int swept_candle_idx
    int ltf_end_idx
    bool is_high  // true = high sweep, false = low sweep
    int c2_extreme_idx = na  // local C2 extreme: used for orphaned sweep fallback
    float c2_extreme_price = na

type ICCisd
    float level
    int start_idx
    int end_idx
    float extreme_price
    int extreme_idx
    bool taken               // wick beyond swing high/low — line and dot go grey
    int stage                // which continuation candle this confirmed on: 3, 4, or 5

// Candidate LTF FVG used only to gate the IC-CISD alert (criterion: FVG Tap)
type ICFVG
    float top
    float bot
    bool tapped
    int known_idx = na
    int origin_time = na
    bool invalidated = false

// Candidate LTF swing point used only to gate the IC-CISD alert (criterion: Swing Sweep)
type ICSwingGate
    float price
    bool swept
    int known_idx = na
    int origin_time = na

// HTF Fair Value Gap (detected on HTF candles, projected on the LTF chart)
type FVG
    bool is_bullish
    float top                // top of the gap
    float bot                // bottom of the gap
    int left_time            // LTF open time of the middle (impulse) HTF candle
    int b_o_idx              // bar index of the middle HTF candle open (used to find it in the HTF projection)
    int mit_time             // LTF bar time where the gap was fully filled (na = still open)
    int known_time = na
    int ifvg_time = na       // first body close through the gap; it can then act from the opposite side

// Open/Close Level captured at the selected New York anchor hour.
type HTFOCL
    float price
    int origin_time
    int origin_idx
    bool active = true

// Confirmed HTF liquidity pivot. OHP/OLP may only use these levels, never an
// arbitrary internal candle high/low.
type HTFLiquidity
    float price
    int origin_time
    int origin_idx
    bool is_high
    bool active = true

// Independently confirmed HTF Rejection/Order Block. These zones are not used
// by the existing C2/C3 state machine unless the RB C2 checklist is enabled.
type BlockZone
    string kind                 // RB or OB
    bool is_bullish
    float top
    float bot
    int origin_time
    int origin_idx
    int confirm_time
    int confirm_idx
    int first_touch_time = na
    int mitigation_time = na
    int invalidation_time = na

// A CRT C2 can produce more than one local TBS / Model #1 sequence before
// that C2 candle closes.  Keep each sequence separate so a later valid
// inside structure never overwrites an earlier entry.
type M1Signal
    int tbs_idx
    float tbs_level
    int pattern_count
    int structure_start_idx
    float level
    float sl
    bool entry_triggered = false
    int entry_idx = na

type Setup
    bool has_c3_v = false
    bool is_bullish          // true = bullish setup (low sweep), false = bearish (high sweep)
    bool is_confirmed        // true when sweep is confirmed (close in range)
    bool is_post_c2          // true after C2 closes, waiting for CISD
    // Sweep data
    float sweep_price        // swept high/low price (C1 high/low)
    int sweep_ltf_idx        // LTF bar index of sweep
    int sweep_bar_idx        // bar index where sweep happened (for CISD traceback)
    int swept_candle_idx     // HTF candle that was swept (o_idx)
    float c1_high = na       // exact C1 range, anchored at the LTF candle that made it
    float c1_low = na
    int c1_high_idx = na
    int c1_low_idx = na
    int c1_high_taken_time = na
    int c1_low_taken_time = na
    int htf_candle_idx       // HTF candle that did the sweeping
    int ltf_end_idx          // LTF end point for sweep line
    int htf_count            // counts HTF candles since sweep (max 2)
    // C2 data
    int c2_x                 // bar index for C2 label (at swing point)
    float c2_y               // price for C2 label (swing high/low)
    float c2_extreme         // C2's high (bearish) or low (bullish) for price limit
    float c2_open = na       // retained HTF OHLC: POI checks must survive visual-cache eviction
    float c2_close = na
    float c2_high = na
    float c2_low = na
    int c2_open_time = na
    bool c2_psp              // live/final correlated divergence state shown as "C2 + PSP"
    string htf_poi_kind = 'Pending' // FVG / OB / OHP / OLP; C1 sweep is never a POI
    float htf_poi_top = na
    float htf_poi_bottom = na
    int htf_poi_origin_time = na
    int htf_poi_touch_time = na
    // LTF entry model #1: local TBS followed by Model #1 body-break entry.
    // This is intentionally separate from C2/C3/CISD; it reads the LTF
    // structure surrounding the CRT sweep and never changes the C2 engine.
    bool m1_tbs_confirmed = false
    int m1_tbs_idx = na
    float m1_tbs_level = na
    int m1_pattern_count = na
    int m1_structure_start_idx = na
    float m1_level = na
    int m1_idx = na
    float m1_sl = na
    bool m1_entry_triggered = false
    int m1_entry_idx = na
    array<M1Signal> m1_signals
    // LTF entry model #2: a direction-matching FVG, its later tap, then a
    // rejection body-close back out of the FVG.
    bool m2_fvg_found = false
    int m2_fvg_idx = na
    float m2_fvg_top = na
    float m2_fvg_bottom = na
    bool m2_tapped = false
    int m2_tap_idx = na
    bool m2_entry_triggered = false
    int m2_entry_idx = na
    float m2_sl = na
    // CISD data
    float cisd_level         // CISD price level (open of opposing candles)
    int cisd_start_idx       // bar index where CISD level starts
    int cisd_end_idx         // body-break bar; line drawn to this + 1
    float tracked_extreme    // tracks high/low price for CISD (lowest low or highest high)
    int extreme_bar_idx      // bar index where the extreme occurred (for CISD traceback)
    bool has_cisd            // true when CISD level is set
    bool cisd_triggered      // true when CISD may show (body broke; in C2 also needs sweep back in)
    // IC-CISD (rebuild): opposite-candle open = level; body break confirms; one pending
    array<ICCisd> ic_list
    bool ic_active           // detection on after main CISD (through C5)
    bool ic_pending          // waiting for body break on current structure
    float ic_level           // open of opposite candle
    int ic_start_idx         // bar of that opposite candle
    float ic_extreme         // running high (bear) / low (bull) for dot — update every bar until confirm
    int ic_extreme_idx
    bool ic_seen_same_side   // true once a same-side candle has interrupted the run without breaking it — the next opposite candle then re-anchors the level to itself
    int ic_current_stage     // which continuation candle is forming right now: 3, 4, or 5 (tags new ICCisd entries)
    // IC-CISD alert gate: FVG/swing candidates collected from the C2 leg onward, plus Previous-EQ proximity.
    // Re-armed each time an IC-CISD confirms, so every IC-CISD needs its own fresh tap/sweep/EQ-touch.
    array<ICFVG> ic_gate_fvgs
    array<ICSwingGate> ic_gate_swings
    int ic_gate_scanned_idx    // last bar index whose newest 3-bar window was scanned for new candidates
    int ic_gate_cycle_start_idx // bar index the current gate cycle began (main CISD trigger, or last IC-CISD confirm)
    int ic_gate_last_tap_idx   // bar index of the most recent FVG tap / swing sweep (na = none yet this cycle)
    int ic_gate_eq_touch_idx   // bar index of the most recent Previous-EQ proximity touch (na = none yet this cycle)
    // C4/C5 window
    int c4_end_time          // C4's end time (C4 invalidation window)
    int c5_end_time          // C5's end time — IC-CISD hard-stop now extends through here, one candle past C4
    // Invalidation
    bool is_invalid          // True if C3 exceeded C2 extreme after CISD triggered
    bool is_superseded = false // A newer valid C2 formed in this setup's C3 window
    // Entry Zone C3 data
    float c2_mid             // C2 wick midpoint (high+low)/2
    float c3_open            // C3 open price
    bool ez_c3_set           // true when C3 entry zone bounds are calculated
    float ez_c3_top          // C3 zone top price
    float ez_c3_bot          // C3 zone bottom price
    int ez_c3_left_time      // C3 zone left (C3 open time)
    int ez_c3_right_time     // C3 zone right (C3 close / C4 open); na while C3 is live
    // Entry Zone C4 data
    float c3_mid             // C3 wick midpoint (high+low)/2
    float c3_extreme         // C3 high (bearish) or low (bullish) for C4 invalidation
    float c4_open            // C4 open price
    bool ez_c4_set           // true when C4 entry zone bounds are calculated
    bool ez_c4_invalid       // true when C4 invalidated (beyond C3 extreme)
    int ez_c4_invalid_time   // LTF time where C4 was invalidated (EQ stops here)
    float ez_c4_top          // C4 zone top price
    float ez_c4_bot          // C4 zone bottom price
    int ez_c4_left_time      // C4 zone left (C4 open time)
    int ez_c4_right_time     // C4 zone right (C4 close)
type CandleSettings
    string htf
    int max_display
    bool vt_show
    color vt_color
    string vt_style
    int vt_size
    bool hl_show
    color hl_color
    string hl_style
    int hl_width

// Correlated asset state used by the PSP module
type PSPAsset
    string symbol
    bool invert
    bool include
    float data_open
    float data_close
    float data_high
    float data_low
    bool bullish
    bool bearish
    bool has_data

type Settings
    color bull_body
    color bull_border
    color bull_wick
    color bear_body
    color bear_border
    color bear_wick
    int offset
    int width
    bool daily_name
    bool trace_show
    color trace_o_color
    string trace_o_style
    int trace_o_size
    bool label_show
    color label_color
    string label_size
    string label_position
    string dow_position
    // FVG settings
    bool fvg_show
    bool fvg_project         // project HTF FVGs onto the LTF chart
    bool fvg_htf_show        // draw FVGs next to the HTF candle projection
    color fvg_bull_color
    color fvg_bear_color
    int fvg_max
    bool fvg_hide_mitigated
    bool htf_label_show
    color htf_label_color
    string htf_label_size
    bool htf_timer_show
    color htf_timer_color
    string htf_timer_size
    color dow_color
    string dow_size
    bool sweep_show
    color sweep_color
    string sweep_style
    int sweep_size
    int sweep_history
    bool sweep_visible_only
    bool sweep_live
    color c2_color
    string c2_size
    bool show_c2_lbl
    bool show_c3_lbl
    bool show_c4_lbl
    // CISD settings
    bool cisd_show
    color cisd_bull_color
    color cisd_bear_color
    int cisd_width
    string cisd_style
    bool ic_cisd_show        // IC-CISD toggle
    color ic_cisd_bull_color // IC-CISD colors are independent from the reversal CISD colors above
    color ic_cisd_bear_color
    bool ic_show_taken       // show IC-CISD that were taken out (grey) — off hides them
    string ic_dot_size       // IC-CISD swing dot size
    bool ic_show_c3          // show IC-CISD printed during the C3 continuation candle
    bool ic_show_c4          // show IC-CISD printed during the C4 continuation candle
    bool ic_show_c5          // show IC-CISD printed during the C5 continuation candle
    // IC-CISD Alert (gated) settings
    bool ic_alert_show
    bool ic_alert_crit_fvg   // criterion: price tapped an FVG from the C2 leg onward
    bool ic_alert_crit_sweep // criterion: price swept a swing point from the C2 leg onward
    bool ic_alert_crit_eq    // criterion: price came near/touched the current Previous EQ line
    float ic_alert_eq_tol_pct // tolerance for the EQ criterion, as % of the C2 HTF candle's range
    // Entry Zone settings
    bool entry_zone_show
    color entry_zone_bull_color
    color entry_zone_bear_color
    // General settings
    bool alerts_enabled
    bool live_alerts_enabled
    string fractal_mode
    string custom_ltf
    string bias
    bool hide_candles
    bool hide_setups



type CandleSet
    array<Candle> candles
    array<Sweep> sweeps
    array<Setup> setups       // completed setups for history
    CandleSettings settings
    Trace trace
    Setup live_bearish        // tracks when high is wicked (potential bearish setup)
    Setup live_bullish        // tracks when low is wicked (potential bullish setup)
    bool has_live_bearish     // flag for bearish tracking active
    bool has_live_bullish     // flag for bullish tracking active
    PSPAsset psp_asset1
    PSPAsset psp_asset2
    PSPAsset psp_asset3
    // C1 reference is frozen at the opening of each new C2 candle.
    // Never infer it later from a mutable projected-candle array offset.
    Candle ref_c1
    int ref_c2_open_idx = na

// Drawing Bin - centralized storage for all drawing objects
type DrawingBin
    array<line> lines
    array<box> boxes
    array<label> labels

// ============================================================================
// Global Variables
// ============================================================================

Settings settings = Settings.new()
var CandleSettings Settingshtf = CandleSettings.new()
var array<Candle> candles_1 = array.new<Candle>(0)
var array<Sweep> sweeps_1 = array.new<Sweep>()
var array<Setup> setups_1 = array.new<Setup>()

var CandleSet htf = CandleSet.new()
htf.settings := Settingshtf
htf.candles := candles_1
htf.sweeps := sweeps_1
htf.setups := setups_1
htf.trace := Trace.new()
htf.psp_asset1 := PSPAsset.new()
htf.psp_asset2 := PSPAsset.new()
htf.psp_asset3 := PSPAsset.new()

// Initialize drawing bin
var DrawingBin bin = DrawingBin.new(
    lines = array.new<line>(),
    boxes = array.new<box>(),
    labels = array.new<label>()
)
var array<HTFLiquidity> htfLiquidity = array.new<HTFLiquidity>()
var array<HTFOCL> htfOclLevels = array.new<HTFOCL>()
var array<BlockZone> rbZones = array.new<BlockZone>()
var array<BlockZone> obZones = array.new<BlockZone>()
color color_transparent = #ffffff00
// Historical drawing coordinates must not use time[oldOffset]: Pine's series
// buffer is 5000 bars here. Retain actual chart timestamps in a bounded ring.
var array<int> chartTimeRing = array.new<int>(50000, na)
array.set(chartTimeRing, bar_index % 50000, time)

ChartBarTime(int index) =>
    int stamp = na
    if not na(index)
        if index >= math.max(0, bar_index - 49999) and index <= bar_index
            stamp := array.get(chartTimeRing, index % 50000)
        else if index > bar_index and index <= bar_index + 500
            stamp := time_close + int((index - bar_index - 1) * timeframe.in_seconds() * 1000)
    stamp

// HTF Fair Value Gaps (newest first)
var array<FVG> fvgs = array.new<FVG>()

// ============================================================================
// Settings Inputs
// ============================================================================

string group_general            = "General Settings  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string group_htf               = "HTF Candles  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string group_sweep              = "Model Settings  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string group_label              = "Label Settings  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string group_fvg                = "Fair Value Gap  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string group_psp                = "PSP Divergence  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

// Independent SMT and multi-timeframe projections; positively correlated peer.
string group_mf = 'MTF candles & SMT'
string group_crt = 'CRT C2 timing & POIs'
string group_blocks = 'HTF Rejection & Order Blocks'
string group_entry = 'CRT LTF Entry Model  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
bool clUseCrtTiming = input.bool(true, 'Only draw C2 at CRT hours', group = group_crt, tooltip = 'Applies to every Fractal C2 drawing. Hours use America/New_York.')
bool clCrt20 = input.bool(true, '20:00', inline = 'crt_hours', group = group_crt, active = clUseCrtTiming)
bool clCrt21 = input.bool(true, '21:00', inline = 'crt_hours', group = group_crt, active = clUseCrtTiming)
bool clCrt03 = input.bool(true, '03:00', inline = 'crt_hours', group = group_crt, active = clUseCrtTiming)
bool clCrt06 = input.bool(true, '06:00', inline = 'crt_hours2', group = group_crt, active = clUseCrtTiming)
bool clCrt09 = input.bool(true, '09:00', inline = 'crt_hours2', group = group_crt, active = clUseCrtTiming)
bool clCrt10 = input.bool(true, '10:00', inline = 'crt_hours2', group = group_crt, active = clUseCrtTiming)
bool clC2FvgPoi = input.bool(true, 'FVG', inline = 'c2_pois', group = group_crt)
bool clC2ObPoi = input.bool(true, 'OB', inline = 'c2_pois', group = group_crt)
bool clC2OhpPoi = input.bool(true, 'OHP', inline = 'c2_pois', group = group_crt)
bool clC2OlpPoi = input.bool(true, 'OLP', inline = 'c2_pois', group = group_crt)
bool clC2IfvgPoi = input.bool(false, 'IFVG', inline = 'c2_pois2', group = group_crt, tooltip = 'Enable IFVG in the C2 POI checklist. Detection will use a fully invalidated FVG acting from its opposite side.')
bool clC2RbPoi = input.bool(false, 'RB', inline = 'c2_pois2', group = group_crt, tooltip = 'Enable Rejection Block in the C2 POI checklist.')
bool clC2OclPoi = input.bool(false, 'OCL', inline = 'c2_pois2', group = group_crt, tooltip = 'Enable Open/Close Level in the C2 POI checklist.')
string clOclAnchor = input.string('00:00', 'OCL anchor NY', options = ['00:00', '18:00'], group = group_crt, active = clC2OclPoi)
bool crtOnlyChecklistC2 = input.bool(false, 'Show only checklist C2', group = group_crt, tooltip = 'Shows C2 only when it uses an enabled HTF POI from the checklist below. A separate option can retain non-POI C2 at selected CRT key times.')
bool crtShowNonPoiAtKeyTimes = input.bool(true, 'Also show non-POI C2 at key times', group = group_crt, active = crtOnlyChecklistC2, tooltip = 'Keeps a C2 with no HTF POI visible when it occurs at one of your selected 1H CRT times.')
bool crtDashShow = input.bool(true, 'Show compact CRT dashboard', group = group_crt)
bool crtShowPendingSweeps = input.bool(true, 'Show pending C2 sweeps', group = group_crt, tooltip = 'A wick beyond C1 is a potential C2. It is labeled ?C2 until price body-closes back inside. Only confirmed C2 can trigger an entry; a failed C2 is discarded at the next HTF boundary.')
bool crtDebugSweep = input.bool(false, 'DEBUG: plot checked C1 H/L and sweep status', group = group_crt, tooltip = 'Plots the frozen previous 1H candle high/low and markers for the first sweep wick. Data Window also exposes confirmation status. Turn off after testing.')
string crtDashPosition = input.string('Bottom Right', 'Dashboard position', options = ['Top Right', 'Bottom Right', 'Bottom Left', 'Top Left'], group = group_crt, active = crtDashShow)
bool crtDashPhaseStrip = input.bool(true, 'Show phase strip at top', group = group_crt, active = crtDashShow)
bool crtShowUsedPoi = input.bool(true, 'Draw POI used by C2', group = group_crt, tooltip = 'Draws only the FVG, OB, OHP, or OLP that qualified a CRT C2. This stays visible even when Show FVG is off. FVG and OB use a subtle box; OHP and OLP use a level line.')
bool crtShowC1Range = input.bool(true, 'Show C1 CRT high/low + EQ', group = group_crt, tooltip = 'Starts at the exact lower-timeframe candle that formed C1 high/low. Lines stop at C2 unless C3 is active, then end when taken or when a newer C2 takes ownership.')
color crtHighColor = input.color(#fb7185, 'CRT high', inline = 'crt_range_colors', group = group_crt, active = crtShowC1Range)
color crtLowColor = input.color(#22c55e, 'CRT low', inline = 'crt_range_colors', group = group_crt, active = crtShowC1Range)
color crtEqColor = input.color(#eab308, 'CRT EQ', inline = 'crt_range_colors', group = group_crt, active = crtShowC1Range)
color crtBullPoiColor = input.color(#22c55e, 'Bullish POI', inline = 'crt_poi_colors', group = group_crt, active = crtShowUsedPoi)
color crtBearPoiColor = input.color(#ef6b73, 'Bearish POI', inline = 'crt_poi_colors', group = group_crt, active = crtShowUsedPoi)
bool crtShowLiquidityTargets = input.bool(false, 'Show active OHP/OLP targets', group = group_crt, tooltip = 'Shows un-used confirmed old-high/old-low levels from the active CRT source. A used level is removed from this target layer and shown only at its actual C2 use point.')
int crtLiquidityTargetMax = input.int(3, 'Max OHP/OLP targets', minval = 1, maxval = 10, group = group_crt, active = crtShowLiquidityTargets)

// Each model can be used on its own or together.  With both off the CRT C2
// engine remains visible but does not emit LTF entry-model drawings.
bool crtM1Enabled = input.bool(true, 'Enable Model #1 — TBS / M1', group = group_entry)
bool crtM1RequireInside = input.bool(true, 'M1 require 2–6 inside validation', group = group_entry, active = crtM1Enabled, tooltip = 'ON: TBS must break a local 2–6 candle contained structure. OFF: a directional body close through the immediately preceding candle body can qualify as TBS.')
bool crtM2Enabled = input.bool(true, 'Enable Model #2 — FVG tap rejection', group = group_entry)
bool crtSingleEntryC2 = input.bool(true, 'Only one confirmed entry per C2', group = group_entry, tooltip = 'Keeps the first confirmed M1 or M2 entry after the latest C2 manipulation extreme. New extremes discard stale entry candidates. OFF restores multiple-entry behaviour.')
bool crtM1Show = input.bool(true, 'Show entry-model drawings', group = group_entry, active = crtM1Enabled or crtM2Enabled)
int crtEntryMaxBars = input.int(80, 'Max LTF bars after CRT sweep', minval = 6, maxval = 500, group = group_entry, tooltip = 'Stops an old CRT sweep from creating an unrelated entry much later. The 2–6 candle inside structure itself may be before or after the CRT sweep; the TBS body-close must occur after the sweep.')
int crtM1StructureSearch = input.int(18, 'Structure search around sweep', minval = 2, maxval = 50, group = group_entry, tooltip = 'How far back from a potential TBS to search for the 2–6 candle structure. This lets the inside structure be the last local down/up-close sequence before the CRT sweep, rather than forcing it to form after the sweep.')
int crtEntryLineBars = input.int(6, 'Entry / SL extension (LTF bars)', minval = 1, maxval = 30, group = group_entry, tooltip = 'How many lower-timeframe candles the confirmed Entry and SL lines continue after the entry bar.')
color crtM1BullColor = input.color(#22c55e, 'Bullish TBS / M1', inline = 'm1_colors', group = group_entry, active = crtM1Show)
color crtM1BearColor = input.color(#fb7185, 'Bearish TBS / M1', inline = 'm1_colors', group = group_entry, active = crtM1Show)
color crtM1EntryColor = input.color(#38bdf8, 'Entry', inline = 'm1_colors2', group = group_entry, active = crtM1Show)
color crtM1SlColor = input.color(#ef4444, 'SL', inline = 'm1_colors2', group = group_entry, active = crtM1Show)
color crtM2BullColor = input.color(color.new(#22c55e, 82), 'Bullish M2 FVG', inline = 'm2_colors', group = group_entry, active = crtM2Enabled)
color crtM2BearColor = input.color(color.new(#fb7185, 82), 'Bearish M2 FVG', inline = 'm2_colors', group = group_entry, active = crtM2Enabled)

// Blocks have their own confirmed-zone engine. They are intentionally not
// folded into the legacy candle-colour OB shortcut used by C2 POI resolution.
bool blocksShow = input.bool(true, 'Show confirmed blocks', group = group_blocks)
bool rbBullShow = input.bool(true, 'Bull RB', inline = 'rb_show', group = group_blocks, active = blocksShow)
bool rbBearShow = input.bool(true, 'Bear RB', inline = 'rb_show', group = group_blocks, active = blocksShow)
bool obBullShow = input.bool(true, 'Bull OB', inline = 'ob_show', group = group_blocks, active = blocksShow)
bool obBearShow = input.bool(true, 'Bear OB', inline = 'ob_show', group = group_blocks, active = blocksShow)
float rbMinWickRatio = input.float(0.35, 'RB min wick/range', minval = 0.05, maxval = 0.95, step = 0.05, group = group_blocks)
bool rbNeedDisplacement = input.bool(false, 'RB needs displacement', group = group_blocks, tooltip = 'Requires the confirmation candle to close away from the rejection with a minimum body/range ratio.')
float blockMinDisplacement = input.float(0.55, 'Min displacement body/range', minval = 0.10, maxval = 1.00, step = 0.05, group = group_blocks)
int obSearchBars = input.int(6, 'OB origin search bars', minval = 1, maxval = 20, group = group_blocks)
string obBoundaryMode = input.string('Body', 'OB boundary', options = ['Body', 'Full candle'], group = group_blocks)
bool obNeedSwingBreak = input.bool(false, 'OB needs structure break', group = group_blocks)
bool obNeedFvg = input.bool(false, 'OB needs FVG', group = group_blocks)
string blockInvalidation = input.string('Close', 'Block invalidation', options = ['Wick', 'Close'], group = group_blocks, tooltip = 'Bullish blocks invalidate below the lower boundary; bearish blocks invalidate above the upper boundary.')
string blockAfterTouch = input.string('Fade', 'After mitigation', options = ['Keep', 'Fade', 'Remove'], group = group_blocks)
int blockOpacity = input.int(86, 'Zone opacity', minval = 0, maxval = 100, group = group_blocks)
int blockMaxZones = input.int(12, 'Max zones per type', minval = 1, maxval = 50, group = group_blocks)
bool blockOnlyC2C3 = input.bool(false, 'Only blocks associated with C2/C3', group = group_blocks, tooltip = 'Optional display filter. A zone must be first touched during a known C2/C3 window.')
color bullRbColor = input.color(#38bdf8, 'Bull RB', inline = 'block_colors1', group = group_blocks)
color bearRbColor = input.color(#f97316, 'Bear RB', inline = 'block_colors1', group = group_blocks)
color bullObColor = input.color(#22c55e, 'Bull OB', inline = 'block_colors2', group = group_blocks)
color bearObColor = input.color(#ef476f, 'Bear OB', inline = 'block_colors2', group = group_blocks)
bool mf1 = input.bool(true, '1H SMT', inline = 'smt', group = group_mf)
bool mf4 = input.bool(true, '4H SMT', inline = 'smt', group = group_mf)
bool mfD = input.bool(true, 'Daily SMT', inline = 'smt', group = group_mf)
string mfPeer = input.symbol('FOREXCOM:SPXUSD', 'SMT comparison asset', group = group_mf, tooltip = 'Use a positively correlated symbol with matching feed/trading hours. Missing timestamp-matched samples suppress SMT. Separate from PSP direction divergence.')
bool mfChartSmt = input.bool(true, 'SMT on chart', group = group_mf)
bool mfPane1 = input.bool(false, 'Add 1H candles', inline = 'panes', group = group_mf)
bool mfPane4 = input.bool(true, 'Add 4H candles', inline = 'panes', group = group_mf)
bool mfPaneD = input.bool(true, 'Add Daily candles', inline = 'panes', group = group_mf)
int mfCandles = input.int(3, 'Candles per added panel', minval = 2, maxval = 6, group = group_mf)
int mfHistory = input.int(20, 'SMT history per timeframe', minval = 2, maxval = 50, group = group_mf)
color mfBull = input.color(#00adef, 'Bull markings', inline = 'palette', group = group_mf)
color mfBear = input.color(#db5755, 'Bear markings', inline = 'palette', group = group_mf)

// PSP source behavior: compare the active HTF candle's direction across correlated
// assets. "Polarity Change" highlights every divergence; "PSP" also requires a
// confirmed 1-left/1-right pivot on the chart or (unless Precise Mode) a companion.
bool psp_enabled                = input.bool(true, 'Show PSP Divergence', group=group_psp)
string psp_mode                 = input.string('Polarity Change', 'Detection', options=['Polarity Change', 'PSP'], group=group_psp, active=psp_enabled, tooltip='Polarity Change: highlight every candle-direction divergence (the source script default).\n\nPSP: require the divergence to coincide with a confirmed pivot.')
bool psp_precise_mode           = input.bool(false, 'Precise Mode', group=group_psp, active=psp_enabled and psp_mode == 'PSP', tooltip='Only accept a pivot on the current chart. OFF also accepts a pivot on either correlated asset.')
color psp_bull_div_body         = input.color(color.new(#00adef, 50), 'Bullish', inline='psp_colors', group=group_psp, active=psp_enabled)
color psp_bear_div_body         = input.color(color.new(#db5755, 50), 'Bearish', inline='psp_colors', group=group_psp, active=psp_enabled)
string psp_asset_preset         = input.string('Auto', 'Correlation Preset', options=['Auto', 'Manual'], group=group_psp, active=psp_enabled, tooltip='Auto uses the imported AssetCorrelationUtils mapping for the current chart. Manual requires the chart plus at least one correlated symbol.')
string psp_manual_asset1        = input.symbol('', 'Manual Asset 1', group=group_psp, active=psp_enabled and psp_asset_preset == 'Manual')
string psp_manual_asset2        = input.symbol('', 'Manual Asset 2', group=group_psp, active=psp_enabled and psp_asset_preset == 'Manual')
string psp_manual_asset3        = input.symbol('', 'Manual Asset 3', group=group_psp, active=psp_enabled and psp_asset_preset == 'Manual')
bool psp_invert_asset3          = input.bool(false, 'Invert Asset 3', group=group_psp, active=psp_enabled and psp_asset_preset == 'Manual', tooltip='Use for an inverse correlation such as DXY. The inversion follows Asset 3 when the assets are reordered around the current chart.')

PSPMatchAsset(string assetTicker) =>
    if str.length(assetTicker) == 0
        false
    else
        string chartTicker = syminfo.ticker
        string chartTickerId = syminfo.tickerid
        syminfo.type == 'futures' ? (str.contains(chartTickerId, assetTicker) or str.contains(assetTicker, chartTicker)) : (str.contains(chartTickerId, assetTicker) or str.contains(assetTicker, chartTicker))

int psp_populated_assets = (str.length(psp_manual_asset1) > 0 ? 1 : 0) + (str.length(psp_manual_asset2) > 0 ? 1 : 0) + (str.length(psp_manual_asset3) > 0 ? 1 : 0)
bool psp_matches_asset1 = PSPMatchAsset(psp_manual_asset1)
bool psp_matches_asset2 = PSPMatchAsset(psp_manual_asset2)
bool psp_matches_asset3 = PSPMatchAsset(psp_manual_asset3)
bool psp_manual_valid = psp_asset_preset == 'Manual' and psp_populated_assets >= 2 and (psp_matches_asset1 or psp_matches_asset2 or psp_matches_asset3)

string psp_resolved_primary = ''
string psp_resolved_secondary = ''
string psp_resolved_tertiary = ''
bool psp_resolved_invert_secondary = false
bool psp_resolved_invert_tertiary = false

if psp_manual_valid
    if psp_matches_asset1
        psp_resolved_primary := psp_manual_asset1
        psp_resolved_secondary := str.length(psp_manual_asset2) > 0 ? psp_manual_asset2 : psp_manual_asset3
        psp_resolved_tertiary := str.length(psp_manual_asset2) > 0 and str.length(psp_manual_asset3) > 0 ? psp_manual_asset3 : ''
        psp_resolved_invert_secondary := str.length(psp_manual_asset2) == 0 and psp_invert_asset3
        psp_resolved_invert_tertiary := str.length(psp_manual_asset2) > 0 and psp_invert_asset3
    else if psp_matches_asset2
        psp_resolved_primary := psp_manual_asset2
        psp_resolved_secondary := str.length(psp_manual_asset1) > 0 ? psp_manual_asset1 : psp_manual_asset3
        psp_resolved_tertiary := str.length(psp_manual_asset1) > 0 and str.length(psp_manual_asset3) > 0 ? psp_manual_asset3 : ''
        psp_resolved_invert_secondary := str.length(psp_manual_asset1) == 0 and psp_invert_asset3
        psp_resolved_invert_tertiary := str.length(psp_manual_asset1) > 0 and psp_invert_asset3
    else if psp_matches_asset3
        psp_resolved_primary := psp_manual_asset3
        psp_resolved_secondary := str.length(psp_manual_asset1) > 0 ? psp_manual_asset1 : psp_manual_asset2
        psp_resolved_tertiary := str.length(psp_manual_asset1) > 0 and str.length(psp_manual_asset2) > 0 ? psp_manual_asset2 : ''
        psp_resolved_invert_secondary := psp_invert_asset3
        psp_resolved_invert_tertiary := psp_invert_asset3

// General Settings
alerts_enabled_input            = input.bool(true, 'Alerts?', group=group_general, tooltip='To turn on the alerts, follow these steps:\n\n1) Make sure that the Alerts? toggle is ON.\n2) Right-click on the indicator on your chart.\n3) Click Add Alert on this indicator.\n4) Choose the Alert Name and confirm by clicking Create.\n\nNOTE: if you change any Settings, delete and re-create the alerts!')
settings.alerts_enabled         := alerts_enabled_input
settings.sweep_history          := input.int(10, 'History        ', minval=0, group=group_general, inline='history')
settings.sweep_visible_only     := input.bool(true, '', tooltip='Number of historical setups to show:\n\n☑ ON: Setups on visible HTF candles always shown. This count adds older setups that scrolled away.\n\n☐ OFF: Only show this many setups total.', inline='history', group=group_general)
fractal_mode_input              = input.string('Automatic','CRT alignment', options=['Automatic', '1m-1H', '5m-4H', '1H-1D', '4H-1W', '1D-1M', 'Custom'], group=group_general, tooltip='Only the five CRT alignments are available. Automatic maps 1m→1H and 5m→4H; on a 1H, 4H, or 1D chart it stays native so you can review that source candle’s own sweep/FVG drawings. Choose a listed pair to force the next higher alignment.')
settings.fractal_mode           := fractal_mode_input
settings.custom_ltf             := input.timeframe('5', 'Custom Fractal  ', inline='custom_tf', group=group_general)
custom_htf_input                = input.timeframe('60','-', inline='custom_tf', group=group_general)
settings.bias                   := input.string('Neutral', 'Bias', options=['Neutral', 'Bullish', 'Bearish'], group=group_general, tooltip='Filter setups by direction:\n\nNeutral: Show both bullish and bearish setups.\nBullish: Only show bullish setups (low sweeps).\nBearish: Only show bearish setups (high sweeps).')

getHigherTF() =>
    switch timeframe.period
        "1" => "60"
        "5" => "240"
        "60" => "60"
        "240" => "240"
        "1D" => "1D"
        => ""

// ============================================================================
// Quarterly Theory Session-Based Detection
// ============================================================================
// Based on ICT Quarterly Theory cycles with exact session times:
// - Micro Cycle: 22.5 min quarters (16 per 6-hour session)
// - 90-Min Cycle: 90 min session quarters (4 per 6-hour session)
// - Daily Cycle: 6hr quarters (Q1=18:00-00:00, Q2=00:00-06:00, Q3=06:00-12:00, Q4=12:00-18:00)

// Return special session flags for Quarterly mode
getQuarterlyHTF() =>
    switch timeframe.period
        "1" => "SESSION_MICRO"   // 1m → 22.5m session-based (Micro Cycle)
        "3" => "SESSION_90"      // 3m → 90m session-based (Ninety-Min Cycle)
        "5" => "SESSION_90"      // 5m → 90m session-based (Ninety-Min Cycle)
        "15" => "SESSION_6H"     // 15m → 6H session-based (Daily Quarter)
        "30" => "SESSION_6H"     // 30m → 6H session-based (Daily Quarter)
        => getHigherTF()         // Higher TFs use standard alignment

// Check if we're in session-based Quarterly mode
isQuarterlyMode() => str.startswith(htf.settings.htf, "SESSION_")

// Helper function to check if we're in a session (must be at top level, not nested)
inSession(string session) => math.sign(nz(time(timeframe.period, session, 'America/New_York'))) == 1

// Detect current Micro quarter - matches Quarterly Theory indicator exactly
// Asian: 1800-2145 (10 quarters), London/NY AM/NY PM: full 16 quarters each
getCurrentMicroSession() =>
    // Asian Session (1800-2145 only - 10 quarters as per Quarterly Theory)
    if inSession('1800-1822')
        "1800-1822"
    else if inSession('1822-1845')
        "1822-1845"
    else if inSession('1845-1907')
        "1845-1907"
    else if inSession('1907-1930')
        "1907-1930"
    else if inSession('1930-1952')
        "1930-1952"
    else if inSession('1952-2015')
        "1952-2015"
    else if inSession('2015-2037')
        "2015-2037"
    else if inSession('2037-2100')
        "2037-2100"
    else if inSession('2100-2122')
        "2100-2122"
    else if inSession('2122-2145')
        "2122-2145"
    // London Session (0000-0600 - 16 quarters)
    else if inSession('0000-0022')
        "0000-0022"
    else if inSession('0022-0045')
        "0022-0045"
    else if inSession('0045-0107')
        "0045-0107"
    else if inSession('0107-0130')
        "0107-0130"
    else if inSession('0130-0152')
        "0130-0152"
    else if inSession('0152-0215')
        "0152-0215"
    else if inSession('0215-0237')
        "0215-0237"
    else if inSession('0237-0300')
        "0237-0300"
    else if inSession('0300-0322')
        "0300-0322"
    else if inSession('0322-0345')
        "0322-0345"
    else if inSession('0345-0407')
        "0345-0407"
    else if inSession('0407-0430')
        "0407-0430"
    else if inSession('0430-0452')
        "0430-0452"
    else if inSession('0452-0515')
        "0452-0515"
    else if inSession('0515-0537')
        "0515-0537"
    else if inSession('0537-0600')
        "0537-0600"
    // NY AM Session (0600-1200 - 16 quarters)
    else if inSession('0600-0622')
        "0600-0622"
    else if inSession('0622-0645')
        "0622-0645"
    else if inSession('0645-0707')
        "0645-0707"
    else if inSession('0707-0730')
        "0707-0730"
    else if inSession('0730-0752')
        "0730-0752"
    else if inSession('0752-0815')
        "0752-0815"
    else if inSession('0815-0837')
        "0815-0837"
    else if inSession('0837-0900')
        "0837-0900"
    else if inSession('0900-0922')
        "0900-0922"
    else if inSession('0922-0945')
        "0922-0945"
    else if inSession('0945-1007')
        "0945-1007"
    else if inSession('1007-1030')
        "1007-1030"
    else if inSession('1030-1052')
        "1030-1052"
    else if inSession('1052-1115')
        "1052-1115"
    else if inSession('1115-1137')
        "1115-1137"
    else if inSession('1137-1200')
        "1137-1200"
    // NY PM Session (1200-1800 - 16 quarters)
    else if inSession('1200-1222')
        "1200-1222"
    else if inSession('1222-1245')
        "1222-1245"
    else if inSession('1245-1307')
        "1245-1307"
    else if inSession('1307-1330')
        "1307-1330"
    else if inSession('1330-1352')
        "1330-1352"
    else if inSession('1352-1415')
        "1352-1415"
    else if inSession('1415-1437')
        "1415-1437"
    else if inSession('1437-1500')
        "1437-1500"
    else if inSession('1500-1522')
        "1500-1522"
    else if inSession('1522-1545')
        "1522-1545"
    else if inSession('1545-1607')
        "1545-1607"
    else if inSession('1607-1630')
        "1607-1630"
    else if inSession('1630-1652')
        "1630-1652"
    else if inSession('1652-1715')
        "1652-1715"
    else if inSession('1715-1737')
        "1715-1737"
    else if inSession('1737-1800')
        "1737-1800"
    else
        ""

// Detect current 90-min cycle quarter
getCurrentNinetySession() =>
    // Asian (18:00-00:00)
    if inSession('1800-1930')
        "1800-1930"
    else if inSession('1930-2100')
        "1930-2100"
    else if inSession('2100-2230')
        "2100-2230"
    else if inSession('2230-0000')
        "2230-0000"
    // London (00:00-06:00)
    else if inSession('0000-0130')
        "0000-0130"
    else if inSession('0130-0300')
        "0130-0300"
    else if inSession('0300-0430')
        "0300-0430"
    else if inSession('0430-0600')
        "0430-0600"
    // NY AM (06:00-12:00)
    else if inSession('0600-0730')
        "0600-0730"
    else if inSession('0730-0900')
        "0730-0900"
    else if inSession('0900-1030')
        "0900-1030"
    else if inSession('1030-1200')
        "1030-1200"
    // NY PM (12:00-18:00)
    else if inSession('1200-1330')
        "1200-1330"
    else if inSession('1330-1500')
        "1330-1500"
    else if inSession('1500-1630')
        "1500-1630"
    else if inSession('1630-1800')
        "1630-1800"
    else
        ""

// Detect current 6-hour (daily quarter) cycle
getCurrentDailySession() =>
    if inSession('1800-0000')
        "1800-0000"  // Q1 Accumulation
    else if inSession('0000-0600')
        "0000-0600"  // Q2 Manipulation
    else if inSession('0600-1200')
        "0600-1200"  // Q3 Distribution
    else if inSession('1200-1800')
        "1200-1800"  // Q4 Continuation/Reversal
    else
        ""

// Get current session based on quarterly mode type
getCurrentQuarterlySession() =>
    switch htf.settings.htf
        "SESSION_MICRO" => getCurrentMicroSession()
        "SESSION_90" => getCurrentNinetySession()
        "SESSION_6H" => getCurrentDailySession()
        => ""

// Track previous session to detect changes (moved to main execution for var modification)
var string prevQuarterlySession = ""

// Get duration in seconds for SESSION_* modes (used instead of timeframe.in_seconds)
getQuarterlyDurationSeconds(string htf_setting) =>
    switch htf_setting
        "SESSION_MICRO" => 1350  // 22.5 min = 1350 seconds
        "SESSION_90" => 5400     // 90 min = 5400 seconds
        "SESSION_6H" => 21600    // 6 hours = 21600 seconds
        => 0

// Parse fractal mode to get HTF
getFractalHTF() =>
    switch settings.fractal_mode
        "Automatic" => getHigherTF()
        "Custom" => custom_htf_input
        "1m-1H" => "60"
        "5m-4H" => "240"
        "1H-1D" => "1D"
        "4H-1W" => "1W"
        "1D-1M" => "1M"
        => getHigherTF()

// Same resolution as getFractalHTF(), but kept "simple string" (never touches a UDT field) so it can be
// passed to timeframe.change() for native, request.security()-free new-HTF-candle detection.
getFractalHTFSimple(simple string mode) =>
    switch mode
        "Automatic" => getHigherTF()
        "Custom" => custom_htf_input
        "1m-1H" => "60"
        "5m-4H" => "240"
        "1H-1D" => "1D"
        "4H-1W" => "1W"
        "1D-1M" => "1M"
        => getHigherTF()

// HTF Candles settings
// Alignment owns the source timeframe. CRT hours filter the 1H model only;
// they must never force every alignment (including 4H/1D/1W) back to 1H.
htf.settings.htf := getFractalHTF()
// The 1m chart must use the identical completed 1H C1 H/L that a 1H
// chart sees. [1] plus lookahead_on is safe here: it returns ONLY the
// previously CLOSED hourly candle, never the developing current hour.
// Always request at global scope so historical and realtime sampling agree.
[crt1hPrevHigh, crt1hPrevLow, crt1hPrevTime] = request.security(syminfo.tickerid, '60', [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
bool crtUseHourlyLtfReference = htf.settings.htf == '60' and timeframe.in_seconds() < timeframe.in_seconds('60')
hide_candles_input             = input.bool(false, 'Hide Projection?', group = group_htf, inline='offset')
settings.hide_candles          := hide_candles_input
hide_setups_input              = input.bool(false, 'Hide Setups?', group = group_htf, inline='offset', tooltip='Hide all CRT setups (sweeps, used POIs, CISD). Only show the HTF candle projection and optional vertical separators.')
settings.hide_setups           := hide_setups_input
htf.settings.max_display       := input.int(4, 'HTF Candles      ', minval=4, group = group_htf,inline='HTF Candles',active = not hide_candles_input)
candle_size_input              = input.string('Small', 'Size', options=['Small', 'Normal', 'Big'],group = group_htf,inline='HTF Candles',active = not hide_candles_input)
settings.width                 := candle_size_input == 'Small' ? 2 : candle_size_input == 'Normal' ? 4 : 6
settings.offset                := input.int(10, 'Offset           ', minval = 1, group = group_htf,inline='Offset',active = not hide_candles_input)
settings.bull_body             := input.color(color.new(#808080,0), 'Body            ', inline = 'body', group = group_htf,active = not hide_candles_input)
settings.bear_body             := input.color(#505050, '', inline = 'body', group = group_htf,active = not hide_candles_input)
settings.bull_border           := input.color(#808080, 'Border           ', inline = 'border', group = group_htf,active = not hide_candles_input)
settings.bear_border           := input.color(#808080, '', inline = 'border', group = group_htf,active = not hide_candles_input)
settings.bull_wick             := input.color(#808080, 'Wick             ', inline = 'wick', group = group_htf,active = not hide_candles_input)
settings.bear_wick             := input.color(#808080, '', inline = 'wick', group = group_htf,active = not hide_candles_input)
trace_show_input               = input.bool(false, 'HTF Open    ', inline = 'trace', group = group_htf,active = not hide_candles_input)
settings.trace_show            := trace_show_input
settings.trace_o_color         := input.color(color.new(#808080, 50), '', inline = 'trace', group = group_htf, active = trace_show_input and not hide_candles_input)
settings.trace_o_style         := input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'trace', group = group_htf, active = trace_show_input and not hide_candles_input)
settings.trace_o_size          := input.int(1, 'Width', options = [1, 2, 3, 4], inline = 'trace', group = group_htf, active = trace_show_input and not hide_candles_input)
vt_show_input                  = input.bool(true, 'Vertical Lines ', inline = 'vt', group = group_htf)
htf.settings.vt_show           := vt_show_input
htf.settings.vt_color          := input.color(color.new(#808080, 70), '', inline = 'vt', group = group_htf, active = vt_show_input)
htf.settings.vt_style          := input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'vt', group = group_htf, active = vt_show_input)
htf.settings.vt_size           := input.int(1, 'Width', options = [1, 2, 3, 4], inline = 'vt', group = group_htf, active = vt_show_input)
// Retired: the generic HTF high/low lines were the long white lines cutting
// across the chart. CRT now draws only a sweep, a used POI, or an enabled
// active OHP/OLP target.
htf.settings.hl_show           := false
