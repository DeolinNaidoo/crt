// IC-CISD Alert (gated): fires only when the enabled criteria below are all satisfied for that specific IC-CISD
string group_ic_alert           = "IC-CISD Alerts  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
ic_alert_show_input             = input.bool(false, 'Enable IC-CISD Alert', group = group_ic_alert, tooltip='Fires an alert only when an IC-CISD confirms AND the criteria checked below are all true for that IC-CISD.\n\nFVG Tap / Swing Sweep: once the reversal CISD confirms, candidate FVGs and swing points (same direction as the setup) are collected starting on the C2 leg and continuing through C3/C4. This criterion is satisfied once price trades into one of the FVGs, or sweeps one of the swing points (wick beyond + close back through). If BOTH are checked, either one satisfies it.\n\nNear Previous EQ: satisfied once price comes within the tolerance below of the currently active Previous EQ line (C2 mid during C3, C3 mid during C4).\n\nEach criterion must happen before this IC-CISD confirms. After an IC-CISD confirms, the requirement resets — the next IC-CISD needs its own fresh tap/sweep/EQ-touch.')
settings.ic_alert_show          := ic_alert_show_input
settings.ic_alert_crit_fvg      := input.bool(true, 'FVG Tap', inline = 'ic_crit', group = group_ic_alert, active = ic_alert_show_input)
settings.ic_alert_crit_sweep    := input.bool(true, 'Swing Sweep', inline = 'ic_crit', group = group_ic_alert, active = ic_alert_show_input)
ic_alert_crit_eq_input           = input.bool(false, 'Near Previous EQ', inline = 'ic_crit', group = group_ic_alert, active = ic_alert_show_input)
settings.ic_alert_crit_eq       := ic_alert_crit_eq_input
settings.ic_alert_eq_tol_pct    := input.float(10.0, 'EQ Tolerance (% of C2 range)', minval = 0, step = 1, group = group_ic_alert, active = ic_alert_show_input and ic_alert_crit_eq_input, tooltip='How close price needs to come to the Previous EQ line, expressed as a percentage of the C2 HTF candle\'s high-low range.')

// ============================================================================
// Helper Functions
// ============================================================================

// Initialize the correlated symbols once. Auto mode uses the same correlation
// library as the source PSP script; Manual mode keeps the chart as the primary.
method InitializePSPAssets(CandleSet candleSet) =>
    candleSet.psp_asset1.symbol := syminfo.tickerid
    candleSet.psp_asset1.invert := false
    candleSet.psp_asset1.include := true
    if psp_asset_preset == 'Manual'
        if psp_manual_valid
            candleSet.psp_asset2.symbol := psp_resolved_secondary
            candleSet.psp_asset3.symbol := psp_resolved_tertiary
            candleSet.psp_asset2.invert := psp_resolved_invert_secondary
            candleSet.psp_asset3.invert := psp_resolved_invert_tertiary
        else
            candleSet.psp_asset2.symbol := ''
            candleSet.psp_asset3.symbol := ''
            candleSet.psp_asset2.invert := false
            candleSet.psp_asset3.invert := false
    else
        AC.AssetConfig autoConfig = AC.resolveCurrentChart()
        candleSet.psp_asset1.symbol := autoConfig.primary
        candleSet.psp_asset2.symbol := na(autoConfig.secondary) ? '' : autoConfig.secondary
        candleSet.psp_asset3.symbol := na(autoConfig.tertiary) ? '' : autoConfig.tertiary
        candleSet.psp_asset2.invert := autoConfig.invertSecondary
        candleSet.psp_asset3.invert := autoConfig.invertTertiary
    candleSet.psp_asset2.include := str.length(candleSet.psp_asset2.symbol) > 0
    candleSet.psp_asset3.include := str.length(candleSet.psp_asset3.symbol) > 0
    candleSet

PSPSetDirection(PSPAsset asset) =>
    asset.bullish := asset.invert ? asset.data_close < asset.data_open : asset.data_close > asset.data_open
    asset.bearish := asset.invert ? asset.data_close > asset.data_open : asset.data_close < asset.data_open
    asset

// Update the just-closed HTF candle's divergence at a boundary and the live
// candle during real-time development. A confirmed PSP is stamped on the middle
// candle only after its right-hand HTF candle has closed, avoiding repainting.
method UpdatePSP(CandleSet candleSet, bool isNewHTFCandleArg) =>
    bool psp_timeframe_ok = not isQuarterlyMode() and str.length(candleSet.settings.htf) > 0
    if psp_enabled and psp_timeframe_ok and candleSet.candles.size() > 0
        int div_idx = isNewHTFCandleArg and candleSet.candles.size() > 1 ? 1 : 0
        Candle div_candle = candleSet.candles.get(div_idx)

        candleSet.psp_asset1.data_open := div_candle.o
        candleSet.psp_asset1.data_close := div_candle.c
        candleSet.psp_asset1.data_high := div_candle.h
        candleSet.psp_asset1.data_low := div_candle.l
        candleSet.psp_asset1.has_data := true
        PSPSetDirection(candleSet.psp_asset1)

        if candleSet.psp_asset2.include
            [psp_o2, psp_h2, psp_l2, psp_c2] = request.security(candleSet.psp_asset2.symbol, candleSet.settings.htf, [open, high, low, close])
            candleSet.psp_asset2.data_open := psp_o2
            candleSet.psp_asset2.data_close := psp_c2
            candleSet.psp_asset2.data_high := psp_h2
            candleSet.psp_asset2.data_low := psp_l2
            candleSet.psp_asset2.has_data := not na(psp_o2)
            PSPSetDirection(candleSet.psp_asset2)
        else
            candleSet.psp_asset2.has_data := false

        if candleSet.psp_asset3.include
            [psp_o3, psp_h3, psp_l3, psp_c3] = request.security(candleSet.psp_asset3.symbol, candleSet.settings.htf, [open, high, low, close])
            candleSet.psp_asset3.data_open := psp_o3
            candleSet.psp_asset3.data_close := psp_c3
            candleSet.psp_asset3.data_high := psp_h3
            candleSet.psp_asset3.data_low := psp_l3
            candleSet.psp_asset3.has_data := not na(psp_o3)
            PSPSetDirection(candleSet.psp_asset3)
        else
            candleSet.psp_asset3.has_data := false

        div_candle.divergence12 := candleSet.psp_asset2.has_data and ((candleSet.psp_asset1.bullish and candleSet.psp_asset2.bearish) or (candleSet.psp_asset1.bearish and candleSet.psp_asset2.bullish))
        div_candle.divergence13 := candleSet.psp_asset3.has_data and ((candleSet.psp_asset1.bullish and candleSet.psp_asset3.bearish) or (candleSet.psp_asset1.bearish and candleSet.psp_asset3.bullish))
        div_candle.divergence23 := candleSet.psp_asset2.has_data and candleSet.psp_asset3.has_data and ((candleSet.psp_asset2.bullish and candleSet.psp_asset3.bearish) or (candleSet.psp_asset2.bearish and candleSet.psp_asset3.bullish))
        div_candle.has_divergence := div_candle.divergence12 or div_candle.divergence13 or div_candle.divergence23
        div_candle.is_bullish_div := candleSet.psp_asset1.bullish

        // At the opening of candle 4, candle 2 (index 2) now has completed
        // left and right neighbors and can be confirmed without lookahead.
        if isNewHTFCandleArg and candleSet.candles.size() > 3
            Candle pivot_right = candleSet.candles.get(1)
            Candle pivot_candle = candleSet.candles.get(2)
            Candle pivot_left = candleSet.candles.get(3)
            bool psp_primary_pivot = (pivot_candle.h > pivot_left.h and pivot_candle.h > pivot_right.h) or (pivot_candle.l < pivot_left.l and pivot_candle.l < pivot_right.l)
            bool psp_asset2_pivot = false
            bool psp_asset3_pivot = false
            if candleSet.psp_asset2.has_data
                [psp_ph2, psp_pl2] = request.security(candleSet.psp_asset2.symbol, candleSet.settings.htf, [ta.pivothigh(high, 1, 1), ta.pivotlow(low, 1, 1)])
                psp_asset2_pivot := not na(psp_ph2) or not na(psp_pl2)
            if candleSet.psp_asset3.has_data
                [psp_ph3, psp_pl3] = request.security(candleSet.psp_asset3.symbol, candleSet.settings.htf, [ta.pivothigh(high, 1, 1), ta.pivotlow(low, 1, 1)])
                psp_asset3_pivot := not na(psp_ph3) or not na(psp_pl3)
            bool psp_has_pivot = psp_precise_mode ? psp_primary_pivot : (psp_primary_pivot or psp_asset2_pivot or psp_asset3_pivot)
            pivot_candle.is_psp := psp_has_pivot and pivot_candle.has_divergence
    candleSet

// Copy the current/final divergence state onto each C2 setup. During C2 this
// changes at every scheduled PSP check. After C2 closes its candle state is no
// longer updated, so the suffix is frozen for historical display.
PSPCandleStateForSetup(CandleSet candleSet, Setup setup) =>
    bool state = false
    if psp_enabled and candleSet.candles.size() > 0
        for candle in candleSet.candles
            if candle.o_idx == setup.htf_candle_idx
                state := candle.has_divergence
                break
    state

method SyncC2PSP(CandleSet candleSet) =>
    if candleSet.has_live_bearish
        candleSet.live_bearish.c2_psp := PSPCandleStateForSetup(candleSet, candleSet.live_bearish)
    if candleSet.has_live_bullish
        candleSet.live_bullish.c2_psp := PSPCandleStateForSetup(candleSet, candleSet.live_bullish)
    candleSet

LineStyle(string style) =>
    switch style
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        => line.style_solid

LabelSize(string lbl_size) =>
    switch lbl_size
        'Tiny' => size.tiny
        'Normal' => size.normal
        'Large' => size.large
        'Huge' => size.huge
        => size.small

DayofWeek(int index) =>
    switch
        index == 1 => 'M'
        index == 2 => 'T'
        index == 3 => 'W'
        index == 4 => 'T'
        index == 5 => 'F'
        index == 6 => 'S'
        index == 7 => 'S'
        na(index) => ''

ValidTimeframe(string HTF) =>
    if timeframe.in_seconds(HTF) >= timeframe.in_seconds('D') and timeframe.in_seconds(HTF) > timeframe.in_seconds()
        true
    else
        n1 = timeframe.in_seconds()
        n2 = timeframe.in_seconds(HTF)
        // Equal resolutions are valid native mode: e.g. viewing the 1H
        // CRT source on a 1H chart must still build/draw its FVGs and sweeps.
        n1 <= n2 and math.round(n2 / n1) == n2 / n1

RemainingTime(string HTF) =>
    if barstate.isrealtime
        timeRemaining = (time_close(HTF) - timenow) / 1000
        days = math.floor(timeRemaining / 86400)
        hours = math.floor((timeRemaining - days * 86400) / 3600)
        minutes = math.floor((timeRemaining - days * 86400 - hours * 3600) / 60)
        seconds = math.floor(timeRemaining - days * 86400 - hours * 3600 - minutes * 60)
        r = str.tostring(seconds, '00')
        if minutes > 0 or hours > 0 or days > 0
            r := str.tostring(minutes, '00') + ':' + r
        if hours > 0 or days > 0
            r := str.tostring(hours, '00') + ':' + r
        if days > 0
            r := str.tostring(days) + 'D ' + r
        r
    else
        'n/a'

HTFName(string HTF) =>
    formatted = HTF
    seconds = timeframe.in_seconds(HTF)
    if seconds < 60
        formatted := str.tostring(seconds) + 's'
    else if seconds / 60 < 60
        formatted := str.tostring(seconds / 60) + 'm'
    else if seconds / 60 / 60 < 24
        formatted := str.tostring(seconds / 60 / 60) + 'H'
    formatted

// Get current chart timeframe formatted
LTFName() =>
    seconds = timeframe.in_seconds()
    result = timeframe.period
    if seconds < 60
        result := str.tostring(seconds) + 's'
    else if seconds < 3600
        result := str.tostring(seconds / 60) + 'm'
    else if seconds < 86400
        result := str.tostring(seconds / 3600) + 'H'
    result

// Build alert message: "LTF-HTF TICKER: [Potential] Bullish/Bearish <name>"
BuildAlertMessage(string htf, bool is_bullish, bool is_potential, string name) =>
    string ltf = LTFName()
    string htf_name = HTFName(htf)
    string direction = is_bullish ? "Bullish" : "Bearish"
    string potential = is_potential ? "Potential " : ""
    str.format("{0}-{1} {2}: {3}{4} {5}", ltf, htf_name, syminfo.ticker, potential, direction, name)

CandleSetHigh(array<Candle> candles, float h) =>
    float _h = h
    for c in candles
        if c.h > _h
            _h := c.h
    _h

CandleSetLow(array<Candle> candles, float l) =>
    float _l = l
    for c in candles
        if c.l < _l
            _l := c.l
    _l
// CISD body area (bodies only) from CISD start through C2 extreme — returns [body_lo, body_hi, body_mid]
GetCisdBodyRange(int cisd_start_idx, int extreme_bar_idx) =>
    float body_hi = na
    float body_lo = na
    if not na(cisd_start_idx) and not na(extreme_bar_idx)
        int off_a = bar_index - extreme_bar_idx
        int off_b = bar_index - cisd_start_idx
        int lo_off = math.max(0, math.min(off_a, off_b))
        int hi_off = math.min(math.max(off_a, off_b), 500)
        if lo_off <= hi_off
            for i = lo_off to hi_off
                float bt = math.max(open[i], close[i])
                float bb = math.min(open[i], close[i])
                body_hi := na(body_hi) ? bt : math.max(body_hi, bt)
                body_lo := na(body_lo) ? bb : math.min(body_lo, bb)
    float body_mid = not na(body_hi) and not na(body_lo) ? (body_hi + body_lo) / 2.0 : na
    [body_lo, body_hi, body_mid]

// Set C3 entry zone once: if C2 mid inside CISD body → C2 mid↔body mid; else C2 mid↔C3 open
TrySetEntryZoneC3(Setup setup) =>
    if settings.entry_zone_show and not setup.ez_c3_set and not setup.is_invalid and setup.is_post_c2 and setup.cisd_triggered and not na(setup.c2_mid) and not na(setup.c3_open) and not na(setup.cisd_start_idx) and not na(setup.extreme_bar_idx)
        [body_lo, body_hi, body_mid] = GetCisdBodyRange(setup.cisd_start_idx, setup.extreme_bar_idx)
        if not na(body_lo) and not na(body_hi) and not na(body_mid)
            float c2m = setup.c2_mid
            bool inside = c2m >= body_lo and c2m <= body_hi
            float y2 = inside ? body_mid : setup.c3_open
            setup.ez_c3_top := math.max(c2m, y2)
            setup.ez_c3_bot := math.min(c2m, y2)
            setup.ez_c3_set := true
    setup

// At C3 close / C4 open: always store C3 mid + C4 span (for Previous EQ); entry-zone box only if enabled
TrySetEntryZoneC4(Setup setup, float c3_h, float c3_l, float c4_open_price, int left_time, int right_time) =>
    if not setup.is_invalid and not na(c3_h) and not na(c3_l) and not na(c4_open_price)
        float c3m = (c3_h + c3_l) / 2.0
        setup.c3_mid := c3m
        setup.c3_extreme := setup.is_bullish ? c3_l : c3_h
        setup.c4_open := c4_open_price
        setup.ez_c4_left_time := left_time
        setup.ez_c4_right_time := right_time
        if settings.entry_zone_show and not setup.ez_c4_set
            setup.ez_c4_top := math.max(c3m, c4_open_price)
            setup.ez_c4_bot := math.min(c3m, c4_open_price)
            setup.ez_c4_set := true
            setup.ez_c4_invalid := false
    setup

// Right edge for entry zone / EQ: grows with each LTF bar; once period ends, locks at final edge
EntryZoneRight(int locked_right) =>
    int developing = time_close
    na(locked_right) ? developing : (time >= locked_right ? locked_right : math.min(developing, locked_right))

// Chart Previous EQ on for this setup? (On Chart or Both)
ShowChartEQ() =>
    prev_eq_show and (drawings_type == 'On Chart' or drawings_type == 'Both')

// HTF projection Previous EQ on for this setup? (HTF candle or Both)
ShowHtfEQ() =>
    prev_eq_show and (drawings_type == 'HTF candle' or drawings_type == 'Both')

// Find array index of HTF candle by o_idx (-1 if not in projection)
FindCandleIndex(array<Candle> candles, int o_idx) =>
    int found = -1
    if not na(o_idx) and candles.size() > 0
        for i = 0 to candles.size() - 1
            if candles.get(i).o_idx == o_idx
                found := i
                break
    found

// FindCISDLevel traces back from the extreme bar to find consecutive opposing candles
// Returns [cisd_level, cisd_start_idx]
// extreme_bar_idx: the bar index where lowest low (bullish) or highest high (bearish) occurred
// bias: 1 for bullish candles (bearish setup), -1 for bearish candles (bullish setup)
FindCISDLevel(int extreme_bar_idx, int bias) =>
    int offset = bar_index - extreme_bar_idx  // How many bars ago the extreme occurred
    
    float cisd_price = na
    int cisd_idx = na
    bool found_first = false
    
    // Start from the extreme bar itself and trace back
    for i = offset to math.min(offset + 500, bar_index)
        float c_open = open[i]
        float c_close = close[i]
        int candle_attitude = c_close > c_open ? 1 : c_close < c_open ? -1 : 0
        
        if candle_attitude == 0
            continue
        
        if not found_first
            if candle_attitude == bias
                found_first := true
                cisd_price := c_open
                cisd_idx := bar_index - i
        else
            if candle_attitude != bias
                break
            cisd_price := c_open
            cisd_idx := bar_index - i
    
    [cisd_price, cisd_idx]

// ——— IC-CISD (active helpers) ———
// Exact lower-timeframe timestamp of the first interaction with a resolved
// HTF POI during C2. This powers the C2 tooltip.
FirstC2PoiTouch(int c2StartIndex, float top, float bottom) =>
    int touched = na
    int stamp = na
    int span = math.min(480, bar_index - c2StartIndex)
    if span >= 1
        // Pine determines the descending step automatically when the start
        // is greater than the end. Supplying `by -1` faults at runtime.
        for off = span to 1
            if high[off] >= bottom and low[off] <= top
                touched := bar_index - off
                stamp := time[off]
                break
    [touched, stamp]

// Selected CRT key times belong only to the 1H source. Higher alignments use
// their full candle and are not silently rejected by the hourly time list.
IsSelectedCrtKeyTime(int stamp) =>
    bool selected = false
    if htf.settings.htf == '60'
        int nyHour = na(stamp) ? -1 : hour(stamp, 'America/New_York')
        selected := (nyHour == 20 and clCrt20) or (nyHour == 21 and clCrt21) or (nyHour == 3 and clCrt03) or (nyHour == 6 and clCrt06) or (nyHour == 9 and clCrt09) or (nyHour == 10 and clCrt10)
    selected

CLCrtHourAllowed(int stamp) =>
    not clUseCrtTiming or htf.settings.htf != '60' or IsSelectedCrtKeyTime(stamp)

PoiChecklistEnabled(string poi_kind) =>
    switch poi_kind
        'FVG' => clC2FvgPoi
        'OB' => clC2ObPoi
        'OHP' => clC2OhpPoi
        'OLP' => clC2OlpPoi
        'IFVG' => clC2IfvgPoi
        'RB' => clC2RbPoi
        'OCL' => clC2OclPoi
        => false

ShouldDisplayC2(Setup setup) =>
    bool matching_poi = PoiChecklistEnabled(setup.htf_poi_kind)
    bool keep_key_time = crtShowNonPoiAtKeyTimes and IsSelectedCrtKeyTime(ChartBarTime(setup.htf_candle_idx))
    not crtOnlyChecklistC2 or matching_poi or keep_key_time

// These resolver guards are deliberately declared before ResolveHtfPoi:
// Pine requires functions to be available at the point of the call.
LiquidityBrokenBeforeC2(CandleSet candleSet, HTFLiquidity level, Candle c2) =>
    bool broken = false
    for checked in candleSet.candles
        if checked.o_idx > level.origin_idx and checked.o_idx < c2.o_idx
            float body_top = math.max(checked.o, checked.c)
            float body_bot = math.min(checked.o, checked.c)
            broken := broken or (level.is_high ? body_top > level.price : body_bot < level.price)
    broken

OclBrokenBeforeC2(CandleSet candleSet, HTFOCL level, Candle c2) =>
    bool broken = false
    for checked in candleSet.candles
        if checked.o_idx > level.origin_idx and checked.o_idx < c2.o_idx
            float body_top = math.max(checked.o, checked.c)
            float body_bot = math.min(checked.o, checked.c)
            broken := broken or (body_bot < level.price and body_top > level.price)
    broken

// Human-readable timeframe labels for the compact CRT readout.  A 1H chart
// using a 1H CRT source is native HTF mode, not a misleading "60 → 60" pair.
DisplayResolution(string resolution) =>
    switch resolution
        '1' => '1m'
        '5' => '5m'
        '15' => '15m'
        '30' => '30m'
        '45' => '45m'
        '60' => '1H'
        '120' => '2H'
        '240' => '4H'
        '1D' => '1D'
        '1W' => '1W'
        '1M' => '1M'
        => resolution

ICHardStop(Setup setup) =>
    setup.is_invalid or setup.ez_c4_invalid or (not na(setup.c5_end_time) and time >= setup.c5_end_time)

// Whether a confirmed IC-CISD's stage (3, 4, or 5) is currently enabled for display
ICStageVisible(int stage) =>
    switch stage
        3 => settings.ic_show_c3
        4 => settings.ic_show_c4
        5 => settings.ic_show_c5
        => true

// A protected swing is useful only while its parent CRT setup is active.
// C2 is the setup candle; C3 and C4 are its confirmation windows.  Do not
// leave dots on the chart during C5 or at unrelated historical times.
ProtectedSwingWindowActive(Setup setup, string resolution) =>
    int start_time = ChartBarTime(setup.htf_candle_idx)
    int duration_ms = timeframe.in_seconds(resolution) * 1000
    int stop_time = na
    if not na(setup.c4_end_time)
        stop_time := setup.c4_end_time
    else if not na(start_time) and duration_ms > 0
        stop_time := start_time + duration_ms * 3
    not na(start_time) and not na(stop_time) and time >= start_time and time < stop_time

// Bullish setups keep only higher/equal protected lows.  Bearish setups keep
// only lower/equal protected highs.  A taken level is no longer protection.
DirectionalProtectedSwing(Setup setup, ICCisd ic) =>
    bool has_point = not na(ic.extreme_price) and not na(ic.extreme_idx)
    bool supports_direction = na(setup.c2_extreme) or (setup.is_bullish ? ic.extreme_price >= setup.c2_extreme : ic.extreme_price <= setup.c2_extreme)
    has_point and not ic.taken and ic.stage <= 4 and supports_direction

SetupPhase(Setup setup, string resolution) =>
    int start_time = ChartBarTime(setup.htf_candle_idx)
    int duration_ms = timeframe.in_seconds(resolution) * 1000
    string phase = '—'
    if not na(start_time) and duration_ms > 0
        phase := time < start_time + duration_ms ? 'C2' : time < start_time + duration_ms * 2 ? 'C3' : time < start_time + duration_ms * 3 ? 'C4' : 'Complete'
    phase

SetupHasProtectedSwing(Setup setup) =>
    bool found = false
    if not na(setup.ic_list) and setup.ic_list.size() > 0
        for point_i = 0 to setup.ic_list.size() - 1
            ICCisd point = setup.ic_list.get(point_i)
            if DirectionalProtectedSwing(setup, point)
                found := true
    found

ResolveHtfPoi(CandleSet candleSet, Setup setup) =>
    string poi_name = 'None'
    float poi_top = na
    float poi_bottom = na
    int poi_origin = na
    int poi_touch = na
    Candle c2 = Candle.new()
    bool has_c2 = false
    for c in candleSet.candles
        if c.o_idx == setup.htf_candle_idx
            c2 := c
            has_c2 := true
            break
    // The visual HTF cache is intentionally small. Historical setup
    // resolution therefore falls back to OHLC captured at C2 confirmation.
    if not has_c2 and not na(setup.c2_open_time)
        c2.o := setup.c2_open
        c2.c := setup.c2_close
        c2.h := setup.c2_high
        c2.l := setup.c2_low
        c2.o_time := setup.c2_open_time
        c2.o_idx := setup.htf_candle_idx
        has_c2 := true
    if has_c2
        // Only the wick on the C1-sweep side can qualify a POI.  Use the
        // complete wick segment, not just its final tip: a valid sweep may
        // trade through the whole FVG/OB before reclaiming it.
        float c2_body_top = math.max(c2.o, c2.c)
        float c2_body_bot = math.min(c2.o, c2.c)
        // Priority reflects the stronger, explicitly bounded POIs first.
        if clC2FvgPoi and fvgs.size() > 0
            for gap_i = 0 to fvgs.size() - 1
                FVG gap = fvgs.get(gap_i)
                // The gap must have been confirmed before (or precisely at
                // the open of) C2. A gap completed by C2 itself is a later
                // observation, never a valid POI for that same C2.
                bool available = gap.left_time < c2.o_time and gap.known_time <= c2.o_time and (na(gap.mit_time) or gap.mit_time >= c2.o_time)
                // POI direction follows the sweep side, not the colour of
                // C2: low sweep -> bullish FVG below, high sweep -> bearish
                // FVG above. C2 may itself close either colour.
                bool direction_match = setup.is_bullish ? gap.is_bullish : not gap.is_bullish
                // A same-side FVG can validate either when C2's wick reaches
                // it or when the C1 liquidity level being swept lies inside
                // the FVG. The latter is the "sweep at the FVG" case: C2 may
                // be a different-colour confirmation candle afterwards.
                bool sweep_level_matches = setup.sweep_price >= gap.bot and setup.sweep_price <= gap.top
                bool overlaps_gap = (setup.is_bullish ? c2.l <= gap.top : c2.h >= gap.bot) or sweep_level_matches
                bool reclaimed = setup.is_bullish ? c2.c > gap.bot : c2.c < gap.top
                if available and direction_match and overlaps_gap and reclaimed
                    poi_name := 'FVG'
                    poi_top := gap.top
                    poi_bottom := gap.bot
                    poi_origin := gap.left_time
                    break
        // An IFVG is an earlier FVG that received a body close fully through
        // it, then acts as the opposite-side POI on a later C2 wick.
        if poi_name == 'None' and clC2IfvgPoi and fvgs.size() > 0
            for gap_i = 0 to fvgs.size() - 1
                FVG gap = fvgs.get(gap_i)
                bool inverted_before_c2 = gap.known_time <= c2.o_time and not na(gap.ifvg_time) and gap.ifvg_time < c2.o_time
                bool direction_match = gap.is_bullish != setup.is_bullish
                bool overlaps_ifvg = setup.is_bullish ? c2.l <= gap.top : c2.h >= gap.bot
                bool reclaimed = setup.is_bullish ? c2.c > gap.bot : c2.c < gap.top
                if inverted_before_c2 and direction_match and overlaps_ifvg and reclaimed
                    poi_name := 'IFVG'
                    poi_top := gap.top
                    poi_bottom := gap.bot
                    poi_origin := gap.left_time
                    break
        // A Rejection Block comes only from the separately confirmed RB
        // engine. A naked wick/candle can never become an RB C2 POI.
        if poi_name == 'None' and clC2RbPoi and rbZones.size() > 0
            for zone_i = 0 to rbZones.size() - 1
                BlockZone zone = rbZones.get(zone_i)
                bool confirmed_before_c2 = zone.confirm_time < c2.o_time
                bool direction_match = zone.is_bullish == setup.is_bullish
                bool still_active = na(zone.invalidation_time)
                bool overlaps_zone = setup.is_bullish ? (c2.l <= zone.top and c2_body_bot >= zone.bot) : (c2.h >= zone.bot and c2_body_top <= zone.top)
                bool reclaimed = setup.is_bullish ? c2.c > zone.bot : c2.c < zone.top
                if confirmed_before_c2 and direction_match and still_active and overlaps_zone and reclaimed
                    poi_name := 'RB'
                    poi_top := zone.top
                    poi_bottom := zone.bot
                    poi_origin := zone.origin_time
                    break
        if poi_name == 'None'
            for old_candle in candleSet.candles
                // C1 is deliberately excluded: its sweep is CRT structure, not an HTF POI.
                bool older_than_c1 = old_candle.o_idx < setup.swept_candle_idx
                if older_than_c1 and clC2ObPoi
                    float body_top = math.max(old_candle.o, old_candle.c)
                    float body_bot = math.min(old_candle.o, old_candle.c)
                    bool sweep_touches_body = setup.is_bullish ? (c2.l <= body_top and c2_body_bot >= body_bot) : (c2.h >= body_bot and c2_body_top <= body_top)
                    bool bullish_ob = setup.is_bullish and old_candle.c < old_candle.o and sweep_touches_body and c2.c > body_top
                    bool bearish_ob = not setup.is_bullish and old_candle.c > old_candle.o and sweep_touches_body and c2.c < body_bot
                    if bullish_ob or bearish_ob
                        poi_name := 'OB'
                        poi_top := body_top
                        poi_bottom := body_bot
                        poi_origin := old_candle.o_time
                        break
        if poi_name == 'None' and htfLiquidity.size() > 0
            // OHP/OLP are confirmed HTF pivot liquidity levels. The C2 wick
            // must purge the level while its full body remains on the safe
            // side; internal candle highs/lows are not valid OHP/OLP.
            for level_i = 0 to htfLiquidity.size() - 1
                HTFLiquidity level = htfLiquidity.get(level_i)
                // A level is not reusable after an intervening confirmed HTF
                // body has broken its support/resistance side.  The persistent
                // lifecycle pass retires it on the next HTF boundary; this
                // cache check also protects historical/replay resolution.
                bool still_valid = level.active and not LiquidityBrokenBeforeC2(candleSet, level, c2)
                bool older_than_c1 = still_valid and level.origin_idx < setup.swept_candle_idx
                bool body_below = math.max(c2.o, c2.c) <= level.price
                bool body_above = math.min(c2.o, c2.c) >= level.price
                bool olp = older_than_c1 and not level.is_high and clC2OlpPoi and setup.is_bullish and c2.l < level.price and body_above
                bool ohp = older_than_c1 and level.is_high and clC2OhpPoi and not setup.is_bullish and c2.h > level.price and body_below
                if olp
                    poi_name := 'OLP'
                    poi_top := level.price
                    poi_bottom := level.price
                    poi_origin := level.origin_time
                    break
                if ohp
                    poi_name := 'OHP'
                    poi_top := level.price
                    poi_bottom := level.price
                    poi_origin := level.origin_time
                    break
        if poi_name == 'None' and clC2OclPoi and htfOclLevels.size() > 0
            for level_i = 0 to htfOclLevels.size() - 1
                HTFOCL level = htfOclLevels.get(level_i)
                bool still_valid = level.active and not OclBrokenBeforeC2(candleSet, level, c2)
                bool older_than_c1 = still_valid and level.origin_idx < setup.swept_candle_idx
                bool bullish_ocl = older_than_c1 and setup.is_bullish and c2.l <= level.price and c2_body_bot >= level.price
                bool bearish_ocl = older_than_c1 and not setup.is_bullish and c2.h >= level.price and c2_body_top <= level.price
                if bullish_ocl or bearish_ocl
                    poi_name := 'OCL'
                    poi_top := level.price
                    poi_bottom := level.price
                    poi_origin := level.origin_time
                    break
    if poi_name != 'None'
        [poi_touch_idx, poi_touch_time] = FirstC2PoiTouch(setup.htf_candle_idx, poi_top, poi_bottom)
        poi_touch := poi_touch_time
    [poi_name, poi_top, poi_bottom, poi_origin, poi_touch]

// Resolve the POI during the developing C2 candle as well as at C2 close.
// C2's running high/low retains every intrabar sweep, so a match remains
// available after the first touch instead of waiting for C3.
method RefreshLiveHtfPoi(CandleSet candleSet) =>
    if candleSet.has_live_bullish
        Setup live = candleSet.live_bullish
        if not live.is_post_c2
            [poi_kind, poi_top, poi_bottom, poi_origin, poi_touch] = ResolveHtfPoi(candleSet, live)
            live.htf_poi_kind := poi_kind
            live.htf_poi_top := poi_top
            live.htf_poi_bottom := poi_bottom
            live.htf_poi_origin_time := poi_origin
            live.htf_poi_touch_time := poi_touch
            candleSet.live_bullish := live
    if candleSet.has_live_bearish
        Setup live = candleSet.live_bearish
        if not live.is_post_c2
            [poi_kind, poi_top, poi_bottom, poi_origin, poi_touch] = ResolveHtfPoi(candleSet, live)
            live.htf_poi_kind := poi_kind
            live.htf_poi_top := poi_top
            live.htf_poi_bottom := poi_bottom
            live.htf_poi_origin_time := poi_origin
            live.htf_poi_touch_time := poi_touch
            candleSet.live_bearish := live
    candleSet

FvgPoiDiagnostic(CandleSet candleSet, Setup setup) =>
    string result = 'FVG check: no C2 candle cached'
    Candle c2 = Candle.new()
    bool has_c2 = false
    for candle in candleSet.candles
        if candle.o_idx == setup.htf_candle_idx
            c2 := candle
            has_c2 := true
            break
    if not has_c2 and not na(setup.c2_open_time)
        c2.o := setup.c2_open
        c2.c := setup.c2_close
        c2.h := setup.c2_high
        c2.l := setup.c2_low
        c2.o_time := setup.c2_open_time
        c2.o_idx := setup.htf_candle_idx
        has_c2 := true
    if has_c2
        int matching = 0
        int confirmed = 0
        int active = 0
        int touched = 0
        float nearest_top = na
        float nearest_bot = na
        int nearest_mit = na
        float nearest_distance = na
        for gap in fvgs
            bool correct_side = setup.is_bullish ? gap.is_bullish : not gap.is_bullish
            bool older = gap.left_time < c2.o_time
            bool known_before = not na(gap.known_time) and gap.known_time <= c2.o_time
            bool still_open = na(gap.mit_time) or gap.mit_time >= c2.o_time
            bool wick_touches = setup.is_bullish ? c2.l <= gap.top : c2.h >= gap.bot
            bool sweep_level_matches = setup.sweep_price >= gap.bot and setup.sweep_price <= gap.top
            if correct_side and older
                matching += 1
                float distance = setup.sweep_price < gap.bot ? gap.bot - setup.sweep_price : setup.sweep_price > gap.top ? setup.sweep_price - gap.top : 0.0
                if na(nearest_distance) or distance < nearest_distance
                    nearest_distance := distance
                    nearest_top := gap.top
                    nearest_bot := gap.bot
                    nearest_mit := gap.mit_time
                if known_before
                    confirmed += 1
                if known_before and still_open
                    active += 1
                if known_before and still_open and (wick_touches or sweep_level_matches)
                    touched += 1
        string nearest = not na(nearest_top) ? '\nNearest FVG: ' + str.tostring(nearest_bot, format.mintick) + '–' + str.tostring(nearest_top, format.mintick) + ' | mitigated: ' + (na(nearest_mit) ? 'no' : str.format_time(nearest_mit, 'HH:mm', 'America/New_York') + ' NY') : ''
        result := 'FVG check: matching ' + str.tostring(matching) + ' | known ' + str.tostring(confirmed) + ' | active ' + str.tostring(active) + ' | sweep/wick match ' + str.tostring(touched) + nearest
    result

C2Tooltip(Setup setup, CandleSet candleSet) =>
    string direction = setup.is_bullish ? 'Bullish' : 'Bearish'
    string phase = SetupPhase(setup, candleSet.settings.htf)
    string source_time = str.format_time(ChartBarTime(setup.htf_candle_idx), 'yyyy-MM-dd HH:mm', 'America/New_York')
    string c1_level = str.tostring(setup.sweep_price, format.mintick)
    string poi = setup.htf_poi_kind == 'Pending' ? 'Pending C2 close' : setup.htf_poi_kind
    string poi_touch = not na(setup.htf_poi_touch_time) ? str.format_time(setup.htf_poi_touch_time, 'HH:mm', 'America/New_York') + ' NY' : 'not available'
    string fvg_debug = setup.htf_poi_kind == 'None' ? '\n' + FvgPoiDiagnostic(candleSet, setup) : ''
    'CRT C2 setup' + '\nDirection: ' + direction + '\nHTF: ' + candleSet.settings.htf + '\nC2 open: ' + source_time + ' NY' + '\nC1 sweep: ' + c1_level + '\nHTF POI: ' + poi + '\nPOI touch: ' + poi_touch + fvg_debug + '\nC2 close: ' + (setup.is_post_c2 ? 'confirmed' : 'developing') + '\nCISD: ' + (setup.cisd_triggered ? 'confirmed' : 'waiting') + '\nPhase: ' + phase + '\nProtected swing: ' + (SetupHasProtectedSwing(setup) ? 'active' : 'none')

DrawUsedHtfPoi(DrawingBin bin, CandleSet candleSet, Setup setup) =>
    bool has_poi = crtShowUsedPoi and (setup.htf_poi_kind == 'FVG' or setup.htf_poi_kind == 'OB' or setup.htf_poi_kind == 'OHP' or setup.htf_poi_kind == 'OLP' or setup.htf_poi_kind == 'IFVG' or setup.htf_poi_kind == 'RB' or setup.htf_poi_kind == 'OCL') and not na(setup.htf_poi_top) and not na(setup.htf_poi_bottom)
    if has_poi
        int c2_start = ChartBarTime(setup.htf_candle_idx)
        int duration_ms = timeframe.in_seconds(candleSet.settings.htf) * 1000
        int poi_left = not na(setup.htf_poi_origin_time) ? setup.htf_poi_origin_time : c2_start
        // OHP/OLP are single liquidity prices. Once C2 used one, terminate
        // it at that exact LTF touch instead of leaving a chart-wide line.
        int poi_right = not na(setup.ez_c3_left_time) ? setup.ez_c3_left_time : c2_start + duration_ms
        if (setup.htf_poi_kind == 'OHP' or setup.htf_poi_kind == 'OLP' or setup.htf_poi_kind == 'OCL') and not na(setup.htf_poi_touch_time)
            poi_right := setup.htf_poi_touch_time + timeframe.in_seconds() * 1000
        color poi_color = setup.is_bullish ? crtBullPoiColor : crtBearPoiColor
        if poi_right > poi_left
            if setup.htf_poi_kind == 'FVG' or setup.htf_poi_kind == 'OB' or setup.htf_poi_kind == 'IFVG' or setup.htf_poi_kind == 'RB'
                bin.boxes.push(box.new(poi_left, setup.htf_poi_top, poi_right, setup.htf_poi_bottom, xloc = xloc.bar_time, bgcolor = color.new(poi_color, 88), border_color = color.new(poi_color, 35), border_width = 1))
            else
                bin.lines.push(line.new(poi_left, setup.htf_poi_top, poi_right, setup.htf_poi_top, xloc = xloc.bar_time, color = poi_color, width = 1, style = line.style_dotted))
            string poi_info = 'HTF ' + setup.htf_poi_kind + '\nUsed by CRT C2' + (not na(setup.htf_poi_touch_time) ? '\nLTF touch: ' + str.format_time(setup.htf_poi_touch_time, 'yyyy-MM-dd HH:mm', 'America/New_York') + ' NY' : '')
            bin.labels.push(label.new(poi_right, setup.htf_poi_top, 'HTF ' + setup.htf_poi_kind, xloc = xloc.bar_time, color = color_transparent, textcolor = poi_color, style = label.style_none, size = size.tiny, tooltip = poi_info))
    true

LiquidityLevelAlreadyUsed(CandleSet candleSet, HTFLiquidity level) =>
    bool used = false
    if candleSet.setups.size() > 0
        for completed in candleSet.setups
            bool same_level = (completed.htf_poi_kind == 'OHP' or completed.htf_poi_kind == 'OLP') and completed.htf_poi_origin_time == level.origin_time
            used := used or same_level
    if candleSet.has_live_bullish
        Setup live_bull = candleSet.live_bullish
        used := used or ((live_bull.htf_poi_kind == 'OHP' or live_bull.htf_poi_kind == 'OLP') and live_bull.htf_poi_origin_time == level.origin_time)
    if candleSet.has_live_bearish
        Setup live_bear = candleSet.live_bearish
        used := used or ((live_bear.htf_poi_kind == 'OHP' or live_bear.htf_poi_kind == 'OLP') and live_bear.htf_poi_origin_time == level.origin_time)
    used

// Potential old-low/high targets are kept separate from used POIs so the
// chart stays clean: an active level is shown once, and vanishes from this
// layer as soon as C2 consumes it.
method DrawActiveHtfLiquidityTargets(CandleSet candleSet) =>
    if crtShowLiquidityTargets and htfLiquidity.size() > 0
        int shown = 0
        for level in htfLiquidity
            if shown >= crtLiquidityTargetMax
                break
            if level.active and not LiquidityLevelAlreadyUsed(candleSet, level)
                color target_color = level.is_high ? crtBearPoiColor : crtBullPoiColor
                string target_name = level.is_high ? 'OHP target' : 'OLP target'
                if time_close > level.origin_time
                    bin.lines.push(line.new(level.origin_time, level.price, time_close, level.price, xloc = xloc.bar_time, color = color.new(target_color, 25), style = line.style_dotted, width = 1))
                    bin.labels.push(label.new(time_close, level.price, target_name, xloc = xloc.bar_time, color = color_transparent, textcolor = target_color, style = label.style_none, size = size.tiny))
                    shown := shown + 1
    true

// When the C3 hour of an existing setup also closes as a fresh, confirmed C2,
// the newer C2 owns the next phase. Keep the old C2/sweep for context, but do
// not let its C3/C4 package overlap and confuse the chart.
MarkSupersededSetups(CandleSet candleSet) =>
    int newer_start = na
    bool newer_confirmed = false
    if candleSet.has_live_bullish
        Setup newer_bull = candleSet.live_bullish
        newer_start := ChartBarTime(newer_bull.htf_candle_idx)
        newer_confirmed := newer_bull.is_confirmed
    if candleSet.has_live_bearish
        Setup newer_bear = candleSet.live_bearish
        int bear_start = ChartBarTime(newer_bear.htf_candle_idx)
        if na(newer_start) or (not na(bear_start) and bear_start > newer_start)
            newer_start := bear_start
            newer_confirmed := newer_bear.is_confirmed
    if newer_confirmed and not na(newer_start) and candleSet.setups.size() > 0
        for [old_i, old_setup] in candleSet.setups
            if old_setup.cisd_triggered and not old_setup.is_superseded and not na(old_setup.ez_c3_left_time) and old_setup.ez_c3_left_time == newer_start
                old_setup.is_superseded := true
                candleSet.setups.set(old_i, old_setup)
    // The collision can happen while the older setup is still live (for
    // example, a bearish C2 begins during a bullish setup's C3). Retire its
    // continuation layers immediately, but keep its C2/sweep context.
    if newer_confirmed and not na(newer_start)
        if candleSet.has_live_bullish
            Setup live_bull = candleSet.live_bullish
            if live_bull.is_post_c2 and not na(live_bull.ez_c3_left_time) and live_bull.ez_c3_left_time == newer_start
                live_bull.is_superseded := true
                candleSet.live_bullish := live_bull
        if candleSet.has_live_bearish
            Setup live_bear = candleSet.live_bearish
            if live_bear.is_post_c2 and not na(live_bear.ez_c3_left_time) and live_bear.ez_c3_left_time == newer_start
                live_bear.is_superseded := true
                candleSet.live_bearish := live_bear
    candleSet

ClearICPending(Setup setup) =>
    setup.ic_pending := false
    setup.ic_level := na
    setup.ic_start_idx := na
    setup.ic_extreme := na
    setup.ic_extreme_idx := na
    setup.ic_seen_same_side := false
    setup

StopICDetection(Setup setup) =>
    setup.ic_active := false
    ClearICPending(setup)
    setup

ResetICCisd(Setup setup) =>
    StopICDetection(setup)
    if not na(setup.ic_list)
        setup.ic_list.clear()
    else
        setup.ic_list := array.new<ICCisd>()
    // A new main-CISD attempt starts a totally fresh alert gate
    if not na(setup.ic_gate_fvgs)
        setup.ic_gate_fvgs.clear()
    if not na(setup.ic_gate_swings)
        setup.ic_gate_swings.clear()
    setup.ic_gate_scanned_idx := na
    setup.ic_gate_cycle_start_idx := na
    setup.ic_gate_last_tap_idx := na
    setup.ic_gate_eq_touch_idx := na
    setup

// Update running extreme for dot (every candle between start and confirm)
ICTrackExtreme(Setup setup) =>
    if setup.is_bullish
        if na(setup.ic_extreme) or low < setup.ic_extreme
            setup.ic_extreme := low
            setup.ic_extreme_idx := bar_index
    else
        if na(setup.ic_extreme) or high > setup.ic_extreme
            setup.ic_extreme := high
            setup.ic_extreme_idx := bar_index
    setup

// 3-candle swing: middle beyond both neighbors. Start may be middle; end (confirm) may be right.
// Returns [swing price, swing bar] or [na, na]. Bear = highest such high; bull = lowest such low.
ICFindSwing(Setup setup, int end_idx) =>
    float best_px = na
    int best_idx = na
    int start = setup.ic_start_idx
    if not na(start) and not na(end_idx) and end_idx > start
        for m = start to end_idx - 1
            if m < 1
                continue
            int off_m = bar_index - m
            int off_l = bar_index - (m - 1)
            int off_r = bar_index - (m + 1)
            if off_m < 0 or off_l < 0 or off_r < 0
                continue
            if setup.is_bullish
                if low[off_m] < low[off_l] and low[off_m] < low[off_r]
                    if na(best_px) or low[off_m] < best_px
                        best_px := low[off_m]
                        best_idx := m
            else
                if high[off_m] > high[off_l] and high[off_m] > high[off_r]
                    if na(best_px) or high[off_m] > best_px
                        best_px := high[off_m]
                        best_idx := m
    [best_px, best_idx]

// Wick beyond a stored IC swing: bear above the high, bull below the low
ICMarkTaken(Setup setup) =>
    if ICHardStop(setup)
        setup
    else if not na(setup.ic_list) and setup.ic_list.size() > 0
        for i = 0 to setup.ic_list.size() - 1
            ICCisd ic = setup.ic_list.get(i)
            if not ic.taken and not na(ic.extreme_price)
                if setup.is_bullish
                    if low < ic.extreme_price
                        ic.taken := true
                else
                    if high > ic.extreme_price
                        ic.taken := true
    setup

// ——— IC-CISD Alert Gate ———
// Independent of the drawing logic above. Collects candidate FVGs / swing points (same direction as the
// setup) starting on the C2 leg and continuing through C3/C4, and tracks Previous-EQ proximity. An IC-CISD's
// gated alert only fires once all enabled criteria have happened since the gate last reset.

// LTF FVG check: 3 bars ending `end_off` bars back (A = end_off+2, B = end_off+1, C = end_off)
CheckLTFFVG(bool want_bullish, int end_off) =>
    float a_h = high[end_off + 2]
    float a_l = low[end_off + 2]
    float c_h = high[end_off]
    float c_l = low[end_off]
    float top = na
    float bot = na
    bool found = false
    if want_bullish and a_h < c_l
        top := c_l
        bot := a_h
        found := true
    if not want_bullish and a_l > c_h
        top := a_l
        bot := c_h
        found := true
    [found, top, bot]

// LTF swing-high check (bearish gate candidate): middle bar (end_off+1) beyond both neighbors
CheckLTFSwingHigh(int end_off) =>
    float mid_h = high[end_off + 1]
    bool ph = mid_h > high[end_off + 2] and mid_h > high[end_off]
    [ph, mid_h]

// LTF swing-low check (bullish gate candidate)
CheckLTFSwingLow(int end_off) =>
    float mid_l = low[end_off + 1]
    bool pl = mid_l < low[end_off + 2] and mid_l < low[end_off]
    [pl, mid_l]

// Resets the IC-CISD alert gate for a fresh continuation cycle.
ICGateNewCycle(Setup setup) =>
    setup.ic_gate_cycle_start_idx := bar_index
    setup.ic_gate_last_tap_idx := na
    setup.ic_gate_eq_touch_idx := na
    setup

ICGateScanWindow(Setup setup, int end_off) =>
    if settings.ic_alert_crit_fvg
        [found, top, bot] = CheckLTFFVG(setup.is_bullish, end_off)
        if found
            if na(setup.ic_gate_fvgs)
                setup.ic_gate_fvgs := array.new<ICFVG>()
            setup.ic_gate_fvgs.push(ICFVG.new(top = top, bot = bot, tapped = false, known_idx = bar_index - end_off, origin_time = time[end_off + 1]))
    if settings.ic_alert_crit_sweep
        if setup.is_bullish
            [found, px] = CheckLTFSwingLow(end_off)
            if found
                if na(setup.ic_gate_swings)
                    setup.ic_gate_swings := array.new<ICSwingGate>()
                setup.ic_gate_swings.push(ICSwingGate.new(price = px, swept = false, known_idx = bar_index - end_off, origin_time = time[end_off + 1]))
        else
            [found, px] = CheckLTFSwingHigh(end_off)
            if found
                if na(setup.ic_gate_swings)
                    setup.ic_gate_swings := array.new<ICSwingGate>()
                setup.ic_gate_swings.push(ICSwingGate.new(price = px, swept = false, known_idx = bar_index - end_off, origin_time = time[end_off + 1]))
    setup

ICGateBackfill(Setup setup) =>
    if settings.ic_alert_show and (settings.ic_alert_crit_fvg or settings.ic_alert_crit_sweep) and not na(setup.cisd_start_idx)
        int span = bar_index - setup.cisd_start_idx
        if span >= 3
            int lim = math.min(span, 480)
            for off = 1 to lim - 2
                ICGateScanWindow(setup, off)
    setup.ic_gate_scanned_idx := bar_index
    setup

ICGateUpdate(Setup setup) =>
    if not settings.ic_alert_show or ICHardStop(setup) or na(setup.cisd_end_idx)
        setup
    else
        if (settings.ic_alert_crit_fvg or settings.ic_alert_crit_sweep) and barstate.isconfirmed and not na(setup.ic_gate_scanned_idx) and bar_index > setup.ic_gate_scanned_idx
            ICGateScanWindow(setup, 0)
            setup.ic_gate_scanned_idx := bar_index
        if settings.ic_alert_crit_fvg and not na(setup.ic_gate_fvgs) and setup.ic_gate_fvgs.size() > 0
            for z in setup.ic_gate_fvgs
                if not z.tapped
                    bool tap = setup.is_bullish ? low <= z.top : high >= z.bot
                    if tap
                        z.tapped := true
                        setup.ic_gate_last_tap_idx := bar_index
        if settings.ic_alert_crit_sweep and not na(setup.ic_gate_swings) and setup.ic_gate_swings.size() > 0
            for s in setup.ic_gate_swings
                if not s.swept
                    bool swept = setup.is_bullish ? low < s.price and close > s.price : high > s.price and close < s.price
                    if swept
                        s.swept := true
                        setup.ic_gate_last_tap_idx := bar_index
        if settings.ic_alert_crit_eq
            float eq_level = na
            float c2_range = na
            if not na(setup.c3_mid) and not na(setup.ez_c4_left_time) and time >= setup.ez_c4_left_time
                eq_level := setup.c3_mid
                c2_range := not na(setup.c3_extreme) ? math.abs(setup.c3_mid - setup.c3_extreme) * 2 : na
            else if not na(setup.c2_mid) and not na(setup.ez_c3_left_time) and time >= setup.ez_c3_left_time
                eq_level := setup.c2_mid
                c2_range := not na(setup.c2_extreme) ? math.abs(setup.c2_extreme - setup.c2_mid) * 2 : na
            if not na(eq_level) and not na(c2_range) and c2_range > 0
                float tol = c2_range * (settings.ic_alert_eq_tol_pct / 100.0)
                if high >= eq_level - tol and low <= eq_level + tol
                    setup.ic_gate_eq_touch_idx := bar_index
        setup

// True once every enabled criterion has happened since the gate last reset
ICGateSatisfied(Setup setup) =>
    bool tap_needed = settings.ic_alert_crit_fvg or settings.ic_alert_crit_sweep
    bool tap_ok = not tap_needed or (not na(setup.ic_gate_last_tap_idx) and not na(setup.ic_gate_cycle_start_idx) and setup.ic_gate_last_tap_idx >= setup.ic_gate_cycle_start_idx)
    bool eq_ok = not settings.ic_alert_crit_eq or (not na(setup.ic_gate_eq_touch_idx) and not na(setup.ic_gate_cycle_start_idx) and setup.ic_gate_eq_touch_idx >= setup.ic_gate_cycle_start_idx)
    tap_ok and eq_ok

ICUpdate(Setup setup) =>
    ICMarkTaken(setup)
    ICGateUpdate(setup)
    if not settings.ic_cisd_show
        setup
    else if not barstate.isconfirmed
        // Live bar color can flip; never arm or move the level until the candle is closed
        setup
    else if ICHardStop(setup)
        StopICDetection(setup)
        setup
    else if na(setup.cisd_end_idx)
        // Calculate from CISD body-break, even before sweep-back-in / show
        if not setup.is_invalid and (setup.ic_active or setup.ic_pending)
            ResetICCisd(setup)
        else
            StopICDetection(setup)
        setup
    else if bar_index <= setup.cisd_end_idx
        if setup.ic_active or setup.ic_pending
            ClearICPending(setup)
            setup.ic_active := false
        setup
    else
        if not setup.ic_active
            setup.ic_active := true
            if na(setup.ic_list)
                setup.ic_list := array.new<ICCisd>()
            ClearICPending(setup)

        // Strict color: doji is neither opposite nor same-side
        bool opp_bar = setup.is_bullish ? (close < open) : (close > open)

        if setup.ic_pending
            // Body break (start may be swing middle; right candle confirms next bar+)
            if bar_index > setup.ic_start_idx
                bool broke = setup.is_bullish ? (close > setup.ic_level) : (close < setup.ic_level)
                [sw_px, sw_idx] = ICFindSwing(setup, bar_index)
                if broke
                    if not na(sw_px) and not na(sw_idx)
                        ICCisd ic = ICCisd.new()
                        ic.level := setup.ic_level
                        ic.start_idx := setup.ic_start_idx
                        ic.end_idx := bar_index
                        ic.extreme_price := sw_px
                        ic.extreme_idx := sw_idx
                        ic.stage := setup.ic_current_stage
                        if na(setup.ic_list)
                            setup.ic_list := array.new<ICCisd>()
                        array.push(setup.ic_list, ic)
                        ClearICPending(setup)
                        bool bias_ok_ic = settings.bias == "Neutral" or (setup.is_bullish and settings.bias == "Bullish") or (not setup.is_bullish and settings.bias == "Bearish")
                        if settings.alerts_enabled and settings.ic_cisd_show and bias_ok_ic
                            alert(BuildAlertMessage(htf.settings.htf, setup.is_bullish, false, "IC-CISD"), alert.freq_once_per_bar)
                        // Gated IC-CISD alert: only fires once the enabled criteria were satisfied for this IC-CISD
                        if settings.alerts_enabled and settings.ic_alert_show and bias_ok_ic and ICGateSatisfied(setup)
                            alert(BuildAlertMessage(htf.settings.htf, setup.is_bullish, false, "IC-CISD (Confirmed Criteria)"), alert.freq_once_per_bar)
                        // Every confirmation starts a fresh gate cycle, whether or not the gated alert fired
                        ICGateNewCycle(setup)
                    else
                        // No swing yet. Keep only if this close-through made a new extreme (it may be the swing; next bar is the right).
                        bool new_ext = setup.is_bullish ? (low < setup.ic_extreme) : (high > setup.ic_extreme)
                        if new_ext
                            ICTrackExtreme(setup)
                        else
                            ClearICPending(setup)
                else
                    // Not broken yet. Distinguish candle types so the level always tracks the origin of the
                    // MOST RECENT contiguous opposite-colored run (mirrors FindCISDLevel's backward walk for
                    // the reversal CISD), instead of freezing on the very first opposite candle ever seen.
                    if opp_bar
                        if setup.ic_seen_same_side
                            // A same-side candle interrupted the prior opposing run without confirming it.
                            // This candle begins a fresh opposing run. It may form a lower protected high
                            // in a bearish setup or a higher protected low in a bullish setup.
                            setup.ic_level := open
                            setup.ic_start_idx := bar_index
                            setup.ic_extreme := setup.is_bullish ? low : high
                            setup.ic_extreme_idx := bar_index
                            setup.ic_seen_same_side := false
                        else
                            // Uninterrupted continuation of the same run — keep its original (oldest) anchor
                            ICTrackExtreme(setup)
                    else if open != close
                        // Genuine same-side candle (matches setup direction) that failed to break through.
                        // Marks the run as interrupted, but doesn't discard the level yet — it may still be
                        // broken by a later same-side candle. The next opposite candle, though, starts fresh.
                        setup.ic_seen_same_side := true
                        ICTrackExtreme(setup)
                    else
                        // Doji: transparent, same as the reversal CISD's own backward scan treats them
                        ICTrackExtreme(setup)
            else
                ICTrackExtreme(setup)
        else
            // Free: every new opposing run may form the next protected swing. It does not need to
            // exceed the previous confirmed IC extreme; lower highs and higher lows remain valid.
            if opp_bar
                setup.ic_pending := true
                setup.ic_level := open
                setup.ic_start_idx := bar_index
                setup.ic_extreme := setup.is_bullish ? low : high
                setup.ic_extreme_idx := bar_index
                setup.ic_seen_same_side := false
        setup

// ============================================================================
// Drawing Bin Methods
// ============================================================================
method clear(DrawingBin bin) =>
    for ln in bin.lines
        ln.delete()
    for bx in bin.boxes
        bx.delete()
    for lbl in bin.labels
        lbl.delete()
    bin.lines.clear()
    bin.boxes.clear()
    bin.labels.clear()

// ============================================================================
// Data Collection Methods (NO DRAWING)
// ============================================================================

// An OLP is support only until a later HTF body trades below it; an OHP is
// resistance only until a later HTF body trades above it. Wick probes alone
// do not retire a level, but a body-through does.
InvalidateBrokenHtfLiquidity(CandleSet candleSet) =>
    if candleSet.candles.size() > 0 and htfLiquidity.size() > 0
        Candle closed_candle = candleSet.candles.first()
        for level_i = 0 to htfLiquidity.size() - 1
            HTFLiquidity level = htfLiquidity.get(level_i)
            bool later_candle = closed_candle.o_idx > level.origin_idx
            float body_top = math.max(closed_candle.o, closed_candle.c)
            float body_bot = math.min(closed_candle.o, closed_candle.c)
            bool broken = level.is_high ? body_top > level.price : body_bot < level.price
            if level.active and later_candle and broken
                level.active := false
                htfLiquidity.set(level_i, level)
    candleSet

// An OCL is retired once a later confirmed HTF body trades through it. Unlike
// an OHP/OLP it has no permanent bullish/bearish side, so either direction of
// body-through invalidates it rather than letting an old level be reused.
InvalidateBrokenHtfOcl(CandleSet candleSet) =>
    if candleSet.candles.size() > 0 and htfOclLevels.size() > 0
        Candle closed_candle = candleSet.candles.first()
        for level_i = 0 to htfOclLevels.size() - 1
            HTFOCL level = htfOclLevels.get(level_i)
            bool later_candle = closed_candle.o_idx > level.origin_idx
            float body_top = math.max(closed_candle.o, closed_candle.c)
            float body_bot = math.min(closed_candle.o, closed_candle.c)
            bool body_through = body_bot < level.price and body_top > level.price
            if level.active and later_candle and body_through
                level.active := false
                htfOclLevels.set(level_i, level)
    candleSet

StampC1Range(Setup setup, Candle c1) =>
    setup.c1_high := c1.h
    setup.c1_low := c1.l
    setup.c1_high_idx := c1.h_idx
    setup.c1_low_idx := c1.l_idx
    setup

// C1 H/L are targets only once C3 is genuinely active. A line stops at the
// first later LTF candle which takes that side; a newer C2 supersedes C3.
UpdateC1RangeTaken(Setup setup) =>
    if setup.cisd_triggered and not setup.is_superseded and not na(setup.ez_c3_left_time) and time >= setup.ez_c3_left_time
        if na(setup.c1_high_taken_time) and high >= setup.c1_high
            setup.c1_high_taken_time := time
        if na(setup.c1_low_taken_time) and low <= setup.c1_low
            setup.c1_low_taken_time := time
    setup

// A C2 can have multiple entry-model candidates, but by default only one
// CONFIRMED entry is retained. A fresh C2 manipulation extreme restarts
// the search, so early entries are not treated as valid after new liquidity
// is taken. Does not change C1 sweeps, C2 confirmation, CISD or POI logic.
CrtHasConfirmedEntry(Setup setup) =>
    bool confirmed = setup.m2_entry_triggered or setup.m1_entry_triggered
    if not confirmed and not na(setup.m1_signals) and setup.m1_signals.size() > 0
        for signal in setup.m1_signals
            if signal.entry_triggered
                confirmed := true
                break
    confirmed

ResetC2EntryCandidates(Setup setup) =>
    if crtSingleEntryC2
        if not na(setup.m1_signals)
            setup.m1_signals.clear()
        setup.m1_tbs_confirmed := false
        setup.m1_tbs_idx := na
        setup.m1_tbs_level := na
        setup.m1_pattern_count := na
        setup.m1_structure_start_idx := na
        setup.m1_level := na
        setup.m1_idx := na
        setup.m1_sl := na
        setup.m1_entry_triggered := false
        setup.m1_entry_idx := na
        setup.m2_fvg_found := false
        setup.m2_fvg_idx := na
        setup.m2_fvg_top := na
        setup.m2_fvg_bottom := na
        setup.m2_tapped := false
        setup.m2_tap_idx := na
        setup.m2_entry_triggered := false
        setup.m2_entry_idx := na
        setup.m2_sl := na
    setup

// Model #1 is an LTF-only entry model.  Its 2–6 "inside" candles are a
// local structure, not a count from the HTF/C2 open: they may exist before
// the CRT sweep.  We use the oldest candle's full range as the container and
// require each later candidate body's open and close to remain inside it.
// A TBS is then a directional BODY close through the cluster's body edge,
// after the CRT sweep.  The TBS candle supplies the M1 trigger (its low for
// shorts / high for longs); a later body close through that trigger is entry.
UpdateTbsModel1(Setup setup) =>
    int bars_after_sweep = na(setup.sweep_bar_idx) ? -1 : bar_index - setup.sweep_bar_idx
    // Entry models belong exclusively to the C2 candle that swept C1.  C3,
    // C4, and any later C2 must never inherit an unfinished entry pattern.
    bool in_c2_window = not setup.is_post_c2 and not na(setup.htf_candle_idx) and not na(htf.ref_c2_open_idx) and setup.htf_candle_idx == htf.ref_c2_open_idx
    if (crtM1Enabled or crtM2Enabled) and barstate.isconfirmed and setup.is_confirmed and in_c2_window and not setup.is_superseded and not setup.is_invalid and bars_after_sweep >= 0 and bars_after_sweep <= crtEntryMaxBars
        if na(setup.m1_signals)
            setup.m1_signals := array.new<M1Signal>()

        // Existing signals get their own later body-close entry.  Do this
        // before looking for a fresh TBS so multiple valid TBS structures in
        // the same C2 can coexist rather than replacing one another.
        if crtM1Enabled and setup.m1_signals.size() > 0
            // If several pending TBS patterns qualify on the same bar,
            // use the most recent local structure instead of older signals.
            int most_recent_eligible = na
            if crtSingleEntryC2 and not CrtHasConfirmedEntry(setup)
                for offset = 0 to setup.m1_signals.size() - 1
                    int candidate_i = setup.m1_signals.size() - 1 - offset
                    M1Signal candidate = setup.m1_signals.get(candidate_i)
                    bool short_ok = not setup.is_bullish and close < open and close < candidate.level
                    bool long_ok = setup.is_bullish and close > open and close > candidate.level
                    if not candidate.entry_triggered and bar_index > candidate.tbs_idx and (short_ok or long_ok)
                        most_recent_eligible := candidate_i
                        break
            for signal_i = 0 to setup.m1_signals.size() - 1
                M1Signal signal = setup.m1_signals.get(signal_i)
                if not signal.entry_triggered and bar_index > signal.tbs_idx and (not crtSingleEntryC2 or (not CrtHasConfirmedEntry(setup) and signal_i == most_recent_eligible))
                    bool short_entry = not setup.is_bullish and close < open and close < signal.level
                    bool long_entry = setup.is_bullish and close > open and close > signal.level
                    if short_entry or long_entry
                        signal.entry_triggered := true
                        signal.entry_idx := bar_index
                        setup.m1_signals.set(signal_i, signal)
                        setup.m1_entry_triggered := true
                        setup.m1_entry_idx := bar_index

        bool found = false
        float best_tbs_level = na
        int best_count = na
        int best_structure_start = na
        // A CRT TBS is not simply any local break.  Following a high sweep,
        // the TBS must body-close back below CRT H; following a low sweep it
        // must body-close back above CRT L.
        float crt_return_level = setup.is_bullish ? setup.c1_low : setup.c1_high
        bool returned_through_crt = not na(crt_return_level) and (setup.is_bullish ? close > crt_return_level : close < crt_return_level)
        // Continue looking for a valid new local structure until the first
        // ENTRY confirms. A pending TBS is not a completed trade and must
        // not permanently block a later, better TBS inside the same C2.
        bool search_tbs = not crtSingleEntryC2 or not CrtHasConfirmedEntry(setup)
        if returned_through_crt and search_tbs
            if crtM1RequireInside
                int best_distance = 100000
                // Search nearby local structures, including the last 2–6
                // candles before the CRT sweep. The TBS itself must be in C2.
                for gap = 1 to crtM1StructureSearch
                    for count = 2 to 6
                        int oldest = gap + count - 1
                        int newest_bar = bar_index - gap
                        if bar_index >= oldest and not na(high[oldest])
                            float container_high = high[oldest]
                            float container_low = low[oldest]
                            float cluster_body_high = math.max(open[oldest], close[oldest])
                            float cluster_body_low = math.min(open[oldest], close[oldest])
                            bool contained = container_high > container_low
                            for back = gap to gap + count - 2
                                float body_high = math.max(open[back], close[back])
                                float body_low = math.min(open[back], close[back])
                                contained := contained and body_high <= container_high and body_low >= container_low
                                cluster_body_high := math.max(cluster_body_high, body_high)
                                cluster_body_low := math.min(cluster_body_low, body_low)
                            bool bear_tbs = not setup.is_bullish and close < open and close < cluster_body_low
                            bool bull_tbs = setup.is_bullish and close > open and close > cluster_body_high
                            int distance_from_sweep = math.abs(newest_bar - setup.sweep_bar_idx)
                            bool fresh_structure = setup.m1_signals.size() == 0 or bar_index - oldest > setup.m1_signals.last().tbs_idx
                            if contained and fresh_structure and (bear_tbs or bull_tbs) and distance_from_sweep < best_distance
                                found := true
                                best_distance := distance_from_sweep
                                best_tbs_level := setup.is_bullish ? cluster_body_high : cluster_body_low
                                best_count := count
                                best_structure_start := bar_index - oldest
            else if bar_index >= 1
                float prior_body_high = math.max(open[1], close[1])
                float prior_body_low = math.min(open[1], close[1])
                bool bear_tbs = not setup.is_bullish and close < open and close < prior_body_low
                bool bull_tbs = setup.is_bullish and close > open and close > prior_body_high
                if bear_tbs or bull_tbs
                    found := true
                    best_tbs_level := setup.is_bullish ? prior_body_high : prior_body_low
                    best_count := 1
                    best_structure_start := bar_index - 1

        // A second model requires a genuinely fresh inside structure after
        // the preceding TBS. Rebreaking the same old cluster is not a new model.
        bool already_recorded = false
        if found and setup.m1_signals.size() > 0
            M1Signal previous_signal = setup.m1_signals.last()
            int structure_end_idx = bar_index - 1
            already_recorded := previous_signal.tbs_idx == bar_index or best_structure_start <= previous_signal.tbs_idx or structure_end_idx <= previous_signal.tbs_idx
        if found and not already_recorded
            float stop_extreme = setup.is_bullish ? low : high
            for back = 0 to bars_after_sweep
                stop_extreme := setup.is_bullish ? math.min(stop_extreme, low[back]) : math.max(stop_extreme, high[back])
            M1Signal fresh_signal = M1Signal.new(bar_index, best_tbs_level, best_count, best_structure_start, setup.is_bullish ? high : low, stop_extreme)
            setup.m1_signals.push(fresh_signal)
            // Preserve the most recent TBS for Model #2's required sequence.
            setup.m1_tbs_confirmed := true
            setup.m1_tbs_idx := bar_index
            setup.m1_tbs_level := best_tbs_level
            setup.m1_pattern_count := best_count
            setup.m1_structure_start_idx := best_structure_start
            setup.m1_level := fresh_signal.level
            setup.m1_idx := bar_index
            setup.m1_sl := stop_extreme
    setup

// Model #2: after a CRT sweep, wait for a direction-matching LTF FVG, then
// for price to tap that specific FVG and body-close back out of it. The FVG's
// creation candle is never treated as its own retest.
UpdateFvgModel2(Setup setup) =>
    int bars_after_sweep = na(setup.sweep_bar_idx) ? -1 : bar_index - setup.sweep_bar_idx
    if crtM2Enabled and barstate.isconfirmed and setup.is_confirmed and not setup.is_post_c2 and setup.htf_candle_idx == htf.ref_c2_open_idx and not setup.is_superseded and not setup.is_invalid and bars_after_sweep >= 0 and bars_after_sweep <= crtEntryMaxBars and (not crtSingleEntryC2 or not CrtHasConfirmedEntry(setup))
        // Model #2 starts only after the C2 has body-closed back through the
        // swept CRT H/L (the same shared TBS gate as Model #1).
        bool tbs_ready = setup.m1_tbs_confirmed and not na(setup.m1_tbs_idx) and bar_index > setup.m1_tbs_idx
        if tbs_ready and not setup.m2_fvg_found and bar_index >= 2
            bool bear_fvg = not setup.is_bullish and low[2] > high
            bool bull_fvg = setup.is_bullish and high[2] < low
            if bear_fvg or bull_fvg
                setup.m2_fvg_found := true
                setup.m2_fvg_idx := bar_index
                setup.m2_fvg_top := setup.is_bullish ? low : low[2]
                setup.m2_fvg_bottom := setup.is_bullish ? high[2] : high
        else if setup.m2_fvg_found and not setup.m2_entry_triggered and bar_index > setup.m2_fvg_idx
            bool touches_fvg = high >= setup.m2_fvg_bottom and low <= setup.m2_fvg_top
            if touches_fvg
                setup.m2_tapped := true
                setup.m2_tap_idx := bar_index
            bool bearish_rejection = not setup.is_bullish and setup.m2_tapped and close < open and close < setup.m2_fvg_bottom
            bool bullish_rejection = setup.is_bullish and setup.m2_tapped and close > open and close > setup.m2_fvg_top
            if bearish_rejection or bullish_rejection
                setup.m2_entry_triggered := true
                setup.m2_entry_idx := bar_index
                float stop_extreme = setup.is_bullish ? low : high
                for back = 0 to bars_after_sweep
                    stop_extreme := setup.is_bullish ? math.min(stop_extreme, low[back]) : math.max(stop_extreme, high[back])
                setup.m2_sl := stop_extreme
    setup

BlockAlreadyKnown(array<BlockZone> zones, string kind, int origin_idx, bool is_bullish) =>
    bool known = false
    if zones.size() > 0
        for zone in zones
            known := known or (zone.kind == kind and zone.origin_idx == origin_idx and zone.is_bullish == is_bullish)
    known

AddBlockZone(array<BlockZone> zones, string kind, bool is_bullish, float top, float bot, Candle origin, Candle confirmation) =>
    if not BlockAlreadyKnown(zones, kind, origin.o_idx, is_bullish)
        zones.unshift(BlockZone.new(kind = kind, is_bullish = is_bullish, top = top, bot = bot, origin_time = origin.o_time, origin_idx = origin.o_idx, confirm_time = confirmation.c_time, confirm_idx = confirmation.o_idx))
    while zones.size() > blockMaxZones
        zones.pop()
    true

// RB confirmation uses one closed candle either side of the origin.  The
// newer candle confirms the swing; no RB can be signalled on its origin bar.
DetectConfirmedRejectionBlocks(CandleSet candleSet) =>
    if candleSet.candles.size() > 3
        Candle pivot = candleSet.candles.get(2)
        Candle newer = candleSet.candles.get(1)
        Candle older = candleSet.candles.get(3)
        float pivot_range = pivot.h - pivot.l
        float newer_range = newer.h - newer.l
        float pivot_body_top = math.max(pivot.o, pivot.c)
        float pivot_body_bot = math.min(pivot.o, pivot.c)
        float upper_wick_ratio = pivot_range > 0 ? (pivot.h - pivot_body_top) / pivot_range : 0.0
        float lower_wick_ratio = pivot_range > 0 ? (pivot_body_bot - pivot.l) / pivot_range : 0.0
        float newer_body_ratio = newer_range > 0 ? math.abs(newer.c - newer.o) / newer_range : 0.0
        bool bear_swing = pivot.h > older.h and pivot.h > newer.h
        bool bull_swing = pivot.l < older.l and pivot.l < newer.l
        bool bear_away = newer.c < newer.o and newer_body_ratio >= blockMinDisplacement
        bool bull_away = newer.c > newer.o and newer_body_ratio >= blockMinDisplacement
        if bear_swing and upper_wick_ratio >= rbMinWickRatio and (not rbNeedDisplacement or bear_away)
            AddBlockZone(rbZones, 'RB', false, pivot.h, pivot_body_top, pivot, newer)
        if bull_swing and lower_wick_ratio >= rbMinWickRatio and (not rbNeedDisplacement or bull_away)
            AddBlockZone(rbZones, 'RB', true, pivot_body_bot, pivot.l, pivot, newer)
    true

// OB confirmation waits for an impulse plus its following closed candle. The
// origin is the most recent opposite-close candle inside the bounded search.
DetectConfirmedOrderBlocks(CandleSet candleSet) =>
    if candleSet.candles.size() > 3
        Candle impulse = candleSet.candles.get(2)
        Candle confirmation = candleSet.candles.get(1)
        float impulse_range = impulse.h - impulse.l
        float impulse_body_ratio = impulse_range > 0 ? math.abs(impulse.c - impulse.o) / impulse_range : 0.0
        bool bull_impulse = impulse.c > impulse.o and impulse_body_ratio >= blockMinDisplacement
        bool bear_impulse = impulse.c < impulse.o and impulse_body_ratio >= blockMinDisplacement
        bool bull_fvg = candleSet.candles.get(3).h < confirmation.l
        bool bear_fvg = candleSet.candles.get(3).l > confirmation.h
        float prior_high = na
        float prior_low = na
        int limit = math.min(candleSet.candles.size() - 1, obSearchBars + 2)
        if limit >= 3
            for i = 3 to limit
                Candle prior = candleSet.candles.get(i)
                prior_high := na(prior_high) ? prior.h : math.max(prior_high, prior.h)
                prior_low := na(prior_low) ? prior.l : math.min(prior_low, prior.l)
        bool bull_break = not obNeedSwingBreak or (not na(prior_high) and impulse.c > prior_high)
        bool bear_break = not obNeedSwingBreak or (not na(prior_low) and impulse.c < prior_low)
        if bull_impulse and bull_break and (not obNeedFvg or bull_fvg)
            for i = 3 to limit
                Candle origin = candleSet.candles.get(i)
                if origin.c < origin.o
                    float top = obBoundaryMode == 'Full candle' ? origin.h : math.max(origin.o, origin.c)
                    float bot = obBoundaryMode == 'Full candle' ? origin.l : math.min(origin.o, origin.c)
                    AddBlockZone(obZones, 'OB', true, top, bot, origin, confirmation)
                    break
        if bear_impulse and bear_break and (not obNeedFvg or bear_fvg)
            for i = 3 to limit
                Candle origin = candleSet.candles.get(i)
                if origin.c > origin.o
                    float top = obBoundaryMode == 'Full candle' ? origin.h : math.max(origin.o, origin.c)
                    float bot = obBoundaryMode == 'Full candle' ? origin.l : math.min(origin.o, origin.c)
                    AddBlockZone(obZones, 'OB', false, top, bot, origin, confirmation)
                    break
    true

// Touch, mitigation and invalidation are separate states. Origin and
// confirmation candles are deliberately excluded from later-retest logic.
UpdateBlockLifecycle(CandleSet candleSet, array<BlockZone> zones) =>
    if candleSet.candles.size() > 0 and zones.size() > 0
        Candle closed_candle = candleSet.candles.first()
        for i = 0 to zones.size() - 1
            BlockZone zone = zones.get(i)
            if closed_candle.o_idx > zone.confirm_idx and na(zone.invalidation_time)
                bool touched = closed_candle.l <= zone.top and closed_candle.h >= zone.bot
                if touched and na(zone.first_touch_time)
                    zone.first_touch_time := closed_candle.o_time
                // Mitigation is a confirmed body close into the zone, not a
                // wick-only first touch.
                bool body_inside = closed_candle.c <= zone.top and closed_candle.c >= zone.bot
                if body_inside and na(zone.mitigation_time)
                    zone.mitigation_time := closed_candle.o_time
                bool invalidated = zone.is_bullish ? (blockInvalidation == 'Wick' ? closed_candle.l < zone.bot : closed_candle.c < zone.bot) : (blockInvalidation == 'Wick' ? closed_candle.h > zone.top : closed_candle.c > zone.top)
                if invalidated
                    zone.invalidation_time := closed_candle.o_time
                zones.set(i, zone)
    true

BlockAssociatedWithC2C3(CandleSet candleSet, BlockZone zone) =>
    bool associated = false
    if not na(zone.first_touch_time) and candleSet.setups.size() > 0
        for setup in candleSet.setups
            int c2_start = ChartBarTime(setup.htf_candle_idx)
            int c4_end = not na(setup.c4_end_time) ? setup.c4_end_time : c2_start + timeframe.in_seconds(candleSet.settings.htf) * 3 * 1000
            associated := associated or (zone.first_touch_time >= c2_start and zone.first_touch_time <= c4_end)
    associated

DrawBlockCollection(CandleSet candleSet, array<BlockZone> zones) =>
    if blocksShow and zones.size() > 0
        for zone in zones
            bool enabled = zone.kind == 'RB' ? (zone.is_bullish ? rbBullShow : rbBearShow) : (zone.is_bullish ? obBullShow : obBearShow)
            bool removed = not na(zone.invalidation_time) or (blockAfterTouch == 'Remove' and not na(zone.mitigation_time))
            bool associated = not blockOnlyC2C3 or BlockAssociatedWithC2C3(candleSet, zone)
            if enabled and not removed and associated
                color base = zone.kind == 'RB' ? (zone.is_bullish ? bullRbColor : bearRbColor) : (zone.is_bullish ? bullObColor : bearObColor)
                bool faded = not na(zone.mitigation_time) and blockAfterTouch == 'Fade'
                int right_time = not na(zone.invalidation_time) ? zone.invalidation_time : time_close
                int opacity = faded ? (blockOpacity + 8 > 97 ? 97 : blockOpacity + 8) : blockOpacity
                if right_time > zone.origin_time
                    bin.boxes.push(box.new(zone.origin_time, zone.top, right_time, zone.bot, xloc = xloc.bar_time, bgcolor = color.new(base, opacity), border_color = color.new(base, faded ? 70 : 25), border_width = 1))
                    string name = (zone.is_bullish ? 'Bull ' : 'Bear ') + zone.kind
                    string tip = name + '\nOrigin: ' + str.format_time(zone.origin_time, 'yyyy-MM-dd HH:mm', 'America/New_York') + ' NY' + '\nConfirmed: ' + str.format_time(zone.confirm_time, 'yyyy-MM-dd HH:mm', 'America/New_York') + ' NY' + '\nFirst touch: ' + (na(zone.first_touch_time) ? 'none' : str.format_time(zone.first_touch_time, 'yyyy-MM-dd HH:mm', 'America/New_York')) + '\nMitigation: ' + (na(zone.mitigation_time) ? 'none' : str.format_time(zone.mitigation_time, 'yyyy-MM-dd HH:mm', 'America/New_York'))
                    bin.labels.push(label.new(right_time, zone.top, name, xloc = xloc.bar_time, color = color_transparent, textcolor = base, style = label.style_none, size = size.tiny, tooltip = tip))
    true

method DrawBlockZones(CandleSet candleSet) =>
    DrawBlockCollection(candleSet, rbZones)
    DrawBlockCollection(candleSet, obZones)
    true

method Monitor(CandleSet candleSet, bool isNewHTFCandleArg) =>
    // isNewHTFCandle is now passed in from main execution to avoid global var modification in function
    isNewHTFCandle = isNewHTFCandleArg

    // Early cleanup: When new HTF candle starts, clear unconfirmed setups from previous candle
    // This allows new sweeps to be detected on the first bar
    if isNewHTFCandle
        InvalidateBrokenHtfLiquidity(candleSet)
        InvalidateBrokenHtfOcl(candleSet)
        UpdateBlockLifecycle(candleSet, rbZones)
        UpdateBlockLifecycle(candleSet, obZones)
        // Clear stale bearish setup if not confirmed
        if candleSet.has_live_bearish
            Setup setup = candleSet.live_bearish
            // If setup is in C2 phase (not post-C2) and wasn't created on this bar
            if setup.sweep_bar_idx != bar_index and not setup.is_post_c2
                // Check if C2 close confirmed the sweep using previous bar's close
                bool c2_confirmed = close[1] < setup.sweep_price
                if not c2_confirmed
                    candleSet.has_live_bearish := false
        // Clear stale bullish setup if not confirmed
        if candleSet.has_live_bullish
            Setup setup = candleSet.live_bullish
            if setup.sweep_bar_idx != bar_index and not setup.is_post_c2
                bool c2_confirmed = close[1] > setup.sweep_price
                if not c2_confirmed
                    candleSet.has_live_bullish := false

    // Snapshot the *completed* C1 BEFORE the current C2 is unshifted below.
    // This reference stays fixed throughout the full C2 hour, including its
    // first 1m bar, all subsequent bars, and replay/historical calculations.
    if isNewHTFCandle
        // Copy the completed candle rather than aliasing the projection cache.
        // Validate its actual 1H OHLC against the TradingView hourly feed;
        // this catches a 1m cache rollover/session alignment mismatch.
        Candle closed_c1 = candleSet.candles.size() > 0 ? candleSet.candles.first().copy() : na
        if crtUseHourlyLtfReference and not na(crt1hPrevHigh) and not na(crt1hPrevLow) and not na(closed_c1)
            closed_c1.h := crt1hPrevHigh
            closed_c1.l := crt1hPrevLow
            // On the same instrument the 1h feed remains authoritative for
            // sweep price, while stored LTF indices locate the actual wicks.
        candleSet.ref_c1 := closed_c1
        candleSet.ref_c2_open_idx := bar_index

    // Live sweep detection always runs. Its source cannot accidentally drift
    // to C2 itself or an older HTF candle as the projection array changes.
    if not na(candleSet.ref_c1) and not na(candleSet.ref_c2_open_idx)
        Candle prev_htf = candleSet.ref_c1
        bool high_breached = high > prev_htf.h
        bool low_breached = low < prev_htf.l
        bool high_sweep_confirmed = high_breached and close < prev_htf.h
        bool low_sweep_confirmed = low_breached and close > prev_htf.l

        // ===== C4/C5 ENTRY ZONE INVALIDATION + IC-CISD FOR CONFIRMED SETUPS =====
        for [i, setup] in candleSet.setups
            UpdateC1RangeTaken(setup)
            UpdateTbsModel1(setup)
            UpdateFvgModel2(setup)
            ICMarkTaken(setup)
            // Keep checking/updating as long as setup is still within the C4-or-C5 window
            if setup.cisd_triggered and not na(setup.c5_end_time) and time < setup.c5_end_time
                if setup.is_bullish
                    // C4 invalidation (C4 window only): beyond C3 low — stop EQ + drop zone
                    if not setup.ez_c4_invalid and not na(setup.c3_extreme) and not na(setup.ez_c4_left_time) and not na(setup.ez_c4_right_time) and time < setup.ez_c4_right_time and low < setup.c3_extreme
                        setup.ez_c4_invalid := true
                        setup.ez_c4_invalid_time := time_close
                else
                    // C4 invalidation (C4 window only): beyond C3 high — stop EQ + drop zone
                    if not setup.ez_c4_invalid and not na(setup.c3_extreme) and not na(setup.ez_c4_left_time) and not na(setup.ez_c4_right_time) and time < setup.ez_c4_right_time and high > setup.c3_extreme
                        setup.ez_c4_invalid := true
                        setup.ez_c4_invalid_time := time_close
                // Tag which continuation candle is forming right now, so new IC-CISD confirmations
                // know whether they belong to C4 or C5 (used by the per-stage show/hide toggles)
                setup.ic_current_stage := (not na(setup.ez_c4_right_time) and time < setup.ez_c4_right_time) ? 4 : 5
                ICUpdate(setup)
        // ===== BEARISH TRACKING (when high is wicked) =====
        if not candleSet.has_live_bearish
            // Start tracking when high is breached (wick)
            if high_breached
                Setup setup = Setup.new()
                setup.is_bullish := false
                setup.is_confirmed := false
                setup.sweep_price := prev_htf.h
                setup.sweep_ltf_idx := prev_htf.h_idx
                setup.sweep_bar_idx := bar_index
                setup.swept_candle_idx := prev_htf.o_idx
                setup := StampC1Range(setup, prev_htf)
                setup.htf_candle_idx := candleSet.ref_c2_open_idx
                setup.ltf_end_idx := bar_index + 50
                setup.c2_x := bar_index
                setup.c2_y := high
                setup.htf_count := 1
                // Initialize CISD tracking - use highest high so far
                if isNewHTFCandle
                    setup.tracked_extreme := high
                    setup.extreme_bar_idx := bar_index
                else
                    if high > candleSet.candles.first().h
                        setup.tracked_extreme := high
                        setup.extreme_bar_idx := bar_index
                    else
                        setup.tracked_extreme := candleSet.candles.first().h
                        setup.extreme_bar_idx := candleSet.candles.first().h_idx
                // Find CISD from the extreme bar (bias = 1 for bullish candles)
                [cisd_price, cisd_idx] = FindCISDLevel(setup.extreme_bar_idx, 1)
                if not na(cisd_price)
                    setup.cisd_level := cisd_price
                    setup.cisd_start_idx := cisd_idx
                    setup.has_cisd := true
                // Check if sweep is already confirmed on this bar
                if high_sweep_confirmed
                    setup.is_confirmed := true
                candleSet.live_bearish := setup
                candleSet.has_live_bearish := true
        else
            // Bearish tracking exists - update extreme and check CISD
            setup = candleSet.live_bearish
            
            if not setup.is_post_c2
                // C2 phase: dynamic sweep confirmation
                setup.is_confirmed := close < setup.sweep_price
                // Update extreme if new high made
                if high > setup.tracked_extreme
                    ResetC2EntryCandidates(setup)
                    setup.tracked_extreme := high
                    setup.extreme_bar_idx := bar_index
                    setup.c2_x := bar_index
                    setup.c2_y := high
                    // Recalculate CISD from new extreme
                    [new_cisd_price, new_cisd_idx] = FindCISDLevel(bar_index, 1)
                    if not na(new_cisd_price)
                        setup.cisd_level := new_cisd_price
                        setup.cisd_start_idx := new_cisd_idx
                        setup.has_cisd := true
                        setup.cisd_triggered := false  // Reset trigger on new extreme
                        setup.cisd_end_idx := na
                        ResetICCisd(setup)  // IC must wait for new main CISD confirm
                
                // Body break = CISD line end. Show / IC / alerts wait until sweep is also back in.
                if setup.has_cisd and na(setup.cisd_end_idx) and close < setup.cisd_level
                    setup.cisd_end_idx := bar_index
                if setup.is_confirmed and setup.has_cisd and not setup.cisd_triggered and not na(setup.cisd_end_idx)
                    setup.cisd_triggered := true
                    ICGateNewCycle(setup)
                    ICGateBackfill(setup)
                    // Live/Potential alert for bearish CISD trigger
                    if settings.live_alerts_enabled and (settings.bias == "Neutral" or settings.bias == "Bearish")
                        alert(BuildAlertMessage(candleSet.settings.htf, false, true, "Candle 2"), alert.freq_once_per_bar)
                
                setup.ic_current_stage := 3
                ICUpdate(setup)
            else
                // Post-C2 phase: check for invalidation, cancellation, or CISD trigger
                bool setup_replaced = false
                
                if high > setup.c2_extreme
                    if setup.cisd_triggered
                        // CISD already triggered - this is an INVALIDATION
                        // Push invalidated setup to history (will show as xC2)
                        setup.is_invalid := true
                        StopICDetection(setup)  // keep confirmed IC marks with this setup
                        candleSet.setups.unshift(setup)
                        // Also create a new concurrent setup (same as cascade)
                        int old_c2_index = FindCandleIndex(candleSet.candles, setup.htf_candle_idx)
                        Candle old_c2 = candleSet.candles.get(old_c2_index >= 0 ? old_c2_index : 0)
                        Setup new_setup = Setup.new()
                        new_setup.is_bullish := false
                        new_setup.is_confirmed := false
                        new_setup.is_post_c2 := false  // New setup is in C2 phase
                        new_setup.sweep_price := setup.c2_extreme  // Sweep old C2's high
                        new_setup.sweep_ltf_idx := old_c2.h_idx    // Where old C2's high occurred
                        new_setup.sweep_bar_idx := bar_index
                        new_setup.swept_candle_idx := setup.htf_candle_idx  // Old C2 becomes C1 to sweep
                        new_setup := StampC1Range(new_setup, old_c2)
                        new_setup.htf_candle_idx := candleSet.ref_c2_open_idx  // Current becomes C2
                        new_setup.ltf_end_idx := bar_index + 50
                        new_setup.c2_x := bar_index
                        new_setup.c2_y := high
                        new_setup.htf_count := 1
                        new_setup.tracked_extreme := high
                        new_setup.extreme_bar_idx := bar_index
                        // Find CISD from the extreme bar
                        [cisd_price_inv, cisd_idx_inv] = FindCISDLevel(bar_index, 1)
                        if not na(cisd_price_inv)
                            new_setup.cisd_level := cisd_price_inv
                            new_setup.cisd_start_idx := cisd_idx_inv
                            new_setup.has_cisd := true
                        // Check if sweep is already confirmed on this bar
                        if close < new_setup.sweep_price
                            new_setup.is_confirmed := true
                        // Replace live setup with new one
                        candleSet.live_bearish := new_setup
                        setup_replaced := true
                    else
                        // CISD not triggered - cancel and IMMEDIATELY start new setup
                        // Old C2 becomes new C1, current bar (C3) becomes new C2
                        int old_c2_index = FindCandleIndex(candleSet.candles, setup.htf_candle_idx)
                        Candle old_c2 = candleSet.candles.get(old_c2_index >= 0 ? old_c2_index : 0)
                        Setup new_setup = Setup.new()
                        new_setup.is_bullish := false
                        new_setup.is_confirmed := false
                        new_setup.is_post_c2 := false  // New setup is in C2 phase
                        new_setup.sweep_price := setup.c2_extreme  // Sweep old C2's high
                        new_setup.sweep_ltf_idx := old_c2.h_idx    // Where old C2's high occurred
                        new_setup.sweep_bar_idx := bar_index
                        new_setup.swept_candle_idx := setup.htf_candle_idx  // Old C2 becomes C1 to sweep
                        new_setup := StampC1Range(new_setup, old_c2)
                        new_setup.htf_candle_idx := candleSet.ref_c2_open_idx  // Current becomes C2
                        new_setup.ltf_end_idx := bar_index + 50
                        new_setup.c2_x := bar_index
                        new_setup.c2_y := high
                        new_setup.htf_count := 1
                        new_setup.tracked_extreme := high
                        new_setup.extreme_bar_idx := bar_index
                        // Find CISD from the extreme bar
                        [cisd_price, cisd_idx] = FindCISDLevel(bar_index, 1)
                        if not na(cisd_price)
                            new_setup.cisd_level := cisd_price
                            new_setup.cisd_start_idx := cisd_idx
                            new_setup.has_cisd := true
                        // Check if sweep is already confirmed on this bar
                        if close < new_setup.sweep_price
                            new_setup.is_confirmed := true
                        // Replace live setup with new one
                        candleSet.live_bearish := new_setup
                        setup_replaced := true
                
                // Only continue tracking if setup wasn't replaced
                if not setup_replaced
                    // CISD trigger check
                    if setup.has_cisd and not setup.cisd_triggered and close < setup.cisd_level
                        // CISD triggered - capture data but DON'T push to history yet (wait for C3 close)
                        setup.cisd_triggered := true
                        setup.cisd_end_idx := bar_index
                        ICGateNewCycle(setup)
                        ICGateBackfill(setup)
                        // Calculate C4 end time (current + 1 HTF duration)
                        setup.c4_end_time := isQuarterlyMode() ? (time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : (time_close(candleSet.settings.htf) + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                        // C5 end time — one more HTF duration past C4, extends IC-CISD tracking through C5
                        setup.c5_end_time := isQuarterlyMode() ? (setup.c4_end_time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : (setup.c4_end_time + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                        TrySetEntryZoneC3(setup)
                        // Confirmed alert for bearish CISD trigger (post-C2 = already confirmed)
                        if settings.alerts_enabled and (settings.bias == "Neutral" or settings.bias == "Bearish")
                            alert(BuildAlertMessage(candleSet.settings.htf, false, false, "Candle 2"), alert.freq_once_per_bar)
                if not setup_replaced
                    setup.ic_current_stage := 3
                    ICUpdate(setup)

        // ===== BULLISH TRACKING (when low is wicked) =====
        if not candleSet.has_live_bullish
            // Start tracking when low is breached (wick)
            if low_breached
                Setup setup = Setup.new()
                setup.is_bullish := true
                setup.is_confirmed := false
                setup.sweep_price := prev_htf.l
                setup.sweep_ltf_idx := prev_htf.l_idx
                setup.sweep_bar_idx := bar_index
                setup.swept_candle_idx := prev_htf.o_idx
                setup := StampC1Range(setup, prev_htf)
                setup.htf_candle_idx := candleSet.ref_c2_open_idx
                setup.ltf_end_idx := bar_index + 50
                setup.c2_x := bar_index
                setup.c2_y := low
                setup.htf_count := 1
                // Initialize CISD tracking - use lowest low so far
                if isNewHTFCandle
                    setup.tracked_extreme := low
                    setup.extreme_bar_idx := bar_index
                else
                    if low < candleSet.candles.first().l
                        setup.tracked_extreme := low
                        setup.extreme_bar_idx := bar_index
                    else
                        setup.tracked_extreme := candleSet.candles.first().l
                        setup.extreme_bar_idx := candleSet.candles.first().l_idx
                // Find CISD from the extreme bar (bias = -1 for bearish candles)
                [cisd_price, cisd_idx] = FindCISDLevel(setup.extreme_bar_idx, -1)
                if not na(cisd_price)
                    setup.cisd_level := cisd_price
                    setup.cisd_start_idx := cisd_idx
                    setup.has_cisd := true
                // Check if sweep is already confirmed on this bar
                if low_sweep_confirmed
                    setup.is_confirmed := true
                candleSet.live_bullish := setup
                candleSet.has_live_bullish := true
        else
            // Bullish tracking exists - update extreme and check CISD
            setup = candleSet.live_bullish
            
            if not setup.is_post_c2
                // C2 phase: dynamic sweep confirmation
                setup.is_confirmed := close > setup.sweep_price
                // Update extreme if new low made
                if low < setup.tracked_extreme
                    ResetC2EntryCandidates(setup)
                    setup.tracked_extreme := low
                    setup.extreme_bar_idx := bar_index
                    setup.c2_x := bar_index
                    setup.c2_y := low
                    // Recalculate CISD from new extreme
                    [new_cisd_price, new_cisd_idx] = FindCISDLevel(bar_index, -1)
                    if not na(new_cisd_price)
                        setup.cisd_level := new_cisd_price
                        setup.cisd_start_idx := new_cisd_idx
                        setup.has_cisd := true
                        setup.cisd_triggered := false  // Reset trigger on new extreme
                        setup.cisd_end_idx := na
                        ResetICCisd(setup)  // IC must wait for new main CISD confirm
                
                // Body break = CISD line end. Show / IC / alerts wait until sweep is also back in.
                if setup.has_cisd and na(setup.cisd_end_idx) and close > setup.cisd_level
                    setup.cisd_end_idx := bar_index
                if setup.is_confirmed and setup.has_cisd and not setup.cisd_triggered and not na(setup.cisd_end_idx)
                    setup.cisd_triggered := true
                    ICGateNewCycle(setup)
                    ICGateBackfill(setup)
                    // Live/Potential alert for bullish CISD trigger
                    if settings.live_alerts_enabled and (settings.bias == "Neutral" or settings.bias == "Bullish")
                        alert(BuildAlertMessage(candleSet.settings.htf, true, true, "Candle 2"), alert.freq_once_per_bar)
                
                setup.ic_current_stage := 3
                ICUpdate(setup)
            else
                // Post-C2 phase: check for invalidation, cancellation, or CISD trigger
                bool setup_replaced = false
                
                if low < setup.c2_extreme
                    if setup.cisd_triggered
                        // CISD already triggered - this is an INVALIDATION
                        // Push invalidated setup to history (will show as xC2)
                        setup.is_invalid := true
                        StopICDetection(setup)  // keep confirmed IC marks with this setup
                        candleSet.setups.unshift(setup)
                        // Also create a new concurrent setup (same as cascade)
                        int old_c2_index = FindCandleIndex(candleSet.candles, setup.htf_candle_idx)
                        Candle old_c2 = candleSet.candles.get(old_c2_index >= 0 ? old_c2_index : 0)
                        Setup new_setup = Setup.new()
                        new_setup.is_bullish := true
                        new_setup.is_confirmed := false
                        new_setup.is_post_c2 := false  // New setup is in C2 phase
                        new_setup.sweep_price := setup.c2_extreme  // Sweep old C2's low
                        new_setup.sweep_ltf_idx := old_c2.l_idx    // Where old C2's low occurred
                        new_setup.sweep_bar_idx := bar_index
                        new_setup.swept_candle_idx := setup.htf_candle_idx  // Old C2 becomes C1 to sweep
                        new_setup := StampC1Range(new_setup, old_c2)
                        new_setup.htf_candle_idx := candleSet.ref_c2_open_idx  // Current becomes C2
                        new_setup.ltf_end_idx := bar_index + 50
                        new_setup.c2_x := bar_index
                        new_setup.c2_y := low
                        new_setup.htf_count := 1
                        new_setup.tracked_extreme := low
                        new_setup.extreme_bar_idx := bar_index
                        // Find CISD from the extreme bar (bias = -1 for bearish candles)
                        [cisd_price_inv, cisd_idx_inv] = FindCISDLevel(bar_index, -1)
                        if not na(cisd_price_inv)
                            new_setup.cisd_level := cisd_price_inv
                            new_setup.cisd_start_idx := cisd_idx_inv
                            new_setup.has_cisd := true
                        // Check if sweep is already confirmed on this bar
                        if close > new_setup.sweep_price
                            new_setup.is_confirmed := true
                        // Replace live setup with new one
                        candleSet.live_bullish := new_setup
                        setup_replaced := true
                    else
                        // CISD not triggered - cancel and IMMEDIATELY start new setup
                        // Old C2 becomes new C1, current bar (C3) becomes new C2
                        int old_c2_index = FindCandleIndex(candleSet.candles, setup.htf_candle_idx)
                        Candle old_c2 = candleSet.candles.get(old_c2_index >= 0 ? old_c2_index : 0)
                        Setup new_setup = Setup.new()
                        new_setup.is_bullish := true
                        new_setup.is_confirmed := false
                        new_setup.is_post_c2 := false  // New setup is in C2 phase
                        new_setup.sweep_price := setup.c2_extreme  // Sweep old C2's low
                        new_setup.sweep_ltf_idx := old_c2.l_idx    // Where old C2's low occurred
                        new_setup.sweep_bar_idx := bar_index
                        new_setup.swept_candle_idx := setup.htf_candle_idx  // Old C2 becomes C1 to sweep
                        new_setup := StampC1Range(new_setup, old_c2)
                        new_setup.htf_candle_idx := candleSet.ref_c2_open_idx  // Current becomes C2
                        new_setup.ltf_end_idx := bar_index + 50
                        new_setup.c2_x := bar_index
                        new_setup.c2_y := low
                        new_setup.htf_count := 1
                        new_setup.tracked_extreme := low
                        new_setup.extreme_bar_idx := bar_index
                        // Find CISD from the extreme bar (bias = -1 for bearish candles)
                        [cisd_price, cisd_idx] = FindCISDLevel(bar_index, -1)
                        if not na(cisd_price)
                            new_setup.cisd_level := cisd_price
                            new_setup.cisd_start_idx := cisd_idx
                            new_setup.has_cisd := true
                        // Check if sweep is already confirmed on this bar
                        if close > new_setup.sweep_price
                            new_setup.is_confirmed := true
                        // Replace live setup with new one
                        candleSet.live_bullish := new_setup
                        setup_replaced := true
                
                // Only continue tracking if setup wasn't replaced
                if not setup_replaced
                    // CISD trigger check
                    if setup.has_cisd and not setup.cisd_triggered and close > setup.cisd_level
                        // CISD triggered - capture data but DON'T push to history yet (wait for C3 close)
                        setup.cisd_triggered := true
                        setup.cisd_end_idx := bar_index
                        ICGateNewCycle(setup)
                        ICGateBackfill(setup)
                        // Calculate C4 end time (current + 1 HTF duration)
                        setup.c4_end_time := isQuarterlyMode() ? (time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : (time_close(candleSet.settings.htf) + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                        // C5 end time — one more HTF duration past C4, extends IC-CISD tracking through C5
                        setup.c5_end_time := isQuarterlyMode() ? (setup.c4_end_time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : (setup.c4_end_time + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                        TrySetEntryZoneC3(setup)
                        // Confirmed alert for bullish CISD trigger (post-C2 = already confirmed)
                        if settings.alerts_enabled and (settings.bias == "Neutral" or settings.bias == "Bullish")
                            alert(BuildAlertMessage(candleSet.settings.htf, true, false, "Candle 2"), alert.freq_once_per_bar)
                if not setup_replaced
                    setup.ic_current_stage := 3
                    ICUpdate(setup)

    if isNewHTFCandle
        // Handle live setups on HTF candle close
        // C2 close: Don't push to history, start post-C2 tracking
        // C3 close: Remove if CISD not triggered (time limit)
        
        // Handle bearish live setup
        if candleSet.has_live_bearish
            Setup setup = candleSet.live_bearish
            // Only handle if setup was created before this bar
            if setup.sweep_bar_idx != bar_index
                setup.htf_count := setup.htf_count + 1
                
                if not setup.is_post_c2
                    // C2 just closed - check confirmation using C2's actual close (previous bar)
                    bool c2_confirmed = close[1] < setup.sweep_price
                    if c2_confirmed
                        // Start post-C2 tracking
                        setup.is_post_c2 := true
                        setup.is_confirmed := true  // Lock in confirmation status
                        setup.ltf_end_idx := bar_index  // Lock sweep line end at C3 start
                        setup.c2_extreme := candleSet.candles.first().h  // C2's high for price limit
                        setup.c2_mid := (candleSet.candles.first().h + candleSet.candles.first().l) / 2.0
                        setup.c2_open := candleSet.candles.first().o
                        setup.c2_close := candleSet.candles.first().c
                        setup.c2_high := candleSet.candles.first().h
                        setup.c2_low := candleSet.candles.first().l
                        setup.c2_open_time := candleSet.candles.first().o_time
                        [poi_kind, poi_top, poi_bottom, poi_origin, poi_touch] = ResolveHtfPoi(candleSet, setup)
                        setup.htf_poi_kind := poi_kind
                        setup.htf_poi_top := poi_top
                        setup.htf_poi_bottom := poi_bottom
                        setup.htf_poi_origin_time := poi_origin
                        setup.htf_poi_touch_time := poi_touch
                        setup.c3_open := open
                        setup.ez_c3_left_time := time
                        TrySetEntryZoneC3(setup)
                        // Note: Even if CISD triggered during C2, continue to post-C2 tracking
                        // to check for invalidation during C3. Will push to history at C3 close.
                        // Confirmed alert if CISD already triggered during C2
                        if setup.cisd_triggered and settings.alerts_enabled and (settings.bias == "Neutral" or settings.bias == "Bearish")
                            alert(BuildAlertMessage(candleSet.settings.htf, false, false, "Candle 2"), alert.freq_once_per_bar)
                    else
                        // Sweep not confirmed at C2 close - remove
                        candleSet.has_live_bearish := false
                else
                    // Post-C2 phase: C3 just closed (htf_count >= 2)
                    if setup.htf_count >= 2
                        // Time limit reached - remove if CISD not triggered
                        if setup.cisd_triggered
                            // COMPLETED! Push to history
                            // Note: ltf_end_idx was already locked at C3 start - don't overwrite
                            // Calculate C4 end time (current + 1 HTF duration since C3 just closed)
                            setup.c4_end_time := isQuarterlyMode() ? (time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : (time_close(candleSet.settings.htf) + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                            setup.c5_end_time := isQuarterlyMode() ? (setup.c4_end_time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : (setup.c4_end_time + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                            setup.ez_c3_right_time := time  // Lock C3 zone to C3 close / C4 open
                            // C4 entry zone at C4 open (this bar); C3 candle is still first() before unshift
                            int ez_c4_right = isQuarterlyMode() ? (time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : time_close(candleSet.settings.htf)
                            TrySetEntryZoneC4(setup, candleSet.candles.first().h, candleSet.candles.first().l, open, time, ez_c4_right)
                        // Retain every confirmed C2 for CRT sweep/POI history.
                        // CISD only controls the later C3/C4 layers.
                        candleSet.setups.unshift(setup)
                        candleSet.has_live_bearish := false
        
        // Handle bullish live setup
        if candleSet.has_live_bullish
            Setup setup = candleSet.live_bullish
            // Only handle if setup was created before this bar
            if setup.sweep_bar_idx != bar_index
                setup.htf_count := setup.htf_count + 1
                
                if not setup.is_post_c2
                    // C2 just closed - check confirmation using C2's actual close (previous bar)
                    bool c2_confirmed = close[1] > setup.sweep_price
                    if c2_confirmed
                        // Start post-C2 tracking
                        setup.is_post_c2 := true
                        setup.is_confirmed := true  // Lock in confirmation status
                        setup.ltf_end_idx := bar_index  // Lock sweep line end at C3 start
                        setup.c2_extreme := candleSet.candles.first().l  // C2's low for price limit
                        setup.c2_mid := (candleSet.candles.first().h + candleSet.candles.first().l) / 2.0
                        setup.c2_open := candleSet.candles.first().o
                        setup.c2_close := candleSet.candles.first().c
                        setup.c2_high := candleSet.candles.first().h
                        setup.c2_low := candleSet.candles.first().l
                        setup.c2_open_time := candleSet.candles.first().o_time
                        [poi_kind, poi_top, poi_bottom, poi_origin, poi_touch] = ResolveHtfPoi(candleSet, setup)
                        setup.htf_poi_kind := poi_kind
                        setup.htf_poi_top := poi_top
                        setup.htf_poi_bottom := poi_bottom
                        setup.htf_poi_origin_time := poi_origin
                        setup.htf_poi_touch_time := poi_touch
                        setup.c3_open := open
                        setup.ez_c3_left_time := time
                        TrySetEntryZoneC3(setup)
                        // Note: Even if CISD triggered during C2, continue to post-C2 tracking
                        // to check for invalidation during C3. Will push to history at C3 close.
                        // Confirmed alert if CISD already triggered during C2
                        if setup.cisd_triggered and settings.alerts_enabled and (settings.bias == "Neutral" or settings.bias == "Bullish")
                            alert(BuildAlertMessage(candleSet.settings.htf, true, false, "Candle 2"), alert.freq_once_per_bar)
                    else
                        // Sweep not confirmed at C2 close - remove
                        candleSet.has_live_bullish := false
                else
                    // Post-C2 phase: C3 just closed (htf_count >= 2)
                    if setup.htf_count >= 2
                        // Time limit reached - remove if CISD not triggered
                        if setup.cisd_triggered
                            // COMPLETED! Push to history
                            // Note: ltf_end_idx was already locked at C3 start - don't overwrite
                            // Calculate C4 end time (current + 1 HTF duration since C3 just closed)
                            setup.c4_end_time := isQuarterlyMode() ? (time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : (time_close(candleSet.settings.htf) + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                            setup.c5_end_time := isQuarterlyMode() ? (setup.c4_end_time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : (setup.c4_end_time + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                            setup.ez_c3_right_time := time  // Lock C3 zone to C3 close / C4 open
                            // C4 entry zone at C4 open (this bar); C3 candle is still first() before unshift
                            int ez_c4_right_bull = isQuarterlyMode() ? (time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : time_close(candleSet.settings.htf)
                            TrySetEntryZoneC4(setup, candleSet.candles.first().h, candleSet.candles.first().l, open, time, ez_c4_right_bull)
                        // Retain every confirmed C2 for CRT sweep/POI history.
                        // CISD only controls the later C3/C4 layers.
                        candleSet.setups.unshift(setup)
                        candleSet.has_live_bullish := false
        
        // Resolve a C3/C2 collision only after completed C3 setups have been
        // retained, so their C2 context remains visible while their later
        // continuation drawings are retired.
        MarkSupersededSetups(candleSet)

        Candle candle = Candle.new()
        candle.o := open
        candle.c := close
        candle.h := high
        candle.l := low
        candle.o_time := time
        candle.o_idx := bar_index
        candle.c_idx := bar_index
        candle.h_idx := bar_index
        candle.l_idx := bar_index
        candle.dow := switch
            candleSet.settings.htf == '1D' =>
                DayofWeek(dayofweek(time_tradingday, "America/New_York"))
            candleSet.settings.htf == '1W' =>
                str.format_time(candle.o_time, 'MMM d', 'America/New_York')
            candleSet.settings.htf == '1M' =>
                str.format_time(candle.o_time, 'MMM', 'America/New_York')
            candleSet.settings.htf == '3M' =>
                int m = month(candle.o_time, 'America/New_York')
                m <= 3 ? 'Q1' : m <= 6 ? 'Q2' : m <= 9 ? 'Q3' : 'Q4'
            candleSet.settings.htf == '12M' =>
                ''
            =>
                str.format_time(candle.o_time, 'HH:mm', 'America/New_York')

        candleSet.candles.unshift(candle)

        // OCL is the open price of the selected NY anchor candle. Keep it as
        // a separate level type so it cannot be mistaken for OHP/OLP.
        int ocl_hour = clOclAnchor == '18:00' ? 18 : 0
        if hour(candle.o_time, 'America/New_York') == ocl_hour
            htfOclLevels.unshift(HTFOCL.new(price = candle.o, origin_time = candle.o_time, origin_idx = candle.o_idx))
        while htfOclLevels.size() > 50
            htfOclLevels.pop()
        
        // Set close time on previous candle (now at index 1)
        if candleSet.candles.size() > 1
            Candle prev = candleSet.candles.get(1)
            prev.c_time := candle.o_time

        // A pivot becomes confirmed only after its newer and older HTF
        // neighbours are known. Persist it independently of the small visual
        // candle cache so OHP/OLP always reference real old liquidity.
        if candleSet.candles.size() > 3
            Candle pivot = candleSet.candles.get(2)
            Candle newer = candleSet.candles.get(1)
            Candle older = candleSet.candles.get(3)
            if pivot.h > newer.h and pivot.h > older.h
                htfLiquidity.unshift(HTFLiquidity.new(price = pivot.h, origin_time = pivot.o_time, origin_idx = pivot.o_idx, is_high = true))
            if pivot.l < newer.l and pivot.l < older.l
                htfLiquidity.unshift(HTFLiquidity.new(price = pivot.l, origin_time = pivot.o_time, origin_idx = pivot.o_idx, is_high = false))
            while htfLiquidity.size() > 100
                htfLiquidity.pop()

        // ===== HTF FAIR VALUE GAP DETECTION =====
        // Three completed HTF candles: A = index 3, B (impulse) = index 2, C = index 1 (just closed)
        // Bullish FVG: A high < C low   |   Bearish FVG: A low > C high
        // Keep a bounded FVG history whenever FVG is enabled as a C2 POI,
        // even if the optional all-FVG display is off. This lets a used FVG
        // remain correctly identified and drawn as the single used POI.
        if (settings.fvg_show or clC2FvgPoi or clC2IfvgPoi) and candleSet.candles.size() > 3
            Candle fvg_c = candleSet.candles.get(1)
            Candle fvg_b = candleSet.candles.get(2)
            Candle fvg_a = candleSet.candles.get(3)
            if fvg_a.h < fvg_c.l
                fvgs.unshift(FVG.new(is_bullish = true, top = fvg_c.l, bot = fvg_a.h, left_time = fvg_b.o_time, b_o_idx = fvg_b.o_idx, known_time = time))
            if fvg_a.l > fvg_c.h
                fvgs.unshift(FVG.new(is_bullish = false, top = fvg_a.l, bot = fvg_c.h, left_time = fvg_b.o_time, b_o_idx = fvg_b.o_idx, known_time = time))
            while fvgs.size() > 100
                fvgs.pop()

        // RB/OB are detected independently and only after the required HTF
        // candles have closed. They never modify C2/C3 state or alerts.
        DetectConfirmedRejectionBlocks(candleSet)
        DetectConfirmedOrderBlocks(candleSet)

        // Detect confirmed sweeps from HTF candle data (for historical data)
        if candleSet.candles.size() > 2
            Candle prev_candle = candleSet.candles.get(1)
            Candle prev_prev_candle = candleSet.candles.get(2)
            bool high_breached = prev_candle.h > prev_prev_candle.h
            bool low_breached = prev_candle.l < prev_prev_candle.l
            bool high_sweep_condition = high_breached and prev_candle.c < prev_prev_candle.h
            bool low_sweep_condition = low_breached and prev_candle.c > prev_prev_candle.l

            if settings.sweep_show
                if high_sweep_condition
                    Sweep sweep = Sweep.new()
                    sweep.price := prev_prev_candle.h
                    sweep.ltf_index := prev_prev_candle.h_idx
                    sweep.htf_candle_idx := prev_candle.o_idx
                    sweep.swept_candle_idx := prev_prev_candle.o_idx
                    sweep.ltf_end_idx := candle.o_idx
                    sweep.is_high := true
                    sweep.c2_extreme_idx := prev_candle.h_idx
                    sweep.c2_extreme_price := prev_candle.h
                    candleSet.sweeps.push(sweep)
                    
                if low_sweep_condition
                    Sweep sweep = Sweep.new()
                    sweep.price := prev_prev_candle.l
                    sweep.ltf_index := prev_prev_candle.l_idx
                    sweep.htf_candle_idx := prev_candle.o_idx
                    sweep.swept_candle_idx := prev_prev_candle.o_idx
                    sweep.ltf_end_idx := candle.o_idx
                    sweep.is_high := false
                    sweep.c2_extreme_idx := prev_candle.l_idx
                    sweep.c2_extreme_price := prev_candle.l
                    candleSet.sweeps.push(sweep)
                
                // Limit setups storage - store 2x to ensure enough of each bias type when filtering
                int max_setups = (candleSet.settings.max_display + settings.sweep_history) * 2
                while candleSet.setups.size() > max_setups
                    candleSet.setups.pop()

        // The mini HTF projection is intentionally small, but it is not the
        // CRT history store.  Removing a projected candle must not erase its
        // already-confirmed sweep from the chart map.
        int max_sweep_history = math.max(1, (candleSet.settings.max_display + settings.sweep_history) * 2)
        while candleSet.sweeps.size() > max_sweep_history
            candleSet.sweeps.shift()

        // Remove oldest candle only from the visual HTF projection cache.
        if candleSet.candles.size() > candleSet.settings.max_display
            array.pop(candleSet.candles)

    // A fresh, back-inside C2 owns the candle that had been C3 for a prior
    // setup. Retire that old continuation immediately; keep only its sweep/C2
    // context until the newer C2 either confirms or fails.
    MarkSupersededSetups(candleSet)
    // Also evaluate the currently developing CRT C2.  This allows a TBS that
    // returns inside on the same LTF bar as the sweep to be retained; entry
    // still requires a later confirmed body close through M1.
    if candleSet.has_live_bearish
        UpdateTbsModel1(candleSet.live_bearish)
        UpdateFvgModel2(candleSet.live_bearish)
    if candleSet.has_live_bullish
        UpdateTbsModel1(candleSet.live_bullish)
        UpdateFvgModel2(candleSet.live_bullish)
    candleSet

method Update(CandleSet candleSet) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        if high > candle.h
            candle.h := high
            candle.h_idx := bar_index
        if low < candle.l
            candle.l := low
            candle.l_idx := bar_index
        candle.c := close
        candle.c_idx := bar_index

        // Update trace data
        if candleSet.trace.start_idx == 0
            candleSet.trace.start_idx := candle.o_idx
            candleSet.trace.start_price := candle.o
    candleSet

// Check CISD trigger for confirmed setups
method CheckCISDTrigger(CandleSet candleSet) =>
    if candleSet.setups.size() > 0
        for setup in candleSet.setups
            if setup.is_confirmed and setup.has_cisd and not setup.cisd_triggered
                // Bearish setup: CISD triggered when close goes BELOW cisd_level
                if not setup.is_bullish and close < setup.cisd_level
                    setup.cisd_triggered := true
                    setup.cisd_end_idx := bar_index
                // Bullish setup: CISD triggered when close goes ABOVE cisd_level
                else if setup.is_bullish and close > setup.cisd_level
                    setup.cisd_triggered := true
                    setup.cisd_end_idx := bar_index
    candleSet

// ============================================================================
// Drawing Methods (only called on barstate.islast)
// ============================================================================

method CalculatePositions(CandleSet candleSet, int offset) =>
    size = candleSet.candles.size()
    if size > 0
        for i = size - 1 to 0 by 1
            Candle candle = candleSet.candles.get(i)
            t_buffer = offset + (settings.width + 1) * (size - i - 1)
            candle.candle_left := bar_index + t_buffer
            candle.candle_right := bar_index + settings.width + t_buffer
            candle.wick_x := bar_index + settings.width / 2 + t_buffer
    candleSet

method DrawCandles(CandleSet candleSet) =>
    for [i, candle] in candleSet.candles
        bull = candle.c > candle.o
        bool psp_highlight = psp_enabled and (psp_mode == 'Polarity Change' ? candle.has_divergence : candle.is_psp)
        color candle_body_color = psp_highlight ? (candle.is_bullish_div ? psp_bull_div_body : psp_bear_div_body) : (bull ? settings.bull_body : settings.bear_body)
        // Draw body
        bin.boxes.push(box.new(candle.candle_left, math.max(candle.o, candle.c), candle.candle_right, math.min(candle.o, candle.c), bull ? settings.bull_border : settings.bear_border, 1, bgcolor = candle_body_color))
        // Draw wicks
        bin.lines.push(line.new(candle.wick_x, candle.h, candle.wick_x, math.max(candle.o, candle.c), color = bull ? settings.bull_wick : settings.bear_wick))
        bin.lines.push(line.new(candle.wick_x, math.min(candle.o, candle.c), candle.wick_x, candle.l, color = bull ? settings.bull_wick : settings.bear_wick))
        // Draw interval value label based on position setting
        if settings.daily_name and candle.dow != ''
            if settings.dow_position == 'Both' or settings.dow_position == 'Top'
                bin.labels.push(label.new(candle.wick_x, candle.h, candle.dow, color = color_transparent, textcolor = settings.dow_color, style = label.style_label_down, size = settings.dow_size))
            if settings.dow_position == 'Both' or settings.dow_position == 'Bottom'
                bin.labels.push(label.new(candle.wick_x, candle.l, candle.dow, color = color_transparent, textcolor = settings.dow_color, style = label.style_label_up, size = settings.dow_size))
    candleSet

method DrawVTHLLines(CandleSet candleSet) =>
    // Draw VT lines and HL lines - these are on the LTF chart, not the HTF projection
    vt_line_style = LineStyle(candleSet.settings.vt_style)
    hl_line_style = LineStyle(candleSet.settings.hl_style)
    
    for [i, candle] in candleSet.candles
        // Draw vertical line
        if candleSet.settings.vt_show
            bin.lines.push(line.new(candle.o_time, candle.h, candle.o_time, candle.l, xloc = xloc.bar_time, extend = extend.both, color = candleSet.settings.vt_color, style = vt_line_style, width = candleSet.settings.vt_size))
        // Draw H/L lines - skip current developing candle (i == 0)
        if candleSet.settings.hl_show and i != 0
            int hl_end_time = candle.c_time
            if hl_end_time > 0
                bin.lines.push(line.new(candle.o_time, candle.h, hl_end_time, candle.h, xloc = xloc.bar_time, color = candleSet.settings.hl_color, style = hl_line_style, width = candleSet.settings.hl_width))
                bin.lines.push(line.new(candle.o_time, candle.l, hl_end_time, candle.l, xloc = xloc.bar_time, color = candleSet.settings.hl_color, style = hl_line_style, width = candleSet.settings.hl_width))
    candleSet

// HTF Fair Value Gaps — projected on the LTF chart and (optionally) beside the HTF candle projection
method DrawFVGs(CandleSet candleSet) =>
    if settings.fvg_show and fvgs.size() > 0
        int fvg_shown = 0
        for f in fvgs
            if fvg_shown >= settings.fvg_max
                break
            if settings.fvg_hide_mitigated and not na(f.mit_time)
                continue
            color fvg_col = f.is_bullish ? settings.fvg_bull_color : settings.fvg_bear_color

            // ---- Projection on the LTF chart (bar-time boxes) ----
            if settings.fvg_project
                int fvg_right = na(f.mit_time) ? time_close : f.mit_time
                if fvg_right > f.left_time
                    bin.boxes.push(box.new(f.left_time, f.top, fvg_right, f.bot,
                        xloc = xloc.bar_time, bgcolor = fvg_col, border_color = color_transparent, border_width = 0))

            // ---- Projection beside the HTF candles (mini candle area) ----
            if settings.fvg_htf_show and not settings.hide_candles and candleSet.candles.size() > 0
                int hx1 = na
                int b_i = FindCandleIndex(candleSet.candles, f.b_o_idx)
                if b_i >= 0
                    hx1 := candleSet.candles.get(b_i).candle_left
                else
                    // Impulse candle already scrolled out of the projection — clamp to the oldest visible candle
                    Candle oldest = candleSet.candles.last()
                    if f.left_time < oldest.o_time
                        hx1 := oldest.candle_left
                int hx2 = candleSet.candles.first().candle_right
                if not na(f.mit_time)
                    // Stop at the HTF candle in which the gap was filled
                    for [k, cnd] in candleSet.candles
                        if cnd.o_time <= f.mit_time
                            hx2 := cnd.candle_right
                            break
                if not na(hx1) and hx2 > hx1
                    bin.boxes.push(box.new(hx1, f.top, hx2, f.bot,
                        bgcolor = fvg_col, border_color = color_transparent, border_width = 0))

            fvg_shown := fvg_shown + 1
    candleSet

// Draw confirmed, independently detected HTF sweeps only when there is NO
// matching retained C2. This restores a missing C2/sweep on the LTF without
// duplicating a normal setup, or inventing an unconfirmed sweep.
// The fallback does not invent historical M1/M2 entries: those must be
// detected by the entry engine during the relevant C2 hour.
method DrawSweeps(CandleSet candleSet) =>
    if settings.sweep_show and candleSet.sweeps.size() > 0
        sweep_line_style = LineStyle(settings.sweep_style)
        for sweep in candleSet.sweeps
            bool direction_ok = settings.bias == 'Neutral' or (settings.bias == 'Bullish' and not sweep.is_high) or (settings.bias == 'Bearish' and sweep.is_high)
            bool time_ok = CLCrtHourAllowed(ChartBarTime(sweep.htf_candle_idx))
            // A fallback without a resolved POI must obey checklist-only mode.
            bool checklist_ok = not crtOnlyChecklistC2 or (crtShowNonPoiAtKeyTimes and IsSelectedCrtKeyTime(ChartBarTime(sweep.htf_candle_idx)))
            bool covered = false
            if candleSet.setups.size() > 0
                for recorded in candleSet.setups
                    if recorded.htf_candle_idx == sweep.htf_candle_idx and recorded.is_bullish == (not sweep.is_high) and recorded.is_confirmed
                        covered := true
            if candleSet.has_live_bullish and not sweep.is_high and candleSet.live_bullish.htf_candle_idx == sweep.htf_candle_idx
                covered := true
            if candleSet.has_live_bearish and sweep.is_high and candleSet.live_bearish.htf_candle_idx == sweep.htf_candle_idx
                covered := true
            if direction_ok and time_ok and checklist_ok and not covered
                int line_start = ChartBarTime(sweep.ltf_index)
                int line_end = ChartBarTime(sweep.c2_extreme_idx)
                if not na(line_start) and not na(line_end) and line_start <= line_end
                    bin.lines.push(line.new(line_start, sweep.price, line_end, sweep.price, xloc = xloc.bar_time, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
                    if settings.show_c2_lbl and not na(sweep.c2_extreme_price)
                        bin.labels.push(label.new(line_end, sweep.c2_extreme_price, 'C2', xloc = xloc.bar_time, color = color_transparent, textcolor = settings.c2_color, style = sweep.is_high ? label.style_label_down : label.style_label_up, size = settings.c2_size, tooltip = 'Confirmed 1H sweep recovered from completed HTF candles. LTF entry signals still require the original active C2 model.'))
    candleSet

method DrawLabels(CandleSet candleSet, int offset) =>
    size = candleSet.candles.size()
    if size > 0 and settings.htf_label_show
        top = CandleSetHigh(candleSet.candles, 0)
        bottom = CandleSetLow(candleSet.candles, top)
        left = bar_index + offset + (settings.width + 1) * (size - 1) / 2
        
        string lbl_text = HTFName(candleSet.settings.htf)
        if settings.htf_timer_show
            lbl_text := lbl_text + '\n\n(' + RemainingTime(candleSet.settings.htf) + ')'
        
        if settings.label_position == 'Both' or settings.label_position == 'Top'
            bin.labels.push(label.new(left, top, lbl_text, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_down, size = settings.htf_label_size))
        if settings.label_position == 'Both' or settings.label_position == 'Bottom'
            bin.labels.push(label.new(left, bottom, lbl_text, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_up, size = settings.htf_label_size))
    candleSet

method DrawTrace(CandleSet candleSet, int offset) =>
    if settings.trace_show and candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        if bar_index - candle.o_idx < 5000
            bin.lines.push(line.new(candle.o_idx, candle.o, candle.candle_left, candle.o, color = settings.trace_o_color, style = LineStyle(settings.trace_o_style), width = settings.trace_o_size))
    candleSet

DrawC1CrtRange(Setup setup, CandleSet candleSet) =>
    if crtShowC1Range and not na(setup.c1_high) and not na(setup.c1_low) and not na(setup.c1_high_idx) and not na(setup.c1_low_idx)
        int c2_start = ChartBarTime(setup.htf_candle_idx)
        int c2_end = not na(setup.ez_c3_left_time) ? setup.ez_c3_left_time : c2_start + timeframe.in_seconds(candleSet.settings.htf) * 1000
        // No active C3: the CRT range ends at C2. With C3 active, cap it at
        // C3 close (or an earlier take), so it never drifts into later C2s.
        bool c3_active = setup.cisd_triggered and not setup.is_superseded and not setup.is_invalid
        int c3_end = not na(setup.ez_c3_right_time) ? setup.ez_c3_right_time : time_close
        int high_end = c3_active ? (not na(setup.c1_high_taken_time) and setup.c1_high_taken_time < c3_end ? setup.c1_high_taken_time : c3_end) : c2_end
        int low_end = c3_active ? (not na(setup.c1_low_taken_time) and setup.c1_low_taken_time < c3_end ? setup.c1_low_taken_time : c3_end) : c2_end
        int eq_end = high_end > low_end ? high_end : low_end
        int high_start = ChartBarTime(setup.c1_high_idx)
        int low_start = ChartBarTime(setup.c1_low_idx)
        float eq = (setup.c1_high + setup.c1_low) / 2.0
        if not na(high_start) and high_end > high_start
            bin.lines.push(line.new(high_start, setup.c1_high, high_end, setup.c1_high, xloc = xloc.bar_time, color = crtHighColor, width = 1))
            bin.labels.push(label.new(high_end, setup.c1_high, 'CRT H', xloc = xloc.bar_time, color = color_transparent, textcolor = crtHighColor, style = label.style_none, size = size.tiny))
        if not na(low_start) and low_end > low_start
            bin.lines.push(line.new(low_start, setup.c1_low, low_end, setup.c1_low, xloc = xloc.bar_time, color = crtLowColor, width = 1))
            bin.labels.push(label.new(low_end, setup.c1_low, 'CRT L', xloc = xloc.bar_time, color = color_transparent, textcolor = crtLowColor, style = label.style_none, size = size.tiny))
        int eq_start = not na(high_start) and not na(low_start) ? (high_start < low_start ? high_start : low_start) : c2_start
        if eq_end > eq_start
            bin.lines.push(line.new(eq_start, eq, eq_end, eq, xloc = xloc.bar_time, color = crtEqColor, style = line.style_dashed, width = 1))
            bin.labels.push(label.new(eq_end, eq, 'CRT EQ', xloc = xloc.bar_time, color = color_transparent, textcolor = crtEqColor, style = label.style_none, size = size.tiny))
    true

// Clean LTF display for the selectable TBS / Model #1 entry model.  These
// lines are separate from the older C3/C4 entry-zone boxes: TBS identifies
// the local body-sweep, M1 is the later-close trigger, and SL is the sweep
// manipulation extreme captured when TBS confirms.
DrawTbsModel1(Setup setup) =>
    if crtM1Show and crtM1Enabled and not na(setup.m1_signals) and setup.m1_signals.size() > 0
        for signal in setup.m1_signals
            bool has_winner = CrtHasConfirmedEntry(setup)
            // Winner only after confirmation; show at most one pending TBS.
            bool show_single = has_winner ? (signal.entry_triggered and not setup.m2_entry_triggered) : signal.tbs_idx == setup.m1_signals.last().tbs_idx
            if crtSingleEntryC2 and not show_single
                continue
            int structure_idx = not na(signal.structure_start_idx) ? signal.structure_start_idx : signal.tbs_idx - nz(signal.pattern_count, 2)
            int left_time = ChartBarTime(structure_idx)
            int tbs_time = ChartBarTime(signal.tbs_idx)
            int entry_time = signal.entry_triggered and not na(signal.entry_idx) ? ChartBarTime(signal.entry_idx) : na
            int right_time = not na(entry_time) ? entry_time + crtEntryLineBars * timeframe.in_seconds() * 1000 : time_close
            color direction_color = setup.is_bullish ? crtM1BullColor : crtM1BearColor
            string direction = setup.is_bullish ? 'Bullish' : 'Bearish'
            string validation_text = crtM1RequireInside ? str.tostring(signal.pattern_count) + ' contained candles' : '2–6 validation off'
            int structure_end_idx = signal.tbs_idx - 1
            string structure_times = str.format_time(ChartBarTime(structure_idx), 'yyyy-MM-dd HH:mm', 'America/New_York') + ' → ' + str.format_time(ChartBarTime(structure_end_idx), 'yyyy-MM-dd HH:mm', 'America/New_York')
            string c2_time = str.format_time(na(setup.c2_open_time) ? ChartBarTime(setup.htf_candle_idx) : setup.c2_open_time, 'yyyy-MM-dd HH:mm', 'America/New_York')
            string model_tip = 'CRT Model #1 — ' + direction + '\nHTF: ' + htf.settings.htf + ' | LTF: ' + timeframe.period + '\nC2 open: ' + c2_time + '\nCRT return: body close ' + (setup.is_bullish ? 'above CRT L' : 'below CRT H') + '\nInside validation: ' + validation_text + '\nInside range: ' + structure_times + '\nTBS time: ' + str.format_time(tbs_time, 'yyyy-MM-dd HH:mm', 'America/New_York') + '\nTBS level: ' + str.tostring(signal.tbs_level, format.mintick) + '\nM1 trigger: ' + str.tostring(signal.level, format.mintick) + '\nEntry: ' + (signal.entry_triggered ? 'confirmed ' + str.format_time(entry_time, 'yyyy-MM-dd HH:mm', 'America/New_York') : 'waiting for later body close in this C2') + '\nSL: ' + str.tostring(signal.sl, format.mintick) + ' (manipulation extreme)'
            if not na(left_time) and right_time > left_time
                bin.lines.push(line.new(left_time, signal.tbs_level, right_time, signal.tbs_level, xloc = xloc.bar_time, color = direction_color, style = line.style_dashed, width = 1))
            if not na(tbs_time) and right_time > tbs_time
                bin.lines.push(line.new(tbs_time, signal.level, right_time, signal.level, xloc = xloc.bar_time, color = direction_color, width = 2))
                bin.lines.push(line.new(tbs_time, signal.sl, right_time, signal.sl, xloc = xloc.bar_time, color = crtM1SlColor, style = line.style_dotted, width = 1))
            tbs_style = setup.is_bullish ? label.style_label_up : label.style_label_down
            bin.labels.push(label.new(tbs_time, signal.tbs_level, 'TBS', xloc = xloc.bar_time, color = color_transparent, textcolor = direction_color, style = tbs_style, size = size.small, tooltip = model_tip))
            bin.labels.push(label.new(tbs_time, signal.level, 'M1', xloc = xloc.bar_time, color = color_transparent, textcolor = direction_color, style = tbs_style, size = size.small, tooltip = model_tip))
            bin.labels.push(label.new(right_time, signal.sl, 'SL', xloc = xloc.bar_time, color = color_transparent, textcolor = crtM1SlColor, style = tbs_style, size = size.small, tooltip = model_tip))
            if signal.entry_triggered and not na(entry_time)
                bin.labels.push(label.new(right_time, signal.level, 'Entry', xloc = xloc.bar_time, color = color_transparent, textcolor = crtM1EntryColor, style = tbs_style, size = size.small, tooltip = model_tip))
    true

DrawFvgModel2(Setup setup) =>
    if crtM1Show and crtM2Enabled and setup.m2_fvg_found and (not crtSingleEntryC2 or not setup.m1_entry_triggered) and not na(setup.m2_fvg_idx) and not na(setup.m2_fvg_top) and not na(setup.m2_fvg_bottom)
        int fvg_left = ChartBarTime(setup.m2_fvg_idx - 1)
        int entry_time = setup.m2_entry_triggered and not na(setup.m2_entry_idx) ? ChartBarTime(setup.m2_entry_idx) : na
        // The Model #2 FVG is an entry reference, not a permanent zone:
        // stop it at its first tap. If price never taps it, cap the display
        // to ten LTF candles so stale boxes do not run across the chart.
        int max_fvg_right = fvg_left + 10 * timeframe.in_seconds() * 1000
        int fvg_right = setup.m2_tapped and not na(setup.m2_tap_idx) ? ChartBarTime(setup.m2_tap_idx) : math.min(time_close, max_fvg_right)
        int right_time = not na(entry_time) ? entry_time + crtEntryLineBars * timeframe.in_seconds() * 1000 : time_close
        color fvg_color = setup.is_bullish ? crtM2BullColor : crtM2BearColor
        string direction = setup.is_bullish ? 'Bullish' : 'Bearish'
        string c2_time = str.format_time(na(setup.c2_open_time) ? ChartBarTime(setup.htf_candle_idx) : setup.c2_open_time, 'yyyy-MM-dd HH:mm', 'America/New_York')
        string m2_tip = 'CRT Model #2 — ' + direction + '\nHTF: ' + htf.settings.htf + ' | LTF: ' + timeframe.period + '\nC2 open: ' + c2_time + '\nFVG formed: ' + str.format_time(ChartBarTime(setup.m2_fvg_idx), 'yyyy-MM-dd HH:mm', 'America/New_York') + '\nFVG range: ' + str.tostring(setup.m2_fvg_bottom, format.mintick) + '–' + str.tostring(setup.m2_fvg_top, format.mintick) + '\nTap: ' + (setup.m2_tapped ? str.format_time(ChartBarTime(setup.m2_tap_idx), 'yyyy-MM-dd HH:mm', 'America/New_York') : 'waiting') + '\nRejection entry: ' + (setup.m2_entry_triggered ? 'confirmed ' + str.format_time(entry_time, 'yyyy-MM-dd HH:mm', 'America/New_York') : 'waiting') + '\nSL: ' + (not na(setup.m2_sl) ? str.tostring(setup.m2_sl, format.mintick) : 'pending')
        if not na(fvg_left) and fvg_right > fvg_left
            bin.boxes.push(box.new(fvg_left, setup.m2_fvg_top, fvg_right, setup.m2_fvg_bottom, xloc = xloc.bar_time, bgcolor = fvg_color, border_color = setup.is_bullish ? crtM1BullColor : crtM1BearColor, border_width = 1))
            bin.labels.push(label.new(fvg_left, setup.m2_fvg_top, 'M2 FVG', xloc = xloc.bar_time, color = color_transparent, textcolor = setup.is_bullish ? crtM1BullColor : crtM1BearColor, style = label.style_none, size = size.small, tooltip = m2_tip))
        if setup.m2_entry_triggered and not na(entry_time) and not na(setup.m2_sl)
            m2_style = setup.is_bullish ? label.style_label_up : label.style_label_down
            bin.lines.push(line.new(fvg_left, setup.m2_sl, entry_time, setup.m2_sl, xloc = xloc.bar_time, color = crtM1SlColor, style = line.style_dotted, width = 1))
            bin.lines.push(line.new(entry_time, setup.is_bullish ? setup.m2_fvg_top : setup.m2_fvg_bottom, right_time, setup.is_bullish ? setup.m2_fvg_top : setup.m2_fvg_bottom, xloc = xloc.bar_time, color = crtM1EntryColor, width = 2))
            bin.lines.push(line.new(entry_time, setup.m2_sl, right_time, setup.m2_sl, xloc = xloc.bar_time, color = crtM1SlColor, style = line.style_dotted, width = 1))
            bin.labels.push(label.new(right_time, setup.is_bullish ? setup.m2_fvg_top : setup.m2_fvg_bottom, 'M2 Entry', xloc = xloc.bar_time, color = color_transparent, textcolor = crtM1EntryColor, style = m2_style, size = size.small, tooltip = m2_tip))
            bin.labels.push(label.new(right_time, setup.m2_sl, 'SL', xloc = xloc.bar_time, color = color_transparent, textcolor = crtM1SlColor, style = m2_style, size = size.small, tooltip = m2_tip))
    true

method DrawSetups(CandleSet candleSet) =>
    // Cache style calculations once for both sections
    sweep_line_style = LineStyle(settings.sweep_style)
    cisd_line_style = LineStyle(settings.cisd_style)
    
    // Draw confirmed setups
    if candleSet.setups.size() > 0
        int non_visible_count = 0
        int total_count = 0
        
        for [i, setup] in candleSet.setups
            // Skip if not confirmed
            if not setup.is_confirmed
                continue
            
            // CRT timing gates the main Fractal C2 package itself. This
            // applies to historical and live setups, not only a side model.
            if clUseCrtTiming and not CLCrtHourAllowed(ChartBarTime(setup.htf_candle_idx))
                continue
            if not ShouldDisplayC2(setup)
                continue
            // Apply bias filter - skip if bias doesn't match
            bool bias_ok = settings.bias == 'Neutral' or (settings.bias == 'Bullish' and setup.is_bullish) or (settings.bias == 'Bearish' and not setup.is_bullish)
            if not bias_ok
                continue
            
            // Check if setup's HTF candle is visible
            bool is_visible = false
            for [j, candle] in candleSet.candles
                if candle.o_idx == setup.htf_candle_idx
                    is_visible := true
                    break
            
            // Determine if we should draw this setup
            bool should_draw = false
            if settings.sweep_visible_only
                if is_visible
                    should_draw := true
                else if non_visible_count < settings.sweep_history
                    should_draw := true
                    non_visible_count := non_visible_count + 1
            else
                if total_count < settings.sweep_history
                    should_draw := true
                    total_count := total_count + 1
            
            if should_draw
                DrawC1CrtRange(setup, candleSet)
                DrawTbsModel1(setup)
                DrawFvgModel2(setup)
                // ==== LAYER 3: C2 LABEL - show "xC2" in red if invalid ====
                if settings.show_c2_lbl
                    lbl_style = setup.is_bullish ? label.style_label_up : label.style_label_down
                    string lbl_base = setup.is_invalid ? "xC2" : "C2"
                    string lbl_text = lbl_base + (setup.c2_psp ? " + PSP" : "")
                    color lbl_color = setup.is_invalid ? color.red : settings.c2_color
                    bin.labels.push(label.new(ChartBarTime(setup.c2_x), setup.c2_y, lbl_text, xloc = xloc.bar_time, color = color_transparent, textcolor = lbl_color, style = lbl_style, size = settings.c2_size, tooltip = C2Tooltip(setup, candleSet)))
                DrawUsedHtfPoi(bin, candleSet, setup)
                
                // ==== LAYER 4: SWEEP LINES (near top) - SKIP if invalid ====
                if not setup.is_invalid and settings.sweep_show
                    bin.lines.push(line.new(ChartBarTime(setup.sweep_ltf_idx), setup.sweep_price, ChartBarTime(setup.sweep_bar_idx), setup.sweep_price, xloc = xloc.bar_time, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
                
                // Draw HTF sweep line - only when projection is visible, SKIP if invalid
                if not setup.is_invalid and not settings.hide_candles
                    int htf_x1 = na
                    int htf_x2 = na
                    for [k, candle] in candleSet.candles
                        if candle.o_idx == setup.swept_candle_idx
                            htf_x1 := candle.wick_x
                        if candle.o_idx == setup.htf_candle_idx
                            htf_x2 := candle.wick_x
                    if not na(htf_x1) and not na(htf_x2)
                        if settings.sweep_show
                            bin.lines.push(line.new(htf_x1, setup.sweep_price, htf_x2, setup.sweep_price, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
                
                // ==== LAYER 5: CISD LINE (on top) ====
                if not setup.is_superseded and settings.cisd_show and setup.cisd_triggered and setup.has_cisd
                    cisd_color = setup.is_bullish ? settings.cisd_bull_color : settings.cisd_bear_color
                    // Extend 1 bar beyond trigger
                    bin.lines.push(line.new(ChartBarTime(setup.cisd_start_idx), setup.cisd_level, ChartBarTime(setup.cisd_end_idx + 1), setup.cisd_level, xloc = xloc.bar_time, color = cisd_color, style = cisd_line_style, width = settings.cisd_width))
                
                // ==== LAYER 5b: IC-CISD (draw only after sweep-back-in / show) ====
                if not setup.is_superseded and settings.ic_cisd_show and setup.cisd_triggered and not na(setup.ic_list) and setup.ic_list.size() > 0
                    for ic_i = 0 to setup.ic_list.size() - 1
                        ICCisd ic = setup.ic_list.get(ic_i)
                        // Invalidated (taken) IC-CISD can be hidden via "Show Invalidated IC-CISD"
                        if ic.taken and not settings.ic_show_taken
                            continue
                        // Hide this stage (C3/C4/C5) entirely if its toggle is off
                        if not ICStageVisible(ic.stage)
                            continue
                        color ic_col = ic.taken ? color.gray : (setup.is_bullish ? settings.ic_cisd_bull_color : settings.ic_cisd_bear_color)
                        if not na(ic.level) and not na(ic.start_idx) and not na(ic.end_idx)
                            bin.lines.push(line.new(ChartBarTime(ic.start_idx), ic.level, ChartBarTime(ic.end_idx), ic.level, xloc = xloc.bar_time, color = ic_col, style = cisd_line_style, width = settings.cisd_width))
                        if DirectionalProtectedSwing(setup, ic) and ProtectedSwingWindowActive(setup, candleSet.settings.htf)
                            ic_dot_style = setup.is_bullish ? label.style_label_up : label.style_label_down
                            bin.labels.push(label.new(ChartBarTime(ic.extreme_idx), ic.extreme_price, "●", xloc = xloc.bar_time, color = color_transparent, textcolor = ic_col, style = ic_dot_style, size = settings.ic_dot_size))
                
                // ==== LAYER 7: PREVIOUS EQ (chart) — after confirmed; C2 mid on C3, C3 mid on C4 ====
                if not setup.is_superseded and not setup.is_invalid and setup.is_confirmed and ShowChartEQ()
                    eq_line_style = LineStyle(prev_eq_style)
                    // C2 EQ across C3 window
                    if not na(setup.c2_mid) and not na(setup.ez_c3_left_time)
                        int eq3_right = EntryZoneRight(setup.ez_c3_right_time)
                        if eq3_right > setup.ez_c3_left_time
                            bin.lines.push(line.new(setup.ez_c3_left_time, setup.c2_mid, eq3_right, setup.c2_mid,
                                xloc = xloc.bar_time, color = prev_eq_color, style = eq_line_style, width = prev_eq_width))
                    // C3 EQ across C4 window — if C4 invalid: stop at that LTF bar, red
                    if not na(setup.c3_mid) and not na(setup.ez_c4_left_time)
                        int eq4_right = setup.ez_c4_invalid and not na(setup.ez_c4_invalid_time) ? setup.ez_c4_invalid_time : EntryZoneRight(setup.ez_c4_right_time)
                        color eq4_col = setup.ez_c4_invalid ? color.red : prev_eq_color
                        if eq4_right > setup.ez_c4_left_time
                            bin.lines.push(line.new(setup.ez_c4_left_time, setup.c3_mid, eq4_right, setup.c3_mid,
                                xloc = xloc.bar_time, color = eq4_col, style = eq_line_style, width = prev_eq_width))
                
                // ==== LAYER 7b: PREVIOUS EQ (HTF projection) — C2 mid→C3 end+2, C3 mid→C4 end+2 ====
                if not setup.is_superseded and not setup.is_invalid and setup.is_confirmed and ShowHtfEQ() and not settings.hide_candles
                    int c2_i = FindCandleIndex(candleSet.candles, setup.htf_candle_idx)
                    eq_htf_style = LineStyle(prev_eq_style)
                    // C2 EQ: mid of C2 projection → end of C3 projection + 2 LTF bars
                    if not na(setup.c2_mid) and c2_i > 0
                        Candle c2_proj = candleSet.candles.get(c2_i)
                        Candle c3_proj = candleSet.candles.get(c2_i - 1)
                        int htf_eq3_x1 = c2_proj.wick_x
                        int htf_eq3_x2 = c3_proj.candle_right + 2
                        if htf_eq3_x2 > htf_eq3_x1
                            bin.lines.push(line.new(htf_eq3_x1, setup.c2_mid, htf_eq3_x2, setup.c2_mid,
                                color = prev_eq_color, style = eq_htf_style, width = prev_eq_width))
                    // C3 EQ: mid of C3 projection → end of C4 projection + 2 LTF bars (red if C4 invalid)
                    if not na(setup.c3_mid) and c2_i > 1
                        Candle c3_proj4 = candleSet.candles.get(c2_i - 1)
                        Candle c4_proj = candleSet.candles.get(c2_i - 2)
                        int htf_eq4_x1 = c3_proj4.wick_x
                        int htf_eq4_x2 = c4_proj.candle_right + 2
                        color htf_eq4_col = setup.ez_c4_invalid ? color.red : prev_eq_color
                        if htf_eq4_x2 > htf_eq4_x1
                            bin.lines.push(line.new(htf_eq4_x1, setup.c3_mid, htf_eq4_x2, setup.c3_mid,
                                color = htf_eq4_col, style = eq_htf_style, width = prev_eq_width))
                
                // ==== LAYER 8: ENTRY ZONE C3 - SKIP if invalid ====
                // Label: bearish = top-left of box (label_down), bullish = bottom-left (label_up) — same gap style as C2; one candle right of left edge
                // Zone right edge develops with LTF bars, then locks at C3 end
                if not setup.is_superseded and not setup.is_invalid and settings.entry_zone_show and setup.ez_c3_set and not na(setup.ez_c3_left_time)
                    color ez_col = setup.is_bullish ? settings.entry_zone_bull_color : settings.entry_zone_bear_color
                    int ez_right = EntryZoneRight(setup.ez_c3_right_time)
                    bin.boxes.push(box.new(setup.ez_c3_left_time, setup.ez_c3_top, ez_right, setup.ez_c3_bot,
                        xloc = xloc.bar_time, bgcolor = ez_col, border_color = color_transparent, border_width = 0))
                    if settings.show_c3_lbl
                        float ez_lbl_y = setup.is_bullish ? setup.ez_c3_bot : setup.ez_c3_top
                        int ez_lbl_x = setup.ez_c3_left_time + timeframe.in_seconds() * 1000
                        lbl_style_ez = setup.is_bullish ? label.style_label_up : label.style_label_down
                        bin.labels.push(label.new(ez_lbl_x, ez_lbl_y, "C3", xloc = xloc.bar_time,
                            color = color_transparent, textcolor = settings.c2_color, style = lbl_style_ez, size = settings.c2_size))
                
                // ==== LAYER 9: ENTRY ZONE C4 — zone removed if invalidated; label becomes xC4 ====
                // Zone right edge develops with LTF bars, then locks at C4 end
                if not setup.is_superseded and not setup.is_invalid and settings.entry_zone_show and setup.ez_c4_set and not na(setup.ez_c4_left_time)
                    color ez4_col = setup.is_bullish ? settings.entry_zone_bull_color : settings.entry_zone_bear_color
                    int ez4_right = EntryZoneRight(setup.ez_c4_right_time)
                    if not setup.ez_c4_invalid
                        bin.boxes.push(box.new(setup.ez_c4_left_time, setup.ez_c4_top, ez4_right, setup.ez_c4_bot,
                            xloc = xloc.bar_time, bgcolor = ez4_col, border_color = color_transparent, border_width = 0))
                    if settings.show_c4_lbl
                        float ez4_lbl_y = setup.is_bullish ? setup.ez_c4_bot : setup.ez_c4_top
                        int ez4_lbl_x = setup.ez_c4_left_time + timeframe.in_seconds() * 1000
                        string ez4_txt = setup.ez_c4_invalid ? "xC4" : "C4"
                        color ez4_lbl_col = setup.ez_c4_invalid ? color.red : settings.c2_color
                        lbl_style_ez4 = setup.is_bullish ? label.style_label_up : label.style_label_down
                        bin.labels.push(label.new(ez4_lbl_x, ez4_lbl_y, ez4_txt, xloc = xloc.bar_time,
                            color = color_transparent, textcolor = ez4_lbl_col, style = lbl_style_ez4, size = settings.c2_size))
    
    // Draw live setups (both bullish and bearish)
    for is_bull in array.from(false, true)
        // Apply bias filter for live setups
        bool bias_ok = settings.bias == 'Neutral' or (settings.bias == 'Bullish' and is_bull) or (settings.bias == 'Bearish' and not is_bull)
        if not bias_ok
            continue
        bool has_live = is_bull ? candleSet.has_live_bullish : candleSet.has_live_bearish
        if not has_live
            continue
        setup = is_bull ? candleSet.live_bullish : candleSet.live_bearish
        if clUseCrtTiming and not CLCrtHourAllowed(ChartBarTime(setup.htf_candle_idx))
            continue
        if not ShouldDisplayC2(setup)
            continue
        // Unconfirmed wick sweeps may be shown as ?C2 for diagnosis, but
        // entries and finalized C2 still require a body return through C1.
        bool pending_c2 = not setup.is_confirmed and not setup.is_post_c2
        if settings.sweep_live
            if pending_c2 and not crtShowPendingSweeps
                continue
        else
            if not (setup.is_post_c2 and setup.cisd_triggered)
                continue

        DrawC1CrtRange(setup, candleSet)
        DrawTbsModel1(setup)
        DrawFvgModel2(setup)
            
        // ==== LAYER 3: C2 LABEL — live during C2; PSP suffix updates until C2 closes ====
        if settings.show_c2_lbl
            lbl_style = is_bull ? label.style_label_up : label.style_label_down
            string lbl_base = pending_c2 ? '?C2' : setup.is_invalid ? 'xC2' : 'C2'
            string lbl_text = lbl_base + (not pending_c2 and setup.c2_psp ? ' + PSP' : '')
            color lbl_color = pending_c2 ? color.orange : setup.is_invalid ? color.red : settings.c2_color
            bin.labels.push(label.new(ChartBarTime(setup.c2_x), setup.c2_y, lbl_text, xloc = xloc.bar_time, color = color_transparent, textcolor = lbl_color, style = lbl_style, size = settings.c2_size, tooltip = C2Tooltip(setup, candleSet)))
        DrawUsedHtfPoi(bin, candleSet, setup)
        
        // ==== LAYER 4: SWEEP LINES (near top) - SKIP if invalid ====
        if not setup.is_invalid and settings.sweep_show
            // A sweep ends at the exact LTF candle that first took C1, never
            // at the following C3 boundary.
            bin.lines.push(line.new(ChartBarTime(setup.sweep_ltf_idx), setup.sweep_price, ChartBarTime(setup.sweep_bar_idx), setup.sweep_price, xloc = xloc.bar_time, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
        
        // Draw HTF sweep line - only when projection is visible, SKIP if invalid
        if not setup.is_invalid and not settings.hide_candles
            int htf_x1 = na
            int htf_x2 = na
            for [j, candle] in candleSet.candles
                if candle.o_idx == setup.swept_candle_idx
                    htf_x1 := candle.wick_x
                if candle.o_idx == setup.htf_candle_idx
                    htf_x2 := candle.wick_x  // C2's sweep wick
            if not na(htf_x1) and not na(htf_x2)
                if settings.sweep_show
                    bin.lines.push(line.new(htf_x1, setup.sweep_price, htf_x2, setup.sweep_price, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
        
        // ==== LAYER 5: CISD LINE (on top) - ALWAYS DRAW even if invalid ====
        if not setup.is_superseded and settings.cisd_show and setup.cisd_triggered and setup.has_cisd
            cisd_color = is_bull ? settings.cisd_bull_color : settings.cisd_bear_color
            bin.lines.push(line.new(ChartBarTime(setup.cisd_start_idx), setup.cisd_level, ChartBarTime(setup.cisd_end_idx + 1), setup.cisd_level, xloc = xloc.bar_time, color = cisd_color, style = cisd_line_style, width = settings.cisd_width))
        
        // ==== LAYER 5b: IC-CISD (draw only after sweep-back-in / show, live) ====
        if not setup.is_superseded and settings.ic_cisd_show and setup.cisd_triggered and not na(setup.ic_list) and setup.ic_list.size() > 0
            for ic_j = 0 to setup.ic_list.size() - 1
                ICCisd ic_l = setup.ic_list.get(ic_j)
                // Invalidated (taken) IC-CISD can be hidden via "Show Invalidated IC-CISD"
                if ic_l.taken and not settings.ic_show_taken
                    continue
                // Hide this stage (C3/C4/C5) entirely if its toggle is off
                if not ICStageVisible(ic_l.stage)
                    continue
                color ic_col_l = ic_l.taken ? color.gray : (is_bull ? settings.ic_cisd_bull_color : settings.ic_cisd_bear_color)
                if not na(ic_l.level) and not na(ic_l.start_idx) and not na(ic_l.end_idx)
                    bin.lines.push(line.new(ChartBarTime(ic_l.start_idx), ic_l.level, ChartBarTime(ic_l.end_idx), ic_l.level, xloc = xloc.bar_time, color = ic_col_l, style = cisd_line_style, width = settings.cisd_width))
                if DirectionalProtectedSwing(setup, ic_l) and ProtectedSwingWindowActive(setup, candleSet.settings.htf)
                    ic_dot_style_l = is_bull ? label.style_label_up : label.style_label_down
                    bin.labels.push(label.new(ChartBarTime(ic_l.extreme_idx), ic_l.extreme_price, "●", xloc = xloc.bar_time, color = color_transparent, textcolor = ic_col_l, style = ic_dot_style_l, size = settings.ic_dot_size))
        
        // ==== LAYER 7: PREVIOUS EQ (chart) — after confirmed; C2 mid on C3, C3 mid on C4 ====
        if not setup.is_superseded and not setup.is_invalid and setup.is_confirmed and ShowChartEQ()
            eq_line_style_live = LineStyle(prev_eq_style)
            // C2 EQ across C3 window
            if not na(setup.c2_mid) and not na(setup.ez_c3_left_time)
                int eq3_right_live = EntryZoneRight(setup.ez_c3_right_time)
                if eq3_right_live > setup.ez_c3_left_time
                    bin.lines.push(line.new(setup.ez_c3_left_time, setup.c2_mid, eq3_right_live, setup.c2_mid,
                        xloc = xloc.bar_time, color = prev_eq_color, style = eq_line_style_live, width = prev_eq_width))
            // C3 EQ across C4 window — if C4 invalid: stop at that LTF bar, red
            if not na(setup.c3_mid) and not na(setup.ez_c4_left_time)
                int eq4_right_live = setup.ez_c4_invalid and not na(setup.ez_c4_invalid_time) ? setup.ez_c4_invalid_time : EntryZoneRight(setup.ez_c4_right_time)
                color eq4_col_live = setup.ez_c4_invalid ? color.red : prev_eq_color
                if eq4_right_live > setup.ez_c4_left_time
                    bin.lines.push(line.new(setup.ez_c4_left_time, setup.c3_mid, eq4_right_live, setup.c3_mid,
                        xloc = xloc.bar_time, color = eq4_col_live, style = eq_line_style_live, width = prev_eq_width))
        
        // ==== LAYER 7b: PREVIOUS EQ (HTF projection) — live ====
        if not setup.is_superseded and not setup.is_invalid and setup.is_confirmed and ShowHtfEQ() and not settings.hide_candles
            int c2_i_live = FindCandleIndex(candleSet.candles, setup.htf_candle_idx)
            eq_htf_style_live = LineStyle(prev_eq_style)
            if not na(setup.c2_mid) and c2_i_live > 0
                Candle c2_proj_l = candleSet.candles.get(c2_i_live)
                Candle c3_proj_l = candleSet.candles.get(c2_i_live - 1)
                int htf_eq3_x1_l = c2_proj_l.wick_x
                int htf_eq3_x2_l = c3_proj_l.candle_right + 2
                if htf_eq3_x2_l > htf_eq3_x1_l
                    bin.lines.push(line.new(htf_eq3_x1_l, setup.c2_mid, htf_eq3_x2_l, setup.c2_mid,
                        color = prev_eq_color, style = eq_htf_style_live, width = prev_eq_width))
            if not na(setup.c3_mid) and c2_i_live > 1
                Candle c3_proj4_l = candleSet.candles.get(c2_i_live - 1)
                Candle c4_proj_l = candleSet.candles.get(c2_i_live - 2)
                int htf_eq4_x1_l = c3_proj4_l.wick_x
                int htf_eq4_x2_l = c4_proj_l.candle_right + 2
                color htf_eq4_col_l = setup.ez_c4_invalid ? color.red : prev_eq_color
                if htf_eq4_x2_l > htf_eq4_x1_l
                    bin.lines.push(line.new(htf_eq4_x1_l, setup.c3_mid, htf_eq4_x2_l, setup.c3_mid,
                        color = htf_eq4_col_l, style = eq_htf_style_live, width = prev_eq_width))
        
        // ==== LAYER 8: ENTRY ZONE C3 - SKIP if invalid ====
        // Label: bearish = top-left of box (label_down), bullish = bottom-left (label_up) — same gap style as C2
        // Zone right edge develops with LTF bars (option A), then locks at C3 end
        if not setup.is_superseded and not setup.is_invalid and settings.entry_zone_show and setup.ez_c3_set and not na(setup.ez_c3_left_time)
            color ez_col_live = is_bull ? settings.entry_zone_bull_color : settings.entry_zone_bear_color
            int ez_right_live = EntryZoneRight(setup.ez_c3_right_time)
            bin.boxes.push(box.new(setup.ez_c3_left_time, setup.ez_c3_top, ez_right_live, setup.ez_c3_bot,
                xloc = xloc.bar_time, bgcolor = ez_col_live, border_color = color_transparent, border_width = 0))
            if settings.show_c3_lbl
                float ez_lbl_y_live = is_bull ? setup.ez_c3_bot : setup.ez_c3_top
                // One chart candle right of box left edge (same rule for C4 later)
                int ez_lbl_x_live = setup.ez_c3_left_time + timeframe.in_seconds() * 1000
                lbl_style_ez_live = is_bull ? label.style_label_up : label.style_label_down
                bin.labels.push(label.new(ez_lbl_x_live, ez_lbl_y_live, "C3", xloc = xloc.bar_time,
                    color = color_transparent, textcolor = settings.c2_color, style = lbl_style_ez_live, size = settings.c2_size))
        
    candleSet

method DrawAll(CandleSet candleSet, int offset) =>
    // Always calculate positions (needed for HTF sweep line drawing)
    candleSet.CalculatePositions(offset)
    
    // Always draw VT/HL lines (these are on the LTF chart, not the projection)
    candleSet.DrawVTHLLines()
    
    // HTF Fair Value Gaps (drawn before candles/setups so they sit behind them)
    candleSet.DrawFVGs()
    candleSet.DrawBlockZones()
    // Optional, clean target layer for still-active old highs/lows.
    candleSet.DrawActiveHtfLiquidityTargets()
    
    // When hiding projection, skip candles/labels/trace
    if not settings.hide_candles
        candleSet.DrawCandles()
        candleSet.DrawLabels(offset)
        candleSet.DrawTrace(offset)
    
    // Draw setups (sweeps, CISD, entry zones) - skip if hide_setups enabled
    if not settings.hide_setups
        candleSet.DrawSetups()
        // Fill only missing historical C2/sweep packages.
        candleSet.DrawSweeps()
    candleSet

// ============================================================================
// Main Execution
// ============================================================================

// Calculate on close setting - only affects live setup detection within HTF candle
// When a new HTF candle opens, Monitor() always runs to create the new candle
bool calculate_on_close = input.bool(true, 'Calculate on Close?', tooltip='When enabled, live setup detection only runs when LTF candles close (better performance). New HTF candle creation always runs immediately.', group = 'Performance')

// Check if this is a new HTF candle. The retired quarterly/session modes are
// intentionally excluded from this live path.
// Note: htf.settings.htf is a "series string" (it's read from a UDT field, produced by a switch over an
// input), so it can't be passed to timeframe.change(), which needs a "simple string". resolved_htf_simple
// is computed the same way but kept off any UDT field so it stays "simple", letting us use the native
// timeframe.change() built-in instead of a request.security()+ta.change() round trip. This avoids the
// resync glitches request.security() is prone to right after a Bar Replay rewind (which could otherwise
// spuriously fire mid-candle, cutting an in-progress HTF candle short and stamping its open time to
// whatever bar the glitch landed on instead of the true boundary).
resolved_htf_simple = getFractalHTFSimple(fractal_mode_input)
// `timeframe.change('60')` is not a reliable boundary signal when the chart
// itself is 60 minutes. Native mode must treat every new chart bar as one new
// HTF candle; otherwise the candle cache never advances and FVG/sweep history
// is built from stale candles.
bool native_htf_source = str.length(resolved_htf_simple) > 0 and timeframe.in_seconds() == timeframe.in_seconds(resolved_htf_simple)
bool isNewHTFCandle = native_htf_source ? barstate.isnew : (str.length(resolved_htf_simple) > 0 ? timeframe.change(resolved_htf_simple) : false)

// Determine if we should run Monitor:
// - Always run when new HTF candle opens (for HTF candle creation, vertical lines, etc.)
// - Otherwise, respect calculate_on_close setting
bool should_run_monitor = isNewHTFCandle or not calculate_on_close or barstate.isconfirmed

// Always clear the active Fractal drawing cache first.
bool valid_htf = ValidTimeframe(htf.settings.htf)
bin.clear()

// Resolve PSP companion assets once after all inputs and the active chart symbol are known.
if barstate.isfirst
    htf.InitializePSPAssets()

// Data collection
int offset = settings.offset
if valid_htf
    // Monitor - runs on new HTF candle, or per calculate_on_close setting (pass isNewHTFCandle)
    if should_run_monitor
        htf.Monitor(isNewHTFCandle)
    // HTF candle updates - always run every tick
    htf.Update()
    // Show the matching HTF POI as soon as a developing C2 wick reaches it;
    // confirmation still happens separately when C2 closes.
    htf.RefreshLiveHtfPoi()
    if isNewHTFCandle or barstate.isconfirmed
        htf.SyncC2PSP()

    // FVG mitigation: a gap is mitigated once price has fully traded through it
    if (settings.fvg_show or clC2FvgPoi or clC2IfvgPoi) and fvgs.size() > 0
        for f in fvgs
            // An IFVG is confirmed only at an HTF boundary, from the just
            // closed HTF body. A lower-timeframe intrabar wick/close cannot
            // make a future HTF POI appear early.
            if na(f.ifvg_time) and isNewHTFCandle and htf.candles.size() > 0
                Candle closed_htf = htf.candles.first()
                bool inverted = f.is_bullish ? closed_htf.c < f.bot : closed_htf.c > f.top
                if inverted
                    f.ifvg_time := closed_htf.c_time
            if na(f.mit_time)
                // Wick fill preserves the original behaviour. Full body
                // through keeps a bull FVG valid until an HTF body is wholly
                // below it, and a bear FVG valid until an HTF body is wholly
                // above it; wick probes and partial body entries remain valid.
                bool fvg_filled = false
                int fill_time = time
                if fvgMitigationMode == 'Full body through'
                    if isNewHTFCandle and htf.candles.size() > 1
                        Candle closed_htf = htf.candles.get(1)
                        float body_top = math.max(closed_htf.o, closed_htf.c)
                        float body_bot = math.min(closed_htf.o, closed_htf.c)
                        fvg_filled := f.is_bullish ? body_top < f.bot : body_bot > f.top
                        fill_time := closed_htf.c_time
                else
                    fvg_filled := f.is_bullish ? low <= f.bot : high >= f.top
                if fvg_filled
                    f.mit_time := fill_time

// UpdatePSP contains series calculations and must be invoked outside the
// valid-HTF branch so Pine evaluates it on every chart calculation.
htf.UpdatePSP(isNewHTFCandle)

// Drawing (only on last bar)
if barstate.islast or barstate.isrealtime
    if valid_htf
        htf.DrawAll(offset)

// DEBUG ONLY — plot the exact previous HTF C1 H/L used by the sweep engine.
// The markers persist across replay: circle = wick crossed C1; data-window
// status: -1 = no live sweep, 0 = wick only, 1 = close back inside.
float crtDebugHigh = valid_htf and not na(htf.ref_c1) ? htf.ref_c1.h : na
float crtDebugLow = valid_htf and not na(htf.ref_c1) ? htf.ref_c1.l : na
bool crtDebugNewBear = valid_htf and htf.has_live_bearish and htf.live_bearish.sweep_bar_idx == bar_index
bool crtDebugNewBull = valid_htf and htf.has_live_bullish and htf.live_bullish.sweep_bar_idx == bar_index
float crtDebugBullStatus = htf.has_live_bullish ? (htf.live_bullish.is_confirmed ? 1.0 : 0.0) : -1.0
float crtDebugBearStatus = htf.has_live_bearish ? (htf.live_bearish.is_confirmed ? 1.0 : 0.0) : -1.0
plot(crtDebugSweep ? crtDebugHigh : na, title = 'DEBUG C1 high (actual sweep reference)', color = color.new(color.red, 15), style = plot.style_linebr, linewidth = 1)
plot(crtDebugSweep ? crtDebugLow : na, title = 'DEBUG C1 low (actual sweep reference)', color = color.new(color.lime, 15), style = plot.style_linebr, linewidth = 1)
bool crtDebugRawLow = crtUseHourlyLtfReference and not na(crt1hPrevLow) and low < crt1hPrevLow
bool crtDebugRawHigh = crtUseHourlyLtfReference and not na(crt1hPrevHigh) and high > crt1hPrevHigh
plotshape(crtDebugSweep and crtDebugNewBull, title = 'DEBUG tracked low sweep', style = shape.circle, location = location.belowbar, color = color.orange, size = size.tiny)
plotshape(crtDebugSweep and crtDebugNewBear, title = 'DEBUG tracked high sweep', style = shape.circle, location = location.abovebar, color = color.orange, size = size.tiny)
plotshape(crtDebugSweep and crtDebugRawLow, title = 'DEBUG 1H feed low breached', style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.tiny)
plotshape(crtDebugSweep and crtDebugRawHigh, title = 'DEBUG 1H feed high breached', style = shape.triangledown, location = location.abovebar, color = color.red, size = size.tiny)
plot(crtDebugSweep and crtUseHourlyLtfReference ? crt1hPrevHigh : na, title = 'DEBUG actual previous 1H high', color = color.new(color.red, 35), style = plot.style_linebr)
plot(crtDebugSweep and crtUseHourlyLtfReference ? crt1hPrevLow : na, title = 'DEBUG actual previous 1H low', color = color.new(color.green, 35), style = plot.style_linebr)
plot(crtDebugSweep ? crtDebugBullStatus : na, title = 'DEBUG bullish sweep confirmed (1 yes, 0 no, -1 absent)', display = display.data_window)
plot(crtDebugSweep ? crtDebugBearStatus : na, title = 'DEBUG bearish sweep confirmed (1 yes, 0 no, -1 absent)', display = display.data_window)

// Compact CRT state display. This replaces the retired checklist panel with a
// small, chart-clean readout for the single setup that currently owns C2/C3/C4.
var table crtPhaseStrip = table.new(position.top_center, 3, 1, bgcolor = color.new(color.white, 100))
var table crtDashboard = table.new(crtDashPosition == 'Top Right' ? position.top_right : crtDashPosition == 'Bottom Right' ? position.bottom_right : crtDashPosition == 'Bottom Left' ? position.bottom_left : position.top_left, 2, 6, bgcolor = color.new(color.white, 100))

if barstate.islast
    table.clear(crtPhaseStrip, 0, 0, 2, 0)
    table.clear(crtDashboard, 0, 0, 1, 5)
    if crtDashShow
        Setup dash_setup = na
        bool has_dash_setup = false
        int dash_start = na

        if htf.has_live_bullish
            Setup live_bull = htf.live_bullish
            int live_bull_start = ChartBarTime(live_bull.htf_candle_idx)
            if ProtectedSwingWindowActive(live_bull, htf.settings.htf)
                dash_setup := live_bull
                has_dash_setup := true
                dash_start := live_bull_start
        if htf.has_live_bearish
            Setup live_bear = htf.live_bearish
            int live_bear_start = ChartBarTime(live_bear.htf_candle_idx)
            if ProtectedSwingWindowActive(live_bear, htf.settings.htf) and (not has_dash_setup or live_bear_start >= dash_start)
                dash_setup := live_bear
                has_dash_setup := true
                dash_start := live_bear_start
        if htf.setups.size() > 0
            for [dash_i, stored_setup] in htf.setups
                int stored_start = ChartBarTime(stored_setup.htf_candle_idx)
                if not stored_setup.is_invalid and not stored_setup.is_superseded and ProtectedSwingWindowActive(stored_setup, htf.settings.htf) and (not has_dash_setup or stored_start > dash_start)
                    dash_setup := stored_setup
                    has_dash_setup := true
                    dash_start := stored_start

        string dash_phase = has_dash_setup ? SetupPhase(dash_setup, htf.settings.htf) : 'Waiting'
        color dash_direction = has_dash_setup ? (dash_setup.is_bullish ? #5dbb78 : #dd7272) : color.silver
        bool native_htf_chart = timeframe.period == htf.settings.htf
        string dash_tf = native_htf_chart ? 'Native ' + DisplayResolution(htf.settings.htf) : DisplayResolution(timeframe.period) + ' → ' + DisplayResolution(htf.settings.htf)
        string dash_alignment = fractal_mode_input == 'Automatic' ? 'Auto ↻' : fractal_mode_input
        if crtDashPhaseStrip
            table.cell(crtPhaseStrip, 0, 0, dash_alignment, text_color = color.aqua, text_size = size.small)
            table.cell(crtPhaseStrip, 1, 0, dash_tf, text_color = color.silver, text_size = size.small)
            table.cell(crtPhaseStrip, 2, 0, (has_dash_setup ? (dash_setup.is_bullish ? '↑ ' : '↓ ') : '') + dash_phase + ' Phase', text_color = dash_direction, text_size = size.small)

        if has_dash_setup
            bool has_protected = SetupHasProtectedSwing(dash_setup)
            table.cell(crtDashboard, 0, 0, (dash_setup.is_bullish ? '↑ ' : '↓ ') + dash_tf, text_color = dash_direction, text_size = size.small)
            table.cell(crtDashboard, 1, 0, dash_phase + '!', text_color = dash_direction, text_size = size.small)
            table.cell(crtDashboard, 0, 1, 'HTF POI', text_color = color.silver, text_size = size.small)
            table.cell(crtDashboard, 1, 1, dash_setup.htf_poi_kind == 'Pending' ? 'Waiting' : dash_setup.htf_poi_kind, text_color = dash_direction, text_size = size.small)
            table.cell(crtDashboard, 0, 2, 'C2 Close', text_color = color.silver, text_size = size.small)
            table.cell(crtDashboard, 1, 2, dash_setup.is_post_c2 ? '✓' : '…', text_color = dash_setup.is_post_c2 ? dash_direction : color.silver, text_size = size.small)
            table.cell(crtDashboard, 0, 3, 'CISD', text_color = color.silver, text_size = size.small)
            table.cell(crtDashboard, 1, 3, dash_setup.cisd_triggered ? '✓' : '…', text_color = dash_setup.cisd_triggered ? dash_direction : color.silver, text_size = size.small)
            table.cell(crtDashboard, 0, 4, 'PSP', text_color = color.silver, text_size = size.small)
            table.cell(crtDashboard, 1, 4, dash_setup.c2_psp ? '✓' : '—', text_color = dash_setup.c2_psp ? dash_direction : color.silver, text_size = size.small)
            table.cell(crtDashboard, 0, 5, 'Protected Swing', text_color = color.silver, text_size = size.small)
            table.cell(crtDashboard, 1, 5, has_protected ? '✓' : '—', text_color = has_protected ? dash_direction : color.silver, text_size = size.small)
        else
            table.cell(crtDashboard, 0, 0, dash_tf, text_color = color.silver, text_size = size.small)
            table.cell(crtDashboard, 1, 0, 'Waiting', text_color = color.silver, text_size = size.small)

// Multi-timeframe candle/SMT engine. Completed, timestamp-matched 5m samples.
type MFCandle
    int t = na
    int finish = na
    float o = na
    float h = na
    float l = na
    float c = na
    int ht = na
    int lt = na
    float ph = na
    float pl = na
    bool aligned = true
    bool complete = false

type MFState
    array<MFCandle> bars
    MFCandle current
    int lastSample = na

mf_engine() =>
    MFState state = MFState.new()
    state.bars := array.new<MFCandle>()
    state

mf_div(MFCandle previous, MFCandle current) =>
    bool valid = not na(previous) and not na(current) and previous.complete and current.complete and previous.aligned and current.aligned
    bool upper = valid and ((current.h > previous.h) != (current.ph > previous.ph))
    bool lower = valid and ((current.l < previous.l) != (current.pl < previous.pl))
    [upper, lower]

method mf_sample(MFState state, int t, int finish, int bucket, int bucketEnd, float o, float h, float l, float c, float ph, float pl) =>
    if not na(bucket) and (na(state.lastSample) or t > state.lastSample)
        state.lastSample := t
        if not na(state.current) and state.current.t != bucket
            array.push(state.bars, state.current)
            while array.size(state.bars) > mfHistory + 1
                array.shift(state.bars)
            state.current := na
        if na(state.current)
            MFCandle candle = MFCandle.new()
            candle.t := bucket
            candle.finish := bucketEnd
            candle.o := o
            candle.h := h
            candle.l := l
            candle.c := c
            candle.ht := t
            candle.lt := t
            candle.ph := ph
            candle.pl := pl
            candle.aligned := not na(ph) and not na(pl)
            candle.complete := t == bucket
            state.current := candle
        else
            MFCandle candle = state.current
            if h > candle.h
                candle.h := h
                candle.ht := t
            if l < candle.l
                candle.l := l
                candle.lt := t
            candle.c := c
            candle.aligned := candle.aligned and not na(ph) and not na(pl)
            if not na(ph)
                candle.ph := na(candle.ph) ? ph : math.max(candle.ph, ph)
                candle.pl := na(candle.pl) ? pl : math.min(candle.pl, pl)
    true

mf_payload(bool previous) =>
    int day = time('1D', '1800-1700:1234567', 'America/New_York')
    int endDay = time_close('1D', '1800-1700:1234567', 'America/New_York')
    if previous
        [time[1], time_close[1], open[1], high[1], low[1], close[1], time('60')[1], time_close('60')[1], time('240')[1], time_close('240')[1], day[1], endDay[1]]
    else
        [time, time_close, open, high, low, close, time('60'), time_close('60'), time('240'), time_close('240'), day, endDay]

var MFState mfHour = mf_engine()
var MFState mfFour = mf_engine()
var MFState mfDay = mf_engine()
var array<int> mfChartOpen = array.new<int>()
var array<int> mfChartEnd = array.new<int>()
if array.size(mfChartOpen) == 0 or array.last(mfChartOpen) != time
    array.push(mfChartOpen, time)
    array.push(mfChartEnd, time_close)
    if array.size(mfChartOpen) > 50000
        array.shift(mfChartOpen)
        array.shift(mfChartEnd)

mf_anchor(int stamp) =>
    int result = stamp
    int left = 0
    int right = array.size(mfChartOpen) - 1
    int found = -1
    while left <= right
        int middle = int(math.floor((left + right) * 0.5))
        if array.get(mfChartOpen, middle) <= stamp
            found := middle
            left := middle + 1
        else
            right := middle - 1
    if found >= 0 and stamp < array.get(mfChartEnd, found)
        result := array.get(mfChartOpen, found)
    result

mf_smtLine(MFCandle previous, MFCandle current, bool upper, string caption, int x1 = na, int x2 = na) =>
    float y1 = upper ? previous.h : previous.l
    float y2 = upper ? current.h : current.l
    color ink = upper ? mfBear : mfBull
    bool projected = not na(x1) and not na(x2)
    int first = projected ? x1 : mf_anchor(upper ? previous.ht : previous.lt)
    int last = projected ? x2 : mf_anchor(upper ? current.ht : current.lt)
    bin.lines.push(line.new(first, y1, last, y2, xloc = projected ? xloc.bar_index : xloc.bar_time, color = ink, width = 1))
    bin.labels.push(label.new(int(math.floor((first + last) * 0.5)), (y1 + y2) * 0.5, caption, xloc = projected ? xloc.bar_index : xloc.bar_time, color = color_transparent, textcolor = ink, style = label.style_none, size = size.tiny))

mf_draw(MFState state, string caption, bool smtOn, bool paneOn, int offset) =>
    array<MFCandle> visible = array.new<MFCandle>()
    if array.size(state.bars) > 0
        for i = math.max(0, array.size(state.bars) - mfCandles) to array.size(state.bars) - 1
            array.push(visible, array.get(state.bars, i))
    if not na(state.current)
        array.push(visible, state.current)
    if mfChartSmt and smtOn and array.size(state.bars) > 1
        for i = 1 to array.size(state.bars) - 1
            MFCandle p = array.get(state.bars, i - 1)
            MFCandle c = array.get(state.bars, i)
            [upper, lower] = mf_div(p, c)
            if upper
                mf_smtLine(p, c, true, caption + ' SMT H')
            if lower
                mf_smtLine(p, c, false, caption + ' SMT L')
    if smtOn and not na(state.current) and array.size(state.bars) > 0 and mfChartSmt
        MFCandle p = array.last(state.bars)
        [upper, lower] = mf_div(p, state.current)
        if upper
            mf_smtLine(p, state.current, true, caption + ' SMT H · developing')
        if lower
            mf_smtLine(p, state.current, false, caption + ' SMT L · developing')
    if paneOn and array.size(visible) > 0
        for i = 0 to array.size(visible) - 1
            MFCandle candle = array.get(visible, i)
            int left = bar_index + offset + i * 5
            int center = left + 1
            color body = candle.c >= candle.o ? #808080 : #505050
            bin.boxes.push(box.new(left, math.max(candle.o, candle.c), left + 2, math.min(candle.o, candle.c), border_color = body, bgcolor = body))
            bin.lines.push(line.new(center, candle.h, center, candle.l, color = #808080))
            if i == array.size(visible) - 1
                bin.labels.push(label.new(center, candle.h, caption, color = color_transparent, textcolor = mfBull, style = label.style_label_down, size = size.small, tooltip = caption == 'D' ? 'Daily 18:00–17:00 America/New_York · completed 5m samples' : 'Broker ' + caption + ' candles · completed 5m samples'))
            if i > 0 and smtOn
                MFCandle p = array.get(visible, i - 1)
                [upper, lower] = mf_div(p, candle)
                if upper
                    mf_smtLine(p, candle, true, caption + ' SMT', center - 5, center)
                if lower
                    mf_smtLine(p, candle, false, caption + ' SMT', center - 5, center)
    true

bool mfNeeded = mf1 or mf4 or mfD or mfPane1 or mfPane4 or mfPaneD
float mfSeconds = timeframe.in_seconds()
if mfNeeded and not na(mfSeconds) and mfSeconds <= 86400
    array<int> mt = array.new<int>()
    array<int> mc = array.new<int>()
    array<float> mo = array.new<float>()
    array<float> mh = array.new<float>()
    array<float> ml = array.new<float>()
    array<float> mx = array.new<float>()
    array<int> m1 = array.new<int>()
    array<int> m1e = array.new<int>()
    array<int> m4 = array.new<int>()
    array<int> m4e = array.new<int>()
    array<int> md = array.new<int>()
    array<int> mde = array.new<int>()
    array<int> pt = array.new<int>()
    array<float> ph = array.new<float>()
    array<float> pl = array.new<float>()
    if mfSeconds >= 300
        [a,b,c,d,e,f,g,h,i,j,k,l] = request.security_lower_tf(syminfo.tickerid, '5', mf_payload(false), calc_bars_count = 40000)
        mt := a
        mc := b
        mo := c
        mh := d
        ml := e
        mx := f
        m1 := g
        m1e := h
        m4 := i
        m4e := j
        md := k
        mde := l
        [aPeer,bPeer,cPeer] = request.security_lower_tf(mfPeer, '5', [time,high,low], ignore_invalid_symbol = true, calc_bars_count = 40000)
        pt := aPeer
        ph := bPeer
        pl := cPeer
    else
        [a,b,c,d,e,f,g,h,i,j,k,l] = request.security(syminfo.tickerid, '5', mf_payload(true), lookahead = barmerge.lookahead_on, calc_bars_count = 40000)
        if not na(a)
            array.push(mt,a)
            array.push(mc,b)
            array.push(mo,c)
            array.push(mh,d)
            array.push(ml,e)
            array.push(mx,f)
            array.push(m1,g)
            array.push(m1e,h)
            array.push(m4,i)
            array.push(m4e,j)
            array.push(md,k)
            array.push(mde,l)
        [aPeer,bPeer,cPeer] = request.security(mfPeer, '5', [time[1],high[1],low[1]], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true, calc_bars_count = 40000)
        if not na(aPeer)
            array.push(pt,aPeer)
            array.push(ph,bPeer)
            array.push(pl,cPeer)
    int peerIndex = 0
    if array.size(mt) > 0
        for i = 0 to array.size(mt) - 1
            int sample = array.get(mt,i)
            int finish = array.get(mc,i)
            while peerIndex < array.size(pt)
                if array.get(pt,peerIndex) < sample
                    peerIndex += 1
                else
                    break
            float peerH = na
            float peerL = na
            if peerIndex < array.size(pt) and array.get(pt,peerIndex) == sample
                peerH := array.get(ph,peerIndex)
                peerL := array.get(pl,peerIndex)
            if finish <= timenow
                if mf1 or mfPane1
                    mfHour.mf_sample(sample,finish,array.get(m1,i),array.get(m1e,i),array.get(mo,i),array.get(mh,i),array.get(ml,i),array.get(mx,i),peerH,peerL)
                if mf4 or mfPane4
                    mfFour.mf_sample(sample,finish,array.get(m4,i),array.get(m4e,i),array.get(mo,i),array.get(mh,i),array.get(ml,i),array.get(mx,i),peerH,peerL)
                if mfD or mfPaneD
                    mfDay.mf_sample(sample,finish,array.get(md,i),array.get(mde,i),array.get(mo,i),array.get(mh,i),array.get(ml,i),array.get(mx,i),peerH,peerL)

if barstate.islast or barstate.isrealtime
    int mfOffset = settings.offset + (settings.hide_candles ? 0 : htf.settings.max_display * (settings.width + 1) + 10)
    bool addHour = mfPane1 and (settings.hide_candles or htf.settings.htf != '60')
    bool addFour = mfPane4 and (settings.hide_candles or htf.settings.htf != '240')
    mf_draw(mfHour,'1H',mf1,addHour,mfOffset)
    mfOffset += addHour ? (mfCandles + 1) * 5 + 10 : 0
    mf_draw(mfFour,'4H',mf4,addFour,mfOffset)
    mfOffset += addFour ? (mfCandles + 1) * 5 + 10 : 0
    mf_draw(mfDay,'D',mfD,mfPaneD,mfOffset)
    // Also place SMT on the original active 1H/4H projected candles.
    // Custom NY Daily has its separate panel, since CFD broker D may differ.
    MFState active = htf.settings.htf == '60' ? mfHour : htf.settings.htf == '240' ? mfFour : na
    bool activeSmt = htf.settings.htf == '60' ? mf1 : htf.settings.htf == '240' ? mf4 : false
    if not settings.hide_candles and activeSmt and not na(active) and htf.candles.size() > 1
        array<MFCandle> records = array.new<MFCandle>()
        for candle in active.bars
            records.push(candle)
        if not na(active.current)
            records.push(active.current)
        for i = 0 to htf.candles.size() - 2
            Candle c = htf.candles.get(i)
            Candle p = htf.candles.get(i + 1)
            MFCandle sourceC = na
            MFCandle sourceP = na
            for candle in records
                if candle.t == c.o_time
                    sourceC := candle
                if candle.t == p.o_time
                    sourceP := candle
            [upper, lower] = mf_div(sourceP, sourceC)
            if upper
                mf_smtLine(sourceP,sourceC,true,'SMT',p.wick_x,c.wick_x)
            if lower
                mf_smtLine(sourceP,sourceC,false,'SMT',p.wick_x,c.wick_x)
